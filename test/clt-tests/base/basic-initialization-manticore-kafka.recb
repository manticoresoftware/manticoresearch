––– comment –––
Create bridge network for container communication
––– input –––
docker network create app-network --driver bridge > /dev/null; echo $?
––– output –––
0
––– comment –––
Start Manticore Search container with test-kit image
––– input –––
docker run -it --network=app-network --platform linux/amd64 --name manticore -d ghcr.io/manticoresoftware/manticoresearch:test-kit-latest bash > /dev/null 2>&1; echo $?
––– output –––
0
––– comment –––
Start Manticore Search daemon with verbose debug logging
––– input –––
docker exec manticore stdbuf -oL searchd --logdebugvv > /dev/null 2>&1; echo $?
––– output –––
0
––– comment –––
Wait for Buddy's HTTP endpoint, not just searchd's listener or startup log.
––– input –––
docker exec manticore bash -lc 'for n in $(seq 1 150); do buddy_url=$(grep -F "[BUDDY] started " /var/log/manticore/searchd.log 2>/dev/null | tail -1 | awk "{print \$NF}"); if [ -n "$buddy_url" ] && curl -fsS --max-time 1 "$buddy_url/config" >/dev/null 2>&1; then echo "Buddy HTTP ready"; exit 0; fi; sleep 0.2; done; echo "Buddy HTTP unavailable" >&2; exit 1'
––– output –––
Buddy HTTP ready
––– comment –––
Check the first Queue query explicitly; a PHP 8.5 parser regression must still fail this test.
––– input –––
docker exec manticore mysql -h0 -P9306 -e 'SHOW SOURCES' >/dev/null; echo $?
