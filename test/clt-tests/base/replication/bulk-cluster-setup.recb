––– comment –––
Three nodes in cluster v1 with an empty RT table t. BULK_PAUSE_<n> (ms, default 0) is the pause of node n between the delivery of a bulk_import chunk and its attach command (INDEXER_RT_BULK_CLUSTER_PAUSE_MS). The helpers in /tmp/bc.sh write rows with the cluster prefix.
––– input –––
cat > /tmp/bc.sh <<'EOF'
m() { mysql --skip-table --batch --raw --skip-column-names -h0 -P${1}306 -e "$2" 2>&1; }
v() { m $1 "SHOW STATUS LIKE 'cluster_v1_$2'" | awk '{print $2}'; }
rows() { local i=$2 e=$(( $2 + $3 - 1 )) k j s; while [ $i -le $e ]; do k=$(( i + 499 )); [ $k -gt $e ] && k=$e; s="INSERT INTO v1:$1 (id,title,v) VALUES "; for j in $(seq $i $k); do s="$s($j,'title $j',$j),"; done; echo "${s%,};"; i=$(( k + 1 )); done; }
load() { { echo "SET bulk_import=$2;"; echo "BEGIN;"; rows $2 $3 $4; echo "COMMIT;"; echo "SET bulk_import=0;"; } | mysql -h0 -P${1}306 2>&1; }
seqno() { grep -o '"files_seqno":[0-9-]*' /var/log/manticore-$1/manticore.json | cut -d: -f2; }
repl() { find /var/log/manticore-$1 -maxdepth 3 -name 'repl-*' | wc -l; }
st() { for n in 1 2 3; do echo "node $n: $(v $n node_state) count=$(m $n "SELECT COUNT(*) FROM $1" | tail -1) sum=$(m $n "SELECT SUM(v) FROM $1" | tail -1) last_committed=$(v $n last_committed) files_seqno=$(seqno $n) repl=$(repl $n)"; done; }
pauses() { grep -c 'pause [0-9]* ms before the attach command' /var/log/manticore-$1/searchd.log; }
waitpause() { for k in $(seq 120); do [ "$(pauses $1)" -ge $2 ] && return 0; sleep 0.5; done; return 1; }
waitsynced() { for k in $(seq 240); do [ "$(v $1 node_state)" = synced ] && [ "$(v $1 last_committed)" = "$(v $2 last_committed)" ] && return 0; sleep 0.5; done; return 1; }
EOF
echo ok
––– output –––
ok
––– input –––
for i in 1 2 3; do export INSTANCE=$i; mkdir -p /var/{run,lib,log}/manticore-$i; p=BULK_PAUSE_$i; INDEXER_RT_BULK_CLUSTER_PAUSE_MS=${!p:-0} stdbuf -oL searchd --logreplication -c test/clt-tests/base/searchd-with-flexible-ports.conf > /dev/null; done; for i in 1 2 3; do timeout 30 grep -qm1 '\[BUDDY\] started' <(tail -n 1000 -f /var/log/manticore-$i/searchd.log) && echo "node $i started"; done
––– output –––
node 1 started
node 2 started
node 3 started
––– input –––
mysql -h0 -P1306 -e "CREATE CLUSTER v1"; for n in 2 3; do mysql -h0 -P${n}306 -e "JOIN CLUSTER v1 AT '127.0.0.1:1312'"; done; mysql -h0 -P1306 -e "CREATE TABLE t (title text, v int)"; mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t"; echo $?
––– output –––
0
––– input –––
source /tmp/bc.sh; for n in 1 2 3; do echo "node $n $(v $n node_state) $(v $n indexes) $(seqno $n)"; done
––– output –––
node 1 synced t 1
node 2 synced t 1
node 3 synced t 1
