––– comment –––
Regression for bounded MySQL handshake fields (username, database, plugin)
and malformed length-encoded handshake fields. No untrusted reply bytes are printed.
––– block: ../base/start-searchd-with-auth –––
––– input –––
python3 - <<'PY'
import socket
import struct

HOST, PORT = '127.0.0.1', 9306
PROTOCOL_41 = 0x00000200
SSL = 0x00000800
CONNECT_WITH_DB = 0x00000008
PLUGIN_AUTH = 0x00080000
CONNECT_ATTRS = 0x00100000
LENENC_AUTH = 0x00200000


def fixed_header(flags=PROTOCOL_41):
    return struct.pack('<IIB', flags, 1024 * 1024, 33) + bytes(23)


def packet(sock):
    header = b''
    while len(header) < 4:
        part = sock.recv(4 - len(header))
        if not part:
            raise RuntimeError('missing MySQL packet header')
        header += part
    size = int.from_bytes(header[:3], 'little')
    result = b''
    while len(result) < size:
        part = sock.recv(size - len(result))
        if not part:
            raise RuntimeError('incomplete MySQL packet')
        result += part
    return result


def check(name, payload):
    with socket.create_connection((HOST, PORT), timeout=5) as sock:
        sock.settimeout(5)
        packet(sock)  # discard greeting
        header = struct.pack('<I', len(payload))[:3] + b'\x01'
        sock.sendall(header + payload)
        response = packet(sock)
    if len(response) < 9 or response[0] != 0xff:
        raise AssertionError(name + ': expected ERR packet')
    error = struct.unpack('<H', response[1:3])[0]
    message = response[9:]
    if error != 1047 or message != b'malformed MySQL handshake response':
        raise AssertionError(name + ': unexpected ERR code or text')
    print(name + ': rejected')


cases = [
    ('short-fixed-header', fixed_header()[:-1]),
    ('no-protocol41', fixed_header(0) + b'admin\x00\x00'),
    ('unterminated-username', fixed_header() + b'admin-not-terminated'),
    ('unterminated-ssl-username', fixed_header(PROTOCOL_41 | SSL) + b'admin-not-terminated'),
    ('unterminated-database', fixed_header(PROTOCOL_41 | CONNECT_WITH_DB) + b'admin\x00\x00' + b'bad_db'),
    ('unterminated-plugin', fixed_header(PROTOCOL_41 | PLUGIN_AUTH) + b'admin\x00\x00' + b'bad_plugin'),
    ('short-auth-data', fixed_header() + b'admin\x00\x14abc'),
    ('oversized-lenenc-auth', fixed_header(PROTOCOL_41 | LENENC_AUTH) + b'admin\x00\xfc\xff\xff'),
    ('oversized-attributes', fixed_header(PROTOCOL_41 | CONNECT_ATTRS) + b'admin\x00\x00\x05abc'),
    ('bad-attribute-value', fixed_header(PROTOCOL_41 | CONNECT_ATTRS) + b'admin\x00\x00\x03\x01a\x05'),
    ('huge-attribute-value', fixed_header(PROTOCOL_41 | CONNECT_ATTRS) + b'admin\x00\x00\x0b\x01x\xfe' + struct.pack('<Q', 1 << 32)),
]
for name, payload in cases:
    check(name, payload)
PY
––– output –––
short-fixed-header: rejected
no-protocol41: rejected
unterminated-username: rejected
unterminated-ssl-username: rejected
unterminated-database: rejected
unterminated-plugin: rejected
short-auth-data: rejected
oversized-lenenc-auth: rejected
oversized-attributes: rejected
bad-attribute-value: rejected
huge-attribute-value: rejected
––– comment –––
Ordinary authenticated MySQL clients must still connect and execute a query.
––– input –––
MYSQL_PWD=adminpass mysql -h0 -P9306 -uadmin -e 'SELECT 1' >/dev/null && echo authenticated
––– output –––
authenticated
