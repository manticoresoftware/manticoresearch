Verify all models are created (check count, order may vary)
––– input –––
mysql -h0 -P9306 -e "SHOW CHAT MODELS;" | grep -c "openai"
––– output –––
3
––– comment –––
Test with single content field
––– input –––
chat_mysql "CALL CHAT('Tell me about vector search', 'knowledge_base', 'fast_assistant')\G;" | awk '/^[[:space:]]*response: ?/ { if (in_field) print r; r=$0; in_field=1; next } in_field && /^[[:space:]]+sources: / { print r; print; in_field=0; next } in_field { r=r " " $0; next } { print } END { if (in_field) print r }' | tee /tmp/output_1.txt
––– output –––
*************************** 1. row ***************************
#!/.*conversation_uuid: [a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}/!#
#!/.*user_query: Tell me about vector search/!#
#!/.*search_query: .*[Vv]ector.*[Ss]earch.*/!#
#!/.*response: .*[Vv]ector.*[Ss]earch.*/!#
#!/.*sources: .*/!#
––– input –––
grep 'sources:' /tmp/output_1.txt | grep -o '\[.*\]' | head -1 | { read -r s; if echo "$s" | jq -e 'map(.id) | contains([2,3,4])' >/dev/null 2>&1; then echo "OK"; else echo "FAIL"; echo "Found: $(echo "$s" | jq -c 'map(.id)')"; echo "$s"; fi; }
––– output –––
OK
––– comment –––
