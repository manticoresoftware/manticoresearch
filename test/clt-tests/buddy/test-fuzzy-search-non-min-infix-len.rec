––– block: ../base/start-searchd –––
––– input –––
manticore --global -e "create table test (id bigint, value text);"
––– output –––
––– input –––
manticore --global -e "CALL AUTOCOMPLETE('jo', 'test', 'us,ru' AS layouts);"
––– output –––
ERROR 500: Autocomplete requires min_infix_len to be set
––– input –––
manticore --global -e "SELECT * FROM test WHERE MATCH('RICH') OPTION fuzzy=1;"
––– output –––
ERROR 500: Fuzzy search requires min_infix_len to be set
––– input –––
manticore --global -e "ALTER TABLE test min_infix_len='2';"
––– output –––
––– input –––
sleep 30; manticore --global -e "CALL AUTOCOMPLETE('jo', 'test', 'us,ru' AS layouts);"
––– output –––
query
––– input –––
manticore --global -e "SELECT * FROM test WHERE MATCH('RICH') OPTION fuzzy=1;"
