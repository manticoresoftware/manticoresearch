mysql -h0 -P9306 -N -B -e "SELECT COUNT(*) FROM \`con\`" | tr -cd '0-9\n' | grep '^1$'
––– output –––
1
––– input –––
mysql -h0 -P9306 -e "DROP TABLE \`con\`"; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -N -B -e "SHOW TABLES LIKE 'con'" | grep -c '^con'; true
––– output –––
0
––– input –––
python3 -c 'import json; print(int("con" not in json.load(open("/var/lib/manticore/manticore.json"))["indexes"]))'
––– output –––
1
––– input –––
find /var/lib/manticore/con -mindepth 1 -maxdepth 1 ! -name 'con.lock' 2>/dev/null | wc -l | tr -d ' '
