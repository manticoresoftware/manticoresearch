––– comment –––
Candidate follow-up for #4780. It targets KNN source-pool reads in FinishMergeAttributes/ParallelStoreKNN. Eight manticore-load UPDATE connections grow only non-KNN blob attributes while a second manticore-load process performs six synchronous KNN merges. The table has eight rowwise KNN disk chunks and knn_parallel_build=8. The test expects searchd to remain alive.
––– input –––
searchd --stopwait >/dev/null 2>&1 || true; rm -rf /tmp/gh4780-knn; mkdir -p /tmp/gh4780-knn/data /tmp/gh4780-knn/binlog; printf '%s\n' 'searchd' '{' '  listen = 127.0.0.1:9306:mysql41' '  log = /var/log/manticore/searchd.log' '  query_log = /tmp/gh4780-knn/query.log' '  pid_file = /tmp/gh4780-knn/searchd.pid' '  binlog_path = /tmp/gh4780-knn/binlog' '  secondary_indexes = 1' '  network_timeout = 10' '  seamless_rotate = 0' '  preopen_tables = 0' '  unlink_old = 1' '}' '' 'index articles' '{' '  type = rt' '  path = /tmp/gh4780-knn/data/articles' '  rt_field = title' '  stored_fields =' '  rt_attr_uint = tenant_id' '  rt_attr_multi = tags' '  rt_attr_string = category' '  rt_attr_json = payload' '  rt_attr_float_vector = vec' '  attr_update_reserve = 0' '  knn = {"attrs":[{"name":"vec","type":"hnsw","dims":128,"hnsw_similarity":"L2","hnsw_m":16,"hnsw_ef_construction":200}]}' '}' > /tmp/gh4780-knn/manticore.conf; rm -f /var/log/manticore/searchd.log; stdbuf -oL searchd --config /tmp/gh4780-knn/manticore.conf > /tmp/gh4780-knn/start.log 2>&1; for i in $(seq 1 100); do mysql -h0 -P9306 -e 'SELECT 1' >/dev/null 2>&1 && { echo ready; break; }; sleep 0.1; done
––– output –––
ready
––– input –––
ok=1; mysql -h0 -P9306 -e 'SET GLOBAL auto_optimize=0; SET GLOBAL knn_parallel_build=8' >/dev/null || ok=0; for chunk in $(seq 0 7); do first=$((chunk * 4096 + 1)); manticore-load --quiet --host=127.0.0.1 --port=9306 --threads=1 --batch-size=25 --total=4096 --cache-from-disk --load="INSERT INTO articles(id,title,tenant_id,tags,category,payload,vec) VALUES(<increment/$first>,'article',<int/1/30>,(<array/2/2/1/100>),'seed-<string/256/256>','{\"stage\":\"initial\"}',(<array_float/128/128/0/1>))" >/tmp/gh4780-knn/load-$chunk.log 2>&1 || { cat /tmp/gh4780-knn/load-$chunk.log; ok=0; }; mysql -h0 -P9306 -e 'FLUSH RAMCHUNK articles' >/dev/null || ok=0; done; chunks=$(mysql -h0 -P9306 -e "SHOW TABLE articles STATUS LIKE 'disk_chunks';" | grep disk_chunks | grep -Eo '[0-9]+' | tail -n1); if [ "$ok" = 1 ] && [ "$chunks" = 8 ]; then echo chunks_ready; else echo "setup_failed ok=$ok chunks=$chunks"; fi
––– output –––
chunks_ready
––– input –––
rc=0; manticore-load --quiet --host=127.0.0.1 --port=9306 --threads=8 --total=128 --cache-from-disk --load="UPDATE articles SET tags=(<array/3/3/1/200>), category='u-<string/1048576/1048576>', payload='{\"stage\":\"updated\"}' WHERE id=<int/1/32768>" --together --threads=1 --total=6 --load='OPTIMIZE TABLE articles OPTION sync=1, cutoff=1' >/tmp/gh4780-knn/workload.log 2>&1 || rc=$?; if grep -q 'FATAL: CRASH DUMP' /var/log/manticore/searchd.log; then echo crashed; elif [ "$rc" -ne 0 ]; then echo "workload_failed rc=$rc"; elif mysql -h0 -P9306 -N -e 'SELECT COUNT(*) FROM articles' >/dev/null 2>&1; then echo not_crashed; else echo workload_failed; fi
––– output –––
not_crashed
