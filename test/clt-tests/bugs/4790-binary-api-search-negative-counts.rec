python3 - <<'PY'
import socket
import struct


HOST = "127.0.0.1"
PORT = 9312
SEARCHD_ERROR = 1


def i32(value):
    return struct.pack("!i", value)


def u32(value):
    return struct.pack("!I", value)


def packet(body):
    return struct.pack("!HHI", 0, 0x127, len(body)) + body


def receive_exact(sock, size):
    result = b""
    while len(result) < size:
        chunk = sock.recv(size - len(result))
        if not chunk:
            raise RuntimeError("unexpected EOF")
        result += chunk
    return result


with socket.create_connection((HOST, PORT), timeout=3) as sock:
    sock.sendall(u32(1))
    receive_exact(sock, 4)
    sock.sendall(packet(i32(0) + i32(-1)))
    status, _version, length = struct.unpack("!HHI", receive_exact(sock, 8))
    receive_exact(sock, length)

if status != SEARCHD_ERROR:
    raise RuntimeError("expected API error status, got %d" % status)

print("max-batch-zero-negative-query-count: error")
