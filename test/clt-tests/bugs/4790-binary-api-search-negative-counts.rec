––– comment –––
max_batch_queries=0 must disable only the upper cap, not positive count validation.
––– comment –––
––– input –––
cat > /tmp/gh4790-max-batch-zero.conf <<'EOF'
searchd {
    listen = 127.0.0.1:9312
    listen = 127.0.0.1:9306:mysql
    listen = 127.0.0.1:9308:http
    log = /var/log/manticore/searchd.log
    query_log = /var/log/manticore/query.log
    pid_file = /run/manticore/searchd.pid
    data_dir = /var/lib/manticore
    max_batch_queries = 0
}
EOF
rm -f /var/log/manticore/searchd.log
stdbuf -oL searchd --stopwait > /dev/null
stdbuf -oL searchd -c /tmp/gh4790-max-batch-zero.conf > /dev/null
if timeout 10 grep -qm1 'accepting connections' <(tail -n 1000 -f /var/log/manticore/searchd.log); then echo 'Accepting connections!'; else echo 'Timeout or failed!'; fi
