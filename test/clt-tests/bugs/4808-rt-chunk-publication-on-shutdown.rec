––– comment –––
Regression for #4808: SIGTERM during an active RT disk save must not interrupt the immediate JSON header readback used to validate and publish the completed chunk. The unfixed daemon misreports the valid .sph as an old/invalid header and logs that it failed to load the disk chunk after RAM save.
––– input –––
cat > /tmp/gh4808-repro.sh <<'BASH'
#!/usr/bin/env bash
set -u

searchd --stopwait >/dev/null 2>&1 || true
rm -rf /tmp/gh4808
mkdir -p /tmp/gh4808/data
cat > /tmp/gh4808/manticore.conf <<'CONF'
searchd {
  # Use dedicated ports so a daemon left by another test cannot answer probes.
  listen = 127.0.0.1:19486:mysql
  listen = 127.0.0.1:19488:http
  log = /tmp/gh4808/searchd.log
  query_log = /tmp/gh4808/query.log
  pid_file = /tmp/gh4808/searchd.pid
  data_dir = /tmp/gh4808/data
  binlog_path = /tmp/gh4808/data
  watchdog = 0
  rt_flush_period = 3600
  # Keep SaveDiskData active long enough to deliver SIGTERM after it starts.
  rt_merge_iops = 1000
  rt_merge_maxiosize = 4K
}
common {
  progressive_merge = 1
}
CONF

# RTSAVEDIAG provides a deterministic start marker without fault injection.
MANTICORE_LOG_RTSAVEDIAG=1 stdbuf -oL searchd --config /tmp/gh4808/manticore.conf --logdebug > /tmp/gh4808/start.log 2>&1
ready=no
for i in $(seq 1 200); do
  if mysql --ssl-mode=DISABLED -h127.0.0.1 -P19486 -e 'SELECT 1' >/dev/null 2>&1; then
    ready=yes
    break
  fi
  sleep 0.05
done
if [ "$ready" != yes ]; then
  echo startup_ready=no
  searchd --stopwait --config /tmp/gh4808/manticore.conf >/dev/null 2>&1 || true
  exit 2
fi
mysql --ssl-mode=DISABLED -h127.0.0.1 -P19486 -e "CREATE TABLE gh4808(title text, tag string, n int) rt_mem_limit='1M';" >/dev/null

manticore-load --quiet --host=127.0.0.1 --port=19486 --batch-size=20 --threads=4 --total=5000 \
  --load="INSERT INTO gh4808(id,title,tag,n) VALUES(<increment>,'<text/500/500>','tag<int/1/20>',<int/1/100>)" \
  > /tmp/gh4808/load.log 2>&1 &
loader=$!

active=
for i in $(seq 1 2000); do
  active=$(grep 'SaveDiskData to ' /tmp/gh4808/searchd.log 2>/dev/null | grep -o '/tmp/gh4808/data/gh4808/gh4808\.[0-9]\+' | tail -1)
  [ -n "$active" ] && break
  sleep 0.01
done

if [ -n "$active" ]; then
  echo active_save=yes
else
  echo active_save=no
  searchd --stopwait --config /tmp/gh4808/manticore.conf >/dev/null 2>&1 || true
  exit 2
fi

kill -TERM "$(cat /tmp/gh4808/searchd.pid)"
wait "$loader" 2>/dev/null || true
# PID removal happens before the final shutdown stages, so wait for their log marker.
for i in $(seq 1 600); do
  grep -q 'shutdown complete' /tmp/gh4808/searchd.log && break
  sleep 0.05
done

if grep -q 'is invalid header file (too old table version?)' /tmp/gh4808/searchd.log; then echo header_warning=yes; else echo header_warning=no; fi
if grep -q 'failed to load disk chunk after RAM save' /tmp/gh4808/searchd.log; then echo publish_warning=yes; else echo publish_warning=no; fi
if grep -q 'shutdown complete' /tmp/gh4808/searchd.log; then echo shutdown_complete=yes; else echo shutdown_complete=no; fi

sph="$active.sph"
if [ -s "$sph" ] && head -c 1 "$sph" | grep -q '{' && grep -q '"index_format_version"' "$sph"; then echo header_json=yes; else echo header_json=no; fi
chunk=${active##*.}
meta=/tmp/gh4808/data/gh4808/gh4808.meta
if CHUNK="$chunk" perl -0777 -ne '$id=$ENV{"CHUNK"}; if (/"chunk_names"\s*:\s*\[[^\]]*\b\Q$id\E\b[^\]]*\]/s) { exit 0 } exit 1' "$meta"; then echo chunk_referenced=yes; else echo chunk_referenced=no; fi
BASH
––– output –––
––– input –––
bash /tmp/gh4808-repro.sh
––– output –––
active_save=yes
header_warning=no
publish_warning=no
shutdown_complete=yes
header_json=yes
chunk_referenced=yes
