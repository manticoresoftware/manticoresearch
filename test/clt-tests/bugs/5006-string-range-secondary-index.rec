cs > 'm': 3,3
cs >= 'm': 5,5
cs < '': 0,0
cs <= '': 1,1
cs > '': 7,7
cs >= '': 8,8
––– comment –––
A columnar-scan hint must also preserve string ordering when the analyzer cannot handle ranges.
––– input –––
for op in '<' '<=' '>' '>='; do
  printf 'cs %s ColumnarScan: ' "$op"
  sql "SELECT id FROM gh5006 WHERE cs $op 'm' ORDER BY id ASC /*+ ColumnarScan(cs) */;" | paste -sd, -
done
––– output –––
cs < ColumnarScan: 1,2,3
cs <= ColumnarScan: 1,2,3,4,5
cs > ColumnarScan: 6,7,8
cs >= ColumnarScan: 4,5,6,7,8
––– comment –––
JSON range filters use the same comparison flags, including inverted comparisons for inclusive bounds.
Check both hits and totals and cover a two-sided range as well.
––– input –––
for attr in rs cs; do
  for bounds in '{"lt":"m"}' '{"lte":"m"}' '{"gt":"m"}' '{"gte":"m"}' '{"gt":"a","lt":"n"}' '{"gte":"a","lte":"n"}'; do
    printf '%s %s: ' "$attr" "$bounds"
    curl -sS -X POST http://localhost:9308/search -H 'Content-Type: application/json' -d "{\"table\":\"gh5006\",\"query\":{\"range\":{\"$attr\":$bounds}},\"sort\":[{\"id\":\"asc\"}],\"limit\":20}" | php -r '$r=json_decode(stream_get_contents(STDIN),true); echo json_encode(["ids"=>array_column($r["hits"]["hits"],"_id"),"total"=>$r["hits"]["total"]]),PHP_EOL;'
  done
done
––– output –––
rs {"lt":"m"}: {"ids":[1,2,3],"total":3}
rs {"lte":"m"}: {"ids":[1,2,3,4,5],"total":5}
rs {"gt":"m"}: {"ids":[6,7,8],"total":3}
rs {"gte":"m"}: {"ids":[4,5,6,7,8],"total":5}
rs {"gt":"a","lt":"n"}: {"ids":[3,4,5],"total":3}
rs {"gte":"a","lte":"n"}: {"ids":[2,3,4,5,6],"total":5}
cs {"lt":"m"}: {"ids":[1,2,3],"total":3}
cs {"lte":"m"}: {"ids":[1,2,3,4,5],"total":5}
cs {"gt":"m"}: {"ids":[6,7,8],"total":3}
cs {"gte":"m"}: {"ids":[4,5,6,7,8],"total":5}
cs {"gt":"a","lt":"n"}: {"ids":[3,4,5],"total":3}
cs {"gte":"a","lte":"n"}: {"ids":[2,3,4,5,6],"total":5}
––– comment –––
Equality and IN must still use secondary indexes. SHOW META verifies the actual row iterator,
so this control cannot pass merely because COUNT(*) used its precalculation shortcut.
––– input –––
for attr in rs cs; do
  printf '%s equality and IN:\n' "$attr"
  sql "SELECT id FROM gh5006 WHERE $attr='m' ORDER BY id ASC /*+ SecondaryIndex($attr) */; SHOW META LIKE 'index'; SELECT id FROM gh5006 WHERE $attr IN ('m','z') ORDER BY id ASC /*+ SecondaryIndex($attr) */; SHOW META LIKE 'index';" | tr '\t' ' '
done
