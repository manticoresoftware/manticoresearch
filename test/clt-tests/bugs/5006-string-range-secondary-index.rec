––– comment –––
String ranges must compare strings, not their equality hashes, after flushing to disk.
The duplicate boundary makes equality/inequality counts differ from the range counts.
Force iterator selection for this tiny fixture, which would normally bypass the optimizer.
––– input –––
export SEARCHD_ARGS="--force-pseudo-sharding"
sql() { mysql -h0 -P9306 --skip-table --batch --raw --skip-column-names -e "$1"; }
––– output –––
––– block: ../base/start-searchd –––
––– input –––
sql "SET GLOBAL secondary_indexes=1; DROP TABLE IF EXISTS gh5006; CREATE TABLE gh5006 (rs STRING, cs STRING engine='columnar') engine='rowwise'; INSERT INTO gh5006 VALUES (1,'',''),(2,'a','a'),(3,'b','b'),(4,'m','m'),(5,'m','m'),(6,'n','n'),(7,'o','o'),(8,'z','z'); FLUSH RAMCHUNK gh5006;" && echo ready
––– output –––
ready
––– comment –––
Check ordinary row retrieval and both secondary-index hints for rowwise and columnar attributes.
A forced hint must fall back when ordered string comparison is unsupported by the index.
––– input –––
for attr in rs cs; do
  for op in '<' '<=' '>' '>='; do
    for hint in '' "/*+ SecondaryIndex($attr) */" "/*+ NO_SecondaryIndex($attr) */"; do
      printf '%s %s %s: ' "$attr" "$op" "${hint:-default}"
      sql "SELECT id FROM gh5006 WHERE $attr $op 'm' ORDER BY id ASC $hint;" | paste -sd, -
    done
  done
done
