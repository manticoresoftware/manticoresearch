––– comment –––
Issue #5055: a filter tree (OR, NOT) with a leaf on a WEIGHT() alias ran before ranking, when the alias was not
computed yet: s>=1 returned nothing and s<1 returned rows. All three docs match 'hat', so s=2 for each of them.
Row-wise and columnar tables, RAM chunk and disk chunk.
––– input –––
sql() { mysql -h0 -P9306 --skip-table --batch --raw --skip-column-names -e "$1"; }; q() { echo "$1: $2 = [$(sql "SELECT id, IF(WEIGHT()>0,2,0) AS s FROM $1 WHERE MATCH('hat') AND $2 ORDER BY id ASC" | cut -f1 | paste -sd' ' -)]"; }
––– output –––
––– block: ../base/start-searchd –––
––– input –––
for t in t tc; do sql "CREATE TABLE $t (name text, status string, kind string)$([ $t = tc ] && echo " engine='columnar'"); INSERT INTO $t (id, name, status, kind) VALUES (1,'red hat','delisted','equity'),(2,'hat trick','delisted','prediction'),(3,'blue hat','active','equity')"; done; echo ready
––– output –––
ready
––– input –––
checks() { for t in t tc; do q $t "(status!='active' OR kind='futures') AND s>=1"; q $t "(status!='active' OR kind='futures') AND s<1"; q $t "NOT (status='active' AND kind!='futures') AND s>=1"; q $t "(s>=1 OR kind='futures')"; q $t "(s<1 OR status='active')"; done; }; checks
