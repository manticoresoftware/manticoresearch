––– comment –––
JOIN. A LEFT JOIN with a right-table filter evaluates all filters after the join, where the weight filter was dropped
(a flat s>=3 returned every row); the tree must keep working there. An INNER JOIN with left-table filters only
leaves the tree on the left table.
––– input –––
sql "CREATE TABLE t2 (x int); INSERT INTO t2 (id, x) VALUES (1,1),(2,2),(3,3)"; j() { echo "$1 = [$(sql "SELECT t.id, IF(WEIGHT()>0,2,0) AS s FROM t $1 ORDER BY t.id ASC" | cut -f1 | paste -sd' ' -)]"; }; echo ready
––– output –––
ready
––– input –––
j "LEFT JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND t2.x>0 AND s>=3"; j "LEFT JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND (t2.x>1 OR t.status='x') AND s>=1"; j "LEFT JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND (t2.x>1 OR t.status='x') AND s>=3"; j "INNER JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND (t.status!='active' OR t.kind='futures') AND s>=1"
––– output –––
LEFT JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND t2.x>0 AND s>=3 = []
LEFT JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND (t2.x>1 OR t.status='x') AND s>=1 = [2 3]
LEFT JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND (t2.x>1 OR t.status='x') AND s>=3 = []
INNER JOIN t2 ON t2.id=t.id WHERE MATCH('hat') AND (t.status!='active' OR t.kind='futures') AND s>=1 = [1 2]
