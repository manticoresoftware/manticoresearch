––– comment –––
Regression for #5062: direct SQL streaming emits the default table schema even when SELECT lists
only rowwise attributes. An unselected columnar string must not be read from the missing .spb pool.
Explicitly selected stored fields must not be parsed again when preparing the default schema.
––– input –––
searchd --stopwait >/dev/null 2>&1 || true
root=/tmp/gh5062-streaming-plain
rm -rf "$root"
mkdir -p "$root/data" "$root/binlog"
printf '1,Cat,en,10\n2,Shivers,ru,20\n' > "$root/rows.csv"
cat > "$root/manticore.conf" <<'CONF'
source gh5062_src
{
    type = csvpipe
    csvpipe_command = cat /tmp/gh5062-streaming-plain/rows.csv
    csvpipe_field = title
    csvpipe_attr_string = language
    csvpipe_attr_uint = value
}

index gh5062_plain
{
    type = plain
    source = gh5062_src
    path = /tmp/gh5062-streaming-plain/data/gh5062_plain
    columnar_attrs = language
}

searchd
{
    listen = 127.0.0.1:9306:mysql
    log = /tmp/gh5062-streaming-plain/searchd.log
    pid_file = /tmp/gh5062-streaming-plain/searchd.pid
    binlog_path = /tmp/gh5062-streaming-plain/binlog
    watchdog = 0
}
CONF
indexer --quiet --config "$root/manticore.conf" gh5062_plain >/dev/null && test -f "$root/data/gh5062_plain.spc" && test ! -e "$root/data/gh5062_plain.spb" && searchd --config "$root/manticore.conf" >/dev/null 2>&1 && echo ready
––– output –––
ready
––– input –––
cat > /tmp/gh5062-streaming-plain/check.sh <<'CHECK'
#!/bin/sh
result=$(mysql -h0 -P9306 --skip-table --batch --raw -e "$1") || exit 1
printf '%s\n' "$result" | awk -F '\t' '
{ rows[NR]=$0 }
NR==1 { first = NF==4 && $1=="1" && $2=="Cat" && $3=="10" && $4=="en" }
NR==2 { second = NF==4 && $1=="2" && $2=="Shivers" && $3=="20" && $4=="ru" }
END {
    if (NR==2 && first && second) print "OK"
    else { print "FAIL"; for (i=1; i<=NR; i++) print "raw row " i ": " rows[i] > "/dev/stderr" }
}'
CHECK
sh /tmp/gh5062-streaming-plain/check.sh "SELECT id, value FROM gh5062_plain LIMIT -1"
sh /tmp/gh5062-streaming-plain/check.sh "SELECT /*!40001 SQL_NO_CACHE */ id, value FROM gh5062_plain"
sh /tmp/gh5062-streaming-plain/check.sh "SELECT id, title, value FROM gh5062_plain LIMIT -1"
sh /tmp/gh5062-streaming-plain/check.sh "SELECT /*!40001 SQL_NO_CACHE */ id, title, language, value FROM gh5062_plain"
sh /tmp/gh5062-streaming-plain/check.sh "SELECT * FROM gh5062_plain LIMIT -1"
––– output –––
OK
OK
OK
OK
OK
––– input –––
searchd --config /tmp/gh5062-streaming-plain/manticore.conf --stopwait >/dev/null 2>&1
rm -rf /tmp/gh5062-streaming-plain
––– output –––
