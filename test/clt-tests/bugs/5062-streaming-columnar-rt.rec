sh /tmp/gh5062-rt-check.sh "SELECT id, value FROM gh5062_rt LIMIT -1"
sh /tmp/gh5062-rt-check.sh "SELECT /*!40001 SQL_NO_CACHE */ id, value FROM gh5062_rt"
sh /tmp/gh5062-rt-check.sh "SELECT id, title, value FROM gh5062_rt LIMIT -1"
sh /tmp/gh5062-rt-check.sh "SELECT /*!40001 SQL_NO_CACHE */ id, title, lang, tags, tags64, n, value FROM gh5062_rt"
sh /tmp/gh5062-rt-check.sh "SELECT * FROM gh5062_rt LIMIT -1"
––– output –––
OK
OK
OK
OK
OK
––– input –––
mysql -h0 -P9306 -e "DROP TABLE gh5062_rt;"
rm -f /tmp/gh5062-rt-check.sh
