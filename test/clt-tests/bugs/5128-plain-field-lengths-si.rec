––– comment –––
The secondary index of a plain table holds the real field lengths: COUNT(*) and COUNT(DISTINCT) read them from there.
12000 documents, 4000 each with 0, 1 and 2 words.
––– input –––
root=/tmp/plain-field-lengths-si; rm -rf "$root"; mkdir -p "$root"; printf '%s\n' 'source s {' '  type = csvpipe' "  csvpipe_command = cat $root/rows.csv" '  csvpipe_field = title' '}' 'index p {' '  type = plain' '  source = s' "  path = $root/p" '  index_field_lengths = 1' '}' 'searchd {' '  listen = 19317:mysql41' "  log = $root/searchd.log" "  pid_file = $root/searchd.pid" '  binlog_path =' '}' > "$root/manticore.conf"; seq 1 12000 | awk '{ print $1 "," ($1%3==0 ? "" : ($1%3==1 ? "one" : "one two")) }' > "$root/rows.csv"; indexer --config "$root/manticore.conf" p > /dev/null; MANTICORE_NO_BUDDY=1 searchd --config "$root/manticore.conf" > /dev/null; for i in $(seq 1 100); do mysql -h0 -P19317 -e 'SELECT 1' > /dev/null 2>&1 && break; sleep 0.1; done; echo READY
––– output –––
READY
––– input –––
for q in 'title_len=0' 'title_len=1' 'title_len=2' 'title_len>=1'; do echo "$q: $(mysql --skip-table --batch --raw --skip-column-names -h0 -P19317 -e "SELECT COUNT(*) FROM p WHERE $q; SHOW META LIKE 'index'" | xargs)"; done
––– output –––
title_len=0: 4000 index title_len:Precalc (100%)
title_len=1: 4000 index title_len:Precalc (100%)
title_len=2: 4000 index title_len:Precalc (100%)
title_len>=1: 8000 index title_len:Precalc (100%)
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P19317 -e "SELECT COUNT(DISTINCT title_len) FROM p"
––– output –––
3
––– input –––
searchd --config /tmp/plain-field-lengths-si/manticore.conf --stopwait > /dev/null 2>&1; echo STOPPED
––– output –––
STOPPED
