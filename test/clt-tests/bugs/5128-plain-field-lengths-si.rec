––– comment –––
The secondary index of a plain table holds the real field lengths: COUNT(*) and COUNT(DISTINCT) read them from there.
12000 documents, 4000 each with 0, 1 and 2 words.
––– input –––
root=/tmp/plain-field-lengths-si; rm -rf "$root"; mkdir -p "$root"; printf '%s\n' 'source s {' '  type = csvpipe' "  csvpipe_command = cat $root/rows.csv" '  csvpipe_field = title' '}' 'index p {' '  type = plain' '  source = s' "  path = $root/p" '  index_field_lengths = 1' '}' 'searchd {' '  listen = 19317:mysql41' "  log = $root/searchd.log" "  pid_file = $root/searchd.pid" '  binlog_path =' '}' > "$root/manticore.conf"; seq 1 12000 | awk '{ print $1 "," ($1%3==0 ? "" : ($1%3==1 ? "one" : "one two")) }' > "$root/rows.csv"; indexer --config "$root/manticore.conf" p > /dev/null; MANTICORE_NO_BUDDY=1 searchd --config "$root/manticore.conf" > /dev/null; for i in $(seq 1 100); do mysql -h0 -P19317 -e 'SELECT 1' > /dev/null 2>&1 && break; sleep 0.1; done; echo READY
––– output –––
READY
––– input –––
for q in 'title_len=0' 'title_len=1' 'title_len=2' 'title_len>=1'; do echo "$q: $(mysql --skip-table --batch --raw --skip-column-names -h0 -P19317 -e "SELECT COUNT(*) FROM p WHERE $q; SHOW META LIKE 'index'" | xargs)"; done
––– output –––
title_len=0: 4000 index title_len:Precalc (100%)
title_len=1: 4000 index title_len:Precalc (100%)
title_len=2: 4000 index title_len:Precalc (100%)
title_len>=1: 8000 index title_len:Precalc (100%)
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P19317 -e "SELECT COUNT(DISTINCT title_len) FROM p"
––– output –––
3
––– input –––
searchd --config /tmp/plain-field-lengths-si/manticore.conf --stopwait > /dev/null 2>&1; echo STOPPED
––– output –––
STOPPED
––– comment –––
A SQL source keeps field lengths in the row with any storage options of the table (searchd serves as the MySQL source).
ATTACH refuses a plain table whose field lengths are stored differently from those of a non-empty RT table.
––– input –––
root=/tmp/plain-field-lengths-storage; rm -rf "$root"; mkdir -p "$root"; printf '1,one,1\n2,one two,2\n' > "$root/rows.csv"; cat > "$root/manticore.conf" <<EOF
source s_sql {
  type = mysql
  sql_host = 127.0.0.1
  sql_port = 19318
  sql_user = test
  sql_pass =
  sql_db = Manticore
  sql_query = SELECT id, title, a FROM src
  sql_attr_uint = a
}
source s_csv {
  type = csvpipe
  csvpipe_command = cat $root/rows.csv
  csvpipe_field = title
  csvpipe_attr_uint = a
}
index p_engine {
  type = plain
  source = s_sql
  path = $root/p_engine
  index_field_lengths = 1
  engine = columnar
}
index p_all {
  type = plain
  source = s_sql
  path = $root/p_all
  index_field_lengths = 1
  columnar_attrs = *
}
index p_len {
  type = plain
  source = s_sql
  path = $root/p_len
  index_field_lengths = 1
  columnar_attrs = title_len
}
index p_attach {
  type = plain
  source = s_csv
  path = $root/p_attach
  index_field_lengths = 1
  engine = columnar
}
index src {
  type = rt
  path = $root/src
  rt_field = title
  rt_attr_uint = a
  stored_fields = title
}
index rt_filled {
  type = rt
  path = $root/rt_filled
  rt_field = title
  rt_attr_uint = a
  index_field_lengths = 1
  engine = columnar
}
searchd {
  listen = 19318:mysql41
  log = $root/searchd.log
  pid_file = $root/searchd.pid
  binlog_path =
}
EOF
MANTICORE_NO_BUDDY=1 searchd --config "$root/manticore.conf" > /dev/null; for i in $(seq 1 100); do mysql -h0 -P19318 -e 'SELECT 1' > /dev/null 2>&1 && break; sleep 0.1; done; mysql -h0 -P19318 -e "INSERT INTO src (id,title,a) VALUES (101,'one',1),(102,'one two',2),(103,'',3); INSERT INTO rt_filled (id,title,a) VALUES (10,'three more words',10); FLUSH RAMCHUNK rt_filled"; indexer --config "$root/manticore.conf" p_attach > /dev/null 2>&1; indexer --config "$root/manticore.conf" p_engine p_all p_len > "$root/indexer.log" 2>&1; echo "indexer: $?"; searchd --config "$root/manticore.conf" --stopwait > /dev/null 2>&1; MANTICORE_NO_BUDDY=1 searchd --config "$root/manticore.conf" > /dev/null; for i in $(seq 1 100); do mysql -h0 -P19318 -e 'SELECT 1' > /dev/null 2>&1 && break; sleep 0.1; done; echo READY
––– output –––
indexer: 0
READY
––– input –––
for t in p_engine p_all p_len; do echo "$t: $(mysql --skip-table --batch --raw --skip-column-names -h0 -P19318 -e "SELECT id, title_len FROM $t ORDER BY id ASC" | xargs)"; done
––– output –––
p_engine: 101 1 102 2 103 0
p_all: 101 1 102 2 103 0
p_len: 101 1 102 2 103 0
––– input –––
mysql -h0 -P19318 -e "ATTACH TABLE p_attach TO TABLE rt_filled" 2>&1; mysql --skip-table --batch --raw --skip-column-names -h0 -P19318 -e "SELECT id, title_len FROM rt_filled"
––– output –––
ERROR 1064 (42000) at line 1: ATTACH currently requires same attributes declaration (RT-side support not implemented yet)
10	3
––– input –––
searchd --config /tmp/plain-field-lengths-storage/manticore.conf --stopwait > /dev/null 2>&1; echo STOPPED
––– output –––
STOPPED
