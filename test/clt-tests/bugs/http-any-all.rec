––– comment –––
HTTP filters accept any(col) / all(col) as the field name.
- range used to keep the whole "any(tags)" as an expression and fail with a syntax error; now range on
  any(mva) / all(mva) works like SQL ANY(tags) / ALL(tags), and on any(json.key) like the plain JSON range.
- With numbers on a JSON key, all() used to check the whole array as 0 (only scalars could match), and any() used
  another filter than the plain JSON filter, which skipped numeric strings and some doubles. Now any() works like
  the plain filter and all() like ALL() on MVA: a non-empty array where every element matches; a scalar counts as
  a one-element array.
- any() over an expression that already converts the JSON value (any(IN(j.i,2))) matched nothing; now it works
  like the expression itself.
Table http_aa: tags and j.i hold the same values, docs 1 (1,2), 2 (2), 3 (3), 4 (), 5 (1,2,3), 6 (2,2).
Table http_je: j.i is 7: 2, 8: "2", 9: 2.5, 10: [2,2.5], 11: [2.0,"2"].
––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS http_aa; DROP TABLE IF EXISTS http_je; CREATE TABLE http_aa (tags multi, j JSON); CREATE TABLE http_je (j JSON); INSERT INTO http_aa VALUES (1,(1,2),'{\"i\":[1,2]}'), (2,(2),'{\"i\":[2]}'), (3,(3),'{\"i\":[3]}'), (4,(),'{\"i\":[]}'), (5,(1,2,3),'{\"i\":[1,2,3]}'), (6,(2,2),'{\"i\":[2,2]}'); INSERT INTO http_je VALUES (7,'{\"i\":2}'), (8,'{\"i\":\"2\"}'), (9,'{\"i\":2.5}'), (10,'{\"i\":[2,2.5]}'), (11,'{\"i\":[2.0,\"2\"]}');" && echo ready
––– output –––
ready
––– input –––
cat > /tmp/http_aa.php <<'PHP'
<?php
function post ( $sUrl, $sBody, $sType ) {
	$tCtx = stream_context_create ( [ 'http' => [ 'method' => 'POST', 'header' => "Content-Type: $sType", 'content' => $sBody, 'ignore_errors' => true ] ] );
	return json_decode ( file_get_contents ( $sUrl, false, $tCtx ), true );
}
function sql ( $sQuery ) {
	$dRes = post ( 'http://localhost:9308/sql?mode=raw', http_build_query ( [ 'query' => $sQuery ] ), 'application/x-www-form-urlencoded' );
	return array_map ( 'intval', array_column ( $dRes[0]['data'], 'id' ) );
}
function ids ( $sTable, $sOccur, $tCond ) {
	$dRes = post ( 'http://localhost:9308/search', json_encode ( [ 'table' => $sTable, 'query' => [ 'bool' => [ $sOccur => [ $tCond ] ] ], 'limit' => 20, 'sort' => [ [ 'id' => 'asc' ] ] ] ), 'application/json' );
	return isset ( $dRes['hits'] ) ? array_map ( 'intval', array_column ( $dRes['hits']['hits'], '_id' ) ) : $dRes;
}
// range on any() / all() vs the same SQL condition
foreach ( [ [ 'any(tags)', [ 'gt' => 1 ], "ANY(tags) > 1" ], [ 'all(tags)', [ 'gt' => 1 ], "ALL(tags) > 1" ], [ 'any(tags)', [ 'gte' => 2, 'lte' => 2 ], "ANY(tags) BETWEEN 2 AND 2" ],
	[ 'all(tags)', [ 'lt' => 3 ], "ALL(tags) < 3" ], [ 'any(j.i)', [ 'gt' => 2 ], "j.i > 2" ] ] as [ $sField, $tRange, $sSql ] ) {
	$dIds = ids ( 'http_aa', 'must', [ 'range' => [ $sField => $tRange ] ] );
	echo json_encode ( [ 'range' => [ $sField => $tRange ], 'ids' => $dIds, 'sql' => $sSql, 'same' => $dIds===sql ( "SELECT id FROM http_aa WHERE $sSql ORDER BY id ASC" ) ] ), PHP_EOL;
}
// any() / all() on a JSON key vs the same filter on MVA
foreach ( [ [ 'equals', 2 ], [ 'in', [ 1, 2 ] ], [ 'range', [ 'gt' => 1 ] ], [ 'range', [ 'lt' => 3 ] ] ] as [ $sKind, $tVal ] )
	foreach ( [ 'must', 'must_not' ] as $sOccur ) {
		$tRes = [ $sKind => $tVal, 'occur' => $sOccur ];
		foreach ( [ 'any', 'all' ] as $sFunc ) {
			$tRes[$sFunc] = ids ( 'http_aa', $sOccur, [ $sKind => [ "$sFunc(j.i)" => $tVal ] ] );
			$tRes["{$sFunc}_same_as_mva"] = $tRes[$sFunc]===ids ( 'http_aa', $sOccur, [ $sKind => [ "$sFunc(tags)" => $tVal ] ] );
		}
		echo json_encode ( $tRes ), PHP_EOL;
	}
// scalars, numeric strings and doubles: any() vs the plain filter, and all()
foreach ( [ [ 'equals', 2 ], [ 'range', [ 'lt' => 2.5 ] ] ] as [ $sKind, $tVal ] ) {
	$tRes = [ $sKind => $tVal, 'plain' => ids ( 'http_je', 'must', [ $sKind => [ 'j.i' => $tVal ] ] ) ];
	foreach ( [ 'any', 'all' ] as $sFunc )
		$tRes[$sFunc] = ids ( 'http_je', 'must', [ $sKind => [ "$sFunc(j.i)" => $tVal ] ] );
	echo json_encode ( $tRes ), PHP_EOL;
}
// any() over an expression vs the expression itself
foreach ( [ [ 'equals', 1 ], [ 'range', [ 'gte' => 1 ] ] ] as [ $sKind, $tVal ] ) {
	$dExpr = ids ( 'http_aa', 'must', [ $sKind => [ 'IN(j.i,2)' => $tVal ] ] );
	echo json_encode ( [ $sKind => $tVal, 'expr' => $dExpr, 'any_same' => $dExpr===ids ( 'http_aa', 'must', [ $sKind => [ 'any(IN(j.i,2))' => $tVal ] ] ) ] ), PHP_EOL;
}
PHP
php /tmp/http_aa.php
