{"key":"j.s","no filter, json SI":[3],"no filter, no SI":[3],"where":[3],"group by u":[2,1,0],"alias":[3]}
{"key":"j.a","no filter, json SI":[3],"no filter, no SI":[3],"where":[3],"group by u":[2,1,0],"alias":[3]}
