––– comment –––
Mixed int/double JSON arrays must produce a terms bucket per numeric value.
Ordinary JSON objects passed to /bulk are reserialized: e.g. 1.0 becomes 1,
so an otherwise numeric array is stored as JSON_MIXED_VECTOR. Verify the
native and stringified JSON-attribute paths in RAM and disk chunks.
––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS json_mixed_numeric_facets; CREATE TABLE json_mixed_numeric_facets (j JSON);"
––– output –––
––– input –––
printf '%s\n' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":1,"doc":{"j":{"a":[1,5,10]}}}}' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":2,"doc":{"j":{"a":[0.946,2.5]}}}}' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":3,"doc":{"j":{"a":[0.946,1,5]}}}}' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":4,"doc":{"j":{"a":[0.946,1.0,5.0]}}}}' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":5,"doc":{"j":"{\"a\":[0.946,1.0,5.0]}"}}}' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":6,"doc":{"j":{"a":[0.946,1,2147483648]}}}}' \
  '{"insert":{"table":"json_mixed_numeric_facets","id":7,"doc":{"j":{"a":[0.946,1,"five"]}}}}' \
  | curl -sS -X POST http://localhost:9308/bulk -H 'Content-Type: application/x-ndjson' --data-binary @- \
  | php -r '$r=json_decode(stream_get_contents(STDIN),true); if (($r["errors"]??true)!==false) {fwrite(STDERR,"bulk failed: ".json_encode($r)."\n");exit(1);} echo "BULK_OK\n";'
––– output –––
BULK_OK
––– comment –––
Check both single-aggregation (limit=0) and normal facet grouping with two
documents. Mixed arrays must share group keys with homogeneous numeric arrays.
Also retain the existing whole-array grouping for non-numeric mixed arrays.
––– input –––
set -e
check() {
  phase=$1
  for id in 1 2 3 4 5 6; do
    curl -sS -X POST http://localhost:9308/search -H 'Content-Type: application/json' \
      -d "{\"table\":\"json_mixed_numeric_facets\",\"query\":{\"equals\":{\"id\":$id}},\"limit\":0,\"aggs\":{\"vol\":{\"terms\":{\"field\":\"j.a\",\"size\":10}}}}" \
      | php -r '
        $id=(int)$argv[1]; $phase=$argv[2];
        $expected=[
          1=>[1.0,5.0,10.0],
          2=>[0.946,2.5],
          3=>[0.946,1.0,5.0],
          4=>[0.946,1.0,5.0],
          5=>[0.946,1.0,5.0],
          6=>[0.946,1.0,2147483648.0]
        ];
        $r=json_decode(stream_get_contents(STDIN),true);
        $b=$r["aggregations"]["vol"]["buckets"]??[];
        $keys=array_column($b,"key");
        $ok=count($keys)===count($expected[$id]);
        foreach ($keys as $key) $ok=$ok && is_numeric($key);
        if ($ok) {
          $keys=array_map("floatval",$keys);
          sort($keys,SORT_NUMERIC);
          $ok=$keys===$expected[$id];
        }
        foreach ($b as $bucket) $ok=$ok && ($bucket["doc_count"]??null)===1;
        if (!$ok) {fwrite(STDERR,"$phase $id: ".json_encode($r)."\n");exit(1);}
        echo "$phase $id OK\n";
      ' "$id" "$phase"
  done
  curl -sS -X POST http://localhost:9308/search -H 'Content-Type: application/json' \
    -d '{"table":"json_mixed_numeric_facets","query":{"in":{"id":[1,3]}},"limit":1,"aggs":{"vol":{"terms":{"field":"j.a","size":10}}}}' \
    | php -r '
      $phase=$argv[1]; $r=json_decode(stream_get_contents(STDIN),true);
      $b=$r["aggregations"]["vol"]["buckets"]??[];
      $counts=[];
      foreach ($b as $bucket) {
        if (!is_numeric($bucket["key"]??null)) {fwrite(STDERR,"non-numeric key: ".json_encode($r)."\n");exit(1);}
        $counts[sprintf("%.3f",(float)$bucket["key"])]=$bucket["doc_count"];
      }
      $expected=["0.946"=>1,"1.000"=>2,"5.000"=>2,"10.000"=>1];
      ksort($counts);ksort($expected);
      if ($counts!==$expected) {fwrite(STDERR,"$phase combined: ".json_encode($r)."\n");exit(1);}
      echo "$phase combined OK\n";
    ' "$phase"
  curl -sS -X POST http://localhost:9308/search -H 'Content-Type: application/json' \
    -d '{"table":"json_mixed_numeric_facets","query":{"equals":{"id":7}},"limit":0,"aggs":{"vol":{"terms":{"field":"j.a","size":10}}}}' \
    | php -r '
      $phase=$argv[1];$r=json_decode(stream_get_contents(STDIN),true);
      $b=$r["aggregations"]["vol"]["buckets"]??[];
      if (count($b)!==1 || !is_array($b[0]["key"]??null) || ($b[0]["doc_count"]??null)!==1) {fwrite(STDERR,"$phase non-numeric: ".json_encode($r)."\n");exit(1);}
      echo "$phase non-numeric OK\n";
    ' "$phase"
}
check ram
mysql -h0 -P9306 -e "FLUSH RAMCHUNK json_mixed_numeric_facets;"
check disk
