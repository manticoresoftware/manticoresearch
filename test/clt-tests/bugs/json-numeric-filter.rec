{"http":{"must":{"in":{"j.i":[1,2]}}},"ids":[1,2,5,6,8,10,11,12,13]}
{"http":{"must_not":{"equals":{"j.i":2}}},"ids":[3,4,9,13,14]}
{"http":{"must":{"range":{"j.i":{"lt":2}}}},"ids":[1,5,12,13]}
