––– comment –––
JSON array IN() must return each matching document once when the secondary index
merges overlapping posting lists. The last row is present in both lists, so
exhausting either iterator must not duplicate it in the single-iterator path.
––– block: ../base/start-searchd –––
––– input –––
manticore-load --quiet --json --port=9306 --init="SET GLOBAL auto_optimize=0; SET GLOBAL secondary_indexes=1; DROP TABLE IF EXISTS si_union_small; CREATE TABLE si_union_small (j JSON secondary_index='1');" --load="INSERT INTO si_union_small (id,j) VALUES (<increment>,'{\"series\":[\"other\"],\"color\":\"other\"}')" --batch-size=1000 --threads=2 --total=10000 > /dev/null; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "INSERT INTO si_union_small VALUES (10001,'{\"series\":[\"a\"],\"color\":\"blue\"}'), (10002,'{\"series\":[\"b\"],\"color\":\"red\"}'), (10003,'{\"series\":[\"a\",\"b\"],\"color\":\"red\"}'), (10004,'{\"series\":[\"a\",\"b\"],\"color\":\"blue\"}'); FLUSH RAMCHUNK si_union_small;" && echo ready
––– output –––
ready
––– comment –––
Force SI in SQL to verify the iterator path instead of accidentally testing a table scan.
––– input –––
curl -sS -X POST 'http://localhost:9308/sql?mode=raw' --data-urlencode "query=SELECT id, IN(j.series,'a','b') AS matched FROM si_union_small WHERE matched=1 ORDER BY id ASC LIMIT 0,16 /*+ SecondaryIndex(j['series']) */; SHOW META LIKE 'index'" | php -r '$r=json_decode(stream_get_contents(STDIN),true);if(!is_array($r)||!isset($r[0]["data"])||!empty($r[0]["error"])){fwrite(STDERR,"SQL error: ".json_encode($r)."\n");exit(1);}$ids=array_map("intval",array_column($r[0]["data"],"id"));$si=false;foreach($r[1]["data"]??[] as $m){if($m["Variable_name"]==="index")$si=strpos($m["Value"],"SecondaryIndex")!==false;}echo json_encode(["ids"=>$ids,"unique"=>count(array_unique($ids)),"si"=>$si]),PHP_EOL;'
––– output –––
{"ids":[10001,10002,10003,10004],"unique":4,"si":true}
––– comment –––
The HTTP /search path must keep both hits.total and facet counts deduplicated.
––– input –––
curl -sS -X POST http://localhost:9308/search -H 'Content-Type: application/json' -d '{"table":"si_union_small","query":{"bool":{"must":[{"in":{"j.series":["a","b"]}}]}},"limit":16,"max_matches":20000,"options":{"cutoff":0},"sort":[{"id":"asc"}],"aggs":{"color":{"terms":{"field":"j.color","size":10}}}}' | php -r '$r=json_decode(stream_get_contents(STDIN),true);$ids=array_map("intval",array_column($r["hits"]["hits"],"_id"));$colors=[];foreach($r["aggregations"]["color"]["buckets"] as $b){$colors[$b["key"]]=$b["doc_count"];}ksort($colors);echo json_encode(["total"=>$r["hits"]["total"],"ids"=>$ids,"colors"=>$colors]),PHP_EOL;'
––– output –––
{"total":4,"ids":[10001,10002,10003,10004],"colors":{"blue":2,"red":2}}
––– comment –––
When a union result spans more than one row-id block, the last emitted row
must also be remembered across GetNextRowIdBlock() calls. Keep the matches
selective so the secondary index is actually used.
––– input –––
manticore-load --quiet --json --port=9306 --init="DROP TABLE IF EXISTS si_union_blocks; CREATE TABLE si_union_blocks (j JSON secondary_index='1');" --load="INSERT INTO si_union_blocks (id,j) VALUES (<increment>,'{\"series\":[\"other\"],\"color\":\"other\"}')" --batch-size=1000 --threads=2 --total=10000 > /dev/null; echo $?
––– output –––
0
––– input –––
manticore-load --quiet --json --port=9306 --load="REPLACE INTO si_union_blocks (id,j) VALUES (<increment>,'{\"series\":[\"a\",\"b\"],\"color\":\"red\"}')" --batch-size=550 --threads=1 --total=1100 > /dev/null; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "FLUSH RAMCHUNK si_union_blocks;" && echo ready
––– output –––
ready
––– input –––
curl -sS -X POST 'http://localhost:9308/sql?mode=raw' --data-urlencode "query=SELECT id, IN(j.series,'a','b') AS matched FROM si_union_blocks WHERE matched=1 ORDER BY id ASC LIMIT 0,1200 OPTION max_matches=2000,cutoff=0 /*+ SecondaryIndex(j['series']) */; SHOW META LIKE 'index'" | php -r '$r=json_decode(stream_get_contents(STDIN),true);if(!is_array($r)||!isset($r[0]["data"])||!empty($r[0]["error"])){fwrite(STDERR,"SQL error: ".json_encode($r)."\n");exit(1);}$ids=array_map("intval",array_column($r[0]["data"],"id"));$si=false;foreach($r[1]["data"]??[] as $m){if($m["Variable_name"]==="index")$si=strpos($m["Value"],"SecondaryIndex")!==false;}echo json_encode(["rows"=>count($ids),"unique"=>count(array_unique($ids)),"si"=>$si]),PHP_EOL;'
––– output –––
{"rows":1100,"unique":1100,"si":true}
––– input –––
curl -sS -X POST http://localhost:9308/search -H 'Content-Type: application/json' -d '{"table":"si_union_blocks","query":{"bool":{"must":[{"in":{"j.series":["a","b"]}}]}},"limit":1200,"max_matches":2000,"options":{"cutoff":0},"sort":[{"id":"asc"}],"aggs":{"color":{"terms":{"field":"j.color","size":5}}}}' | php -r '$r=json_decode(stream_get_contents(STDIN),true);$ids=array_column($r["hits"]["hits"],"_id");$b=$r["aggregations"]["color"]["buckets"][0]??[];echo json_encode(["total"=>$r["hits"]["total"],"rows"=>count($ids),"unique"=>count(array_unique($ids)),"red_count"=>$b["doc_count"]??null]),PHP_EOL;'
––– output –––
{"total":1100,"rows":1100,"unique":1100,"red_count":1100}
––– input –––
mysql -h0 -P9306 -e "DROP TABLE si_union_small; DROP TABLE si_union_blocks;"
