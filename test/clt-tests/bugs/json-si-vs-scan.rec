cat > /tmp/json_si_vs_scan.php <<'PHP'
<?php
function run ( $sQuery, $iMaxId ) {
	$tCtx = stream_context_create ( [ 'http' => [ 'method' => 'POST', 'header' => 'Content-Type: application/x-www-form-urlencoded', 'content' => http_build_query ( [ 'query' => $sQuery ] ) ] ] );
	$dRes = json_decode ( file_get_contents ( 'http://localhost:9308/sql?mode=raw', false, $tCtx ), true );
	if ( !is_array ( $dRes ) || !empty ( $dRes[0]['error'] ) )
		return [ 'error' => $dRes[0]['error'] ?? 'bad response' ];
	$dIds = array_values ( array_filter ( array_map ( 'intval', array_column ( $dRes[0]['data'], 'id' ) ), fn ( $i ) => $i<=$iMaxId ) );
	$dMeta = array_column ( $dRes[1]['data'], 'Value', 'Variable_name' );
	return [ 'rows' => $dRes[0]['data'], 'ids' => $dIds, 'total' => (int)$dMeta['total_found'], 'index' => $dMeta['index'] ?? '' ];
}
// the same query without and with the secondary index of $sAttr
function compare ( $sLabel, $sValue, $sTable, $sSelect, $sWhere, $sAttr, $iMaxId ) {
	$sQuery = "SELECT id$sSelect FROM $sTable WHERE $sWhere ORDER BY id ASC LIMIT 100 OPTION cutoff=0 /*+ %s($sAttr) */; SHOW META";
	$tScan = run ( sprintf ( $sQuery, 'No_SecondaryIndex' ), $iMaxId );
	$tSI = run ( sprintf ( $sQuery, 'SecondaryIndex' ), $iMaxId );
	$bSame = !isset ( $tScan['error'] ) && !isset ( $tSI['error'] ) && $tScan['ids']===$tSI['ids'] && $tScan['total']===$tSI['total'];
	$bSI = isset ( $tSI['index'] ) ? strpos ( $tSI['index'], 'SecondaryIndex' )!==false : null;
	echo json_encode ( [ $sLabel => $sValue, 'same' => $bSame, 'si' => $bSI, 'ids' => $tScan['ids'] ?? $tScan, 'total' => $tScan['total'] ?? null ] ), PHP_EOL;
}
echo "si_any_for", PHP_EOL;
foreach ( [ [ "ANY(x=2 FOR x IN j.i)", "j['i']" ], [ "ANY(x=3 OR x=4 FOR x IN j.i)", "j['i']" ], [ "ANY(x>1 AND x<3 FOR x IN j.i)", "j['i']" ], [ "ANY(x<3 AND x>1 FOR x IN j.i)", "j['i']" ],
	[ "ANY(x<=2 AND x>=2 FOR x IN j.i)", "j['i']" ], [ "ANY(x<10 AND x<4294967296 FOR x IN j.i)", "j['i']" ], [ "ANY(x='y' FOR x IN j.s)", "j['s']" ],
	[ "ANY(x!=2 FOR x IN j.i)", "j['i']" ], [ "ANY(NOT (x=2) FOR x IN j.i)", "j['i']" ], [ "ANY(IF(x=2,0,1) FOR x IN j.i)", "j['i']" ], [ "ANY(x!='y' FOR x IN j.s)", "j['s']" ],
	[ "ANY(2<x FOR x IN j.i)", "j['i']" ], [ "ANY(x+1=3 FOR x IN j.i)", "j['i']" ], [ "ANY(x<5 AND id>1 FOR x IN j.i)", "j['i']" ], [ "ANY(x<'y' FOR x IN j.s)", "j['s']" ],
	[ "ANY(x=2.5 FOR x IN j.f)", "j['f']" ], [ "ANY(x>=2.5 AND x<=3.5 FOR x IN j.f)", "j['f']" ], [ "INDEXOF(x=2 FOR x IN j.i)", "j['i']" ] ] as [ $sExpr, $sAttr ] )
	compare ( 'expr', $sExpr, 'si_any_for', ", $sExpr AS m", 'm=1', $sAttr, 5 );
echo "si_dup_vals", PHP_EOL;
foreach ( [ [ "j.i = 2", "j['i']" ], [ "j.s = 'y'", "j['s']" ], [ "j.f = 2.5", "j['f']" ], [ "j.f BETWEEN 0.9 AND 1.1", "j['f']" ] ] as [ $sWhere, $sAttr ] )
	compare ( 'where', $sWhere, 'si_dup_vals', '', $sWhere, $sAttr, 4 );
foreach ( [ "j.i = 2", "j.s = 'y'" ] as $sWhere ) {
	$tRes = run ( "SELECT COUNT(*) c FROM si_dup_vals WHERE $sWhere; SHOW META", 0 );
	echo json_encode ( [ 'count' => $sWhere, 'c' => (int)$tRes['rows'][0]['c'], 'index' => $tRes['index'] ] ), PHP_EOL;
}
echo "si_types", PHP_EOL;
foreach ( [ [ "int", "= 2" ], [ "int", "= 2.5" ], [ "int", "> 1.5" ], [ "flt", "= 2.5" ], [ "flt", "IN (1,2)" ], [ "flt", "> 1" ], [ "str", "= 'b'" ], [ "str", "> 1" ], [ "intstr", "= 2" ], [ "intstr", "= '2'" ] ] as [ $sKey, $sCond ] )
	compare ( 'where', "j.$sKey $sCond", 'si_types', '', "j.$sKey $sCond", "j['$sKey']", 4 );
echo "si_excl", PHP_EOL;
foreach ( [ [ "j.i = 2", "i" ], [ "j.i != 2", "i" ], [ "j.i NOT IN (1,2)", "i" ], [ "j.i NOT BETWEEN 1 AND 2", "i" ], [ "j.s != 'b'", "s" ], [ "j.s NOT IN ('a','b')", "s" ] ] as [ $sWhere, $sKey ] )
	compare ( 'where', $sWhere, 'si_excl', '', $sWhere, "j['$sKey']", 4 );
PHP
