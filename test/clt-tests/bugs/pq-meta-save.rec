––– input –––
mysql -h0 -P9306 -NB -e "SELECT id FROM pq WHERE id>100000 AND id<1000000 LIMIT 100000 OPTION max_matches=100000" | grep -oE '[0-9]+' | sort > /tmp/pq-present; sort /tmp/pq-acked | comm -23 - /tmp/pq-present | wc -l
