{"chunk":"disk","where":"s ALL('x','y')","ids":[1,5],"json_same":true,"columnar_same":true}
{"chunk":"disk","where":"s NOT ANY('x','y')","ids":[4,8],"json_same":true,"columnar_same":true}
{"chunk":"disk","where":"s NOT ALL('x','y')","ids":[2,3,4,6,7,8],"json_same":true,"columnar_same":true}
{"chunk":"disk","where":"s ALL('x')","ids":[1,2,5,6,7],"json_same":true,"columnar_same":true}
{"chunk":"disk","http":"must in any(s) [x,y]","ids":[1,2,3,5,6,7],"json_same":true,"columnar_same":true}
{"chunk":"disk","http":"must in all(s) [x,y]","ids":[1,5],"json_same":true,"columnar_same":true}
{"chunk":"disk","http":"must_not in all(s) [x,y]","ids":[2,3,4,6,7,8],"json_same":true,"columnar_same":true}
––– input –––
mysql -h0 -P9306 -e "DROP TABLE tags_row; DROP TABLE tags_col;"; rm -f /tmp/tags.php
