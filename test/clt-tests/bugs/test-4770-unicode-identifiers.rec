––– comment –––
Config-managed real-time, percolate, and plain table names use the same 242-byte limit
––– input –––
python3 - <<'PY'
from pathlib import Path
names={kind:'a'*241+suffix for kind,suffix in [('plain','n'),('rt','r'),('pq','p')]}
conf="source s {\n type = csvpipe\n csvpipe_command = printf '1,needle\\n'\n csvpipe_field = body\n}\n"
conf+=f"table {names['plain']} {{\n type = plain\n source = s\n path = /tmp/test4770-len-242-plain\n}}\n"
conf+=f"table {names['rt']} {{\n type = rt\n path = /tmp/test4770-len-242-rt\n rt_field = body\n}}\n"
conf+=f"table {names['pq']} {{\n type = percolate\n path = /tmp/test4770-len-242-pq\n rt_field = body\n}}\n"
searchd="searchd {\n listen = 127.0.0.1:19306:mysql\n log = /tmp/test4770-len.log\n query_log = /tmp/test4770-len-query.log\n pid_file = /tmp/test4770-len.pid\n buddy_path =\n}\n"
Path('/tmp/test4770-len-242.conf').write_text(conf+searchd)
for kind,suffix in [('plain','n'),('rt','r'),('pq','p')]:
 name='a'*242+suffix
 body="source s {\n type = csvpipe\n csvpipe_command = printf '1,needle\\n'\n csvpipe_field = body\n}\n" if kind=='plain' else ''
 table_type='percolate' if kind=='pq' else kind
 body+=f"table {name} {{\n type = {table_type}\n path = /tmp/test4770-len-243-{kind}\n"
 body+=(" source = s\n" if kind=='plain' else " rt_field = body\n")
 body+="}\n"+searchd
 Path(f'/tmp/test4770-len-243-{kind}.conf').write_text(body)
PY
rm -rf /tmp/test4770-len-242-plain /tmp/test4770-len-242-rt /tmp/test4770-len-242-pq /tmp/test4770-len-243-plain /tmp/test4770-len-243-rt /tmp/test4770-len-243-pq /tmp/test4770-len.pid /tmp/test4770-len.log; if indexer --config /tmp/test4770-len-242.conf --all >/dev/null 2>&1; then echo config_242_indexed; else echo config_242_failed; fi; searchd --config /tmp/test4770-len-242.conf >/dev/null; for i in {1..50}; do mysqladmin -h127.0.0.1 -P19306 ping --silent >/dev/null 2>&1 && break; sleep 0.1; done; mysql --skip-table --batch --skip-column-names -h127.0.0.1 -P19306 -e 'SHOW TABLES' | wc -l | tr -d ' '; searchd --config /tmp/test4770-len-242.conf --stopwait >/dev/null; for kind in plain rt pq; do if searchd --config /tmp/test4770-len-243-$kind.conf --check >/dev/null 2>&1; then echo config_243_${kind}_accepted; else echo config_243_${kind}_rejected; fi; done
