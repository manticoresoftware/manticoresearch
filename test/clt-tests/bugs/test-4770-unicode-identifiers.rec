malformed_rejected
malformed_bit_rejected
malformed_selector_rejected
malformed_rule_rejected
daemon_alive
––– comment –––
SQL-managed table names use the 242-byte limit and reject unsafe invisible Unicode
––– input –––
python3 - <<'PY'
import subprocess
m=['mysql','--binary-mode','-h0','-P9306']
for n in (242,243):
 name='a'*n
 r=subprocess.run(m,input=f'CREATE TABLE `{name}` (body text);'.encode(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 print(f'sql_{n}_'+('accepted' if r.returncode==0 else 'rejected'))
 if r.returncode==0:
  subprocess.run(m,input=f'DROP TABLE `{name}`;'.encode(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
for name in ('bad\u00a0name','bad\u200bname','bad\u202ename','a\u200dname'):
 r=subprocess.run(m,input=f'CREATE TABLE `{name}` (body text);'.encode(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 print('unsafe_'+('accepted' if r.returncode==0 else 'rejected'))
PY
––– output –––
sql_242_accepted
sql_243_rejected
unsafe_rejected
unsafe_rejected
unsafe_rejected
unsafe_rejected
