Prepared statements preserve Russian table and field names
––– input –––
php -r 'mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT); $m=new mysqli("127.0.0.1", "", "", "", 9306); $m->set_charset("utf8"); $s=$m->prepare("SELECT id FROM товары2026 WHERE цена=?"); $v=100; $s->bind_param("i",$v); $s->execute(); echo $s->get_result()->fetch_row()[0], PHP_EOL;'
