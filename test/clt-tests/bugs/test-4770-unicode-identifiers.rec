––– comment –––
Issue #4770: SQL identifiers must support UTF-8 table and field names
––– block: ../base/start-searchd –––
––– comment –––
Backtick-quoted UTF-8 identifiers work through DDL and DML
––– input –––
mysql -h0 -P9306 -e 'CREATE TABLE `搜索表` (`标题` text, `价格` integer);' && echo created
––– output –––
created
––– input –––
mysql -h0 -P9306 -e "INSERT INTO \`搜索表\` (id, \`标题\`, \`价格\`) VALUES (1, '你好', 42);" && echo inserted
––– output –––
inserted
––– input –––
mysql --table -h0 -P9306 -e 'SELECT id, `标题`, `价格` FROM `搜索表`;' | awk -F'|' '/你好/ { for (i=2; i<=4; i++) gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i); print $2 "|" $3 "|" $4 }'
––– output –––
1|你好|42
––– input –––
mysql -h0 -P9306 -e 'DESCRIBE `搜索表`;' | grep -oE '标题|价格'
––– output –––
标题
价格
––– comment –––
Unquoted UTF-8 identifiers work through DDL and DML
––– input –––
mysql -h0 -P9306 -e 'CREATE TABLE 商品表 (名称 text, 库存 integer);' && echo created
––– output –––
created
––– input –––
mysql -h0 -P9306 -e "INSERT INTO 商品表 (id, 名称, 库存) VALUES (2, '键盘', 7);" && echo inserted
––– output –––
inserted
––– input –––
mysql --table -h0 -P9306 -e 'SELECT id, 名称, 库存 FROM 商品表;' | awk -F'|' '/键盘/ { for (i=2; i<=4; i++) gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i); print $2 "|" $3 "|" $4 }'
––– output –––
2|键盘|7
––– comment –––
UTF-8 table names are visible and can be dropped
––– input –––
mysql -h0 -P9306 -e 'SHOW TABLES;' | grep -oE '搜索表|商品表' | LC_ALL=C sort
––– output –––
商品表
搜索表
––– input –––
mysql -h0 -P9306 -e 'DROP TABLE `搜索表`; DROP TABLE 商品表;' && echo dropped
––– output –––
dropped
