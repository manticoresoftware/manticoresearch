bad_field_rejected
––– comment –––
Embedded XML schemas reject unsupported field and attribute names
––– input –––
cat > /tmp/test4770-bad-xml-field.xml <<'EOF'
<?xml version="1.0"?>
<sphinx:docset>
<sphinx:schema><sphinx:field name="bad-name"/></sphinx:schema>
<sphinx:document id="1"><bad-name>needle</bad-name></sphinx:document>
</sphinx:docset>
EOF
cat > /tmp/test4770-bad-xml-field.conf <<'EOF'
source bad_xml {
 type = xmlpipe2
 xmlpipe_command = cat /tmp/test4770-bad-xml-field.xml
}
table good_xml {
 type = plain
 source = bad_xml
 path = /tmp/test4770-bad-xml-field
}
EOF
if indexer --config /tmp/test4770-bad-xml-field.conf --all >/dev/null 2>&1; then echo bad_xml_field_accepted; else echo bad_xml_field_rejected; fi
––– output –––
bad_xml_field_rejected
––– input –––
cat > /tmp/test4770-bad-xml-attr.xml <<'EOF'
<?xml version="1.0"?>
<sphinx:docset>
<sphinx:schema><sphinx:field name="body"/><sphinx:attr name="bad-name" type="int"/></sphinx:schema>
<sphinx:document id="1"><body>needle</body><bad-name>1</bad-name></sphinx:document>
</sphinx:docset>
EOF
cat > /tmp/test4770-bad-xml-attr.conf <<'EOF'
source bad_xml {
 type = xmlpipe2
