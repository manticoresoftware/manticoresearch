bad_table_rejected
––– input –––
printf '%s\n' 'source bad_source {' ' type = csvpipe' " csvpipe_command = printf '1,needle\\n'" ' csvpipe_field = bad-name' '}' 'table good_table {' ' type = plain' ' source = bad_source' ' path = /tmp/test4770-bad-field' '}' 'searchd {' ' listen = 127.0.0.1:19306:mysql' ' log = /tmp/test4770-bad.log' ' query_log = /tmp/test4770-bad-query.log' ' pid_file = /tmp/test4770-bad.pid' '}' > /tmp/test4770-bad-field.conf; if indexer --config /tmp/test4770-bad-field.conf --all >/dev/null 2>&1; then echo bad_field_accepted; else echo bad_field_rejected; fi
