––– comment –––
Config-managed table and field names reject unsupported ASCII punctuation consistently
––– input –––
printf '%s\n' 'table bad-name {' ' type = rt' ' path = /tmp/test4770-bad-table' ' rt_field = body' '}' 'searchd {' ' listen = 127.0.0.1:19306:mysql' ' log = /tmp/test4770-bad.log' ' query_log = /tmp/test4770-bad-query.log' ' pid_file = /tmp/test4770-bad.pid' '}' > /tmp/test4770-bad-table.conf; if searchd --config /tmp/test4770-bad-table.conf --check >/tmp/test4770-bad-table.out 2>&1; then echo bad_table_accepted; elif grep -q "invalid table name 'bad-name': invalid character '-'" /tmp/test4770-bad-table.out; then echo bad_table_rejected; else echo wrong_table_failure; fi
