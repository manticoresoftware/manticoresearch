––– comment –––
Regression for issue #5016: the config is replaced without an intermediate .old file,
and a zero-byte manticore.json must not silently discard the table registry.

––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS gh5016; CREATE TABLE gh5016 (title text);"
––– output –––
––– input –––
python3 -c 'import json,os; p="/var/lib/manticore/manticore.json"; d=json.load(open(p)); print("JSON_CONFIG_OK" if "gh5016" in d["indexes"] and not os.path.exists(p+".old") else "JSON_CONFIG_BAD")'
––– output –––
JSON_CONFIG_OK
––– input –––
mysql -h0 -P9306 -e "DROP TABLE gh5016;"
––– output –––
––– input –––
bash <<'EOF'
dir=$(mktemp -d /tmp/gh5016.XXXXXX)
trap 'rm -rf "$dir"' EXIT
: > "$dir/manticore.json"
cat > "$dir/manticore.conf" <<CONF
searchd {
    listen = 127.0.0.1:19516:mysql41
    log = $dir/searchd.log
    pid_file = $dir/searchd.pid
    data_dir = $dir
    buddy_path =
}
CONF
output=$(timeout 10 searchd --config "$dir/manticore.conf" --nodetach 2>&1)
code=$?
if [ "$code" -ne 0 ] && [ "$code" -ne 124 ] && \
   { printf '%s\n' "$output" | grep -q "JSON config.*is empty" || grep -q "JSON config.*is empty" "$dir/searchd.log" 2>/dev/null; } && \
   [ ! -s "$dir/manticore.json" ]; then
    echo EMPTY_JSON_REJECTED
else
    echo EMPTY_JSON_NOT_REJECTED
fi
EOF
––– output –––
EMPTY_JSON_REJECTED
