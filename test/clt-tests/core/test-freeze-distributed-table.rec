warning	1000	Some tables are not suitable for freezing: no_such_table
––– input –––
mysql --no-defaults -h0 -P9306 -BN -e "FREEZE rt_for_freeze, no_such_table, dist_for_freeze; SHOW WARNINGS" >/tmp/freeze-distributed-result
grep -q '/rt_for_freeze.meta' /tmp/freeze-distributed-result && echo "local files: OK"
grep '^warning' /tmp/freeze-distributed-result
––– output –––
local files: OK
warning	1000	Some tables are not suitable for freezing: no_such_table, dist_for_freeze
––– input –––
mysql --no-defaults -h0 -P9306 -BN -e "SHOW TABLE rt_for_freeze STATUS LIKE 'locked'; UNFREEZE rt_for_freeze, no_such_table, dist_for_freeze; SHOW LOCKS; SHOW TABLE rt_for_freeze STATUS LIKE 'locked'; SELECT id, title FROM dist_for_freeze"
