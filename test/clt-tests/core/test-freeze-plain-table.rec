––– input –––
searchd --stopwait >/dev/null 2>&1 || true
rm -rf /tmp/freeze-plain-table
mkdir -p /tmp/freeze-plain-table/data /tmp/freeze-plain-table/binlog
printf '1,first\n' >/tmp/freeze-plain-table/rows.csv
printf '%s\n' 'source src {' '  type = csvpipe' '  csvpipe_command = cat /tmp/freeze-plain-table/rows.csv' '  csvpipe_field = title' '}' 'index plain {' '  source = src' '  path = /tmp/freeze-plain-table/data/plain' '}' 'searchd {' '  listen = 127.0.0.1:9306:mysql' '  log = /tmp/freeze-plain-table/searchd.log' '  pid_file = /tmp/freeze-plain-table/searchd.pid' '  binlog_path = /tmp/freeze-plain-table/binlog' '  watchdog = 0' '}' >/tmp/freeze-plain-table/manticore.conf
indexer --config /tmp/freeze-plain-table/manticore.conf plain
searchd --config /tmp/freeze-plain-table/manticore.conf
––– output –––
––– input –––
mysql -h0 -P9306 -e 'FREEZE plain; SHOW LOCKS'
