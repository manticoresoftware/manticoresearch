ERROR 1064 (42000) at line 1: table plain: table is locked
––– input –––
printf '2,rotated\n' >/tmp/freeze-plain-table/rows.csv
indexer --config /tmp/freeze-plain-table/manticore.conf --rotate plain
sleep 1
mysql -h0 -P9306 -e 'SELECT id,title FROM plain'
