––– comment –––
Crash an assisted load while its sibling indexer is paused. A restart must use a
new load directory, then PURGE and DROP must remove all staging state.
––– input –––
root=/tmp/indexer-rt-bulk-staging
rm -rf "$root"
mkdir -p "$root/bin" "$root/data"
cp "$(readlink -f "$(command -v searchd)")" "$root/bin/searchd"
cp "$(readlink -f "$(command -v indexer)")" "$root/bin/indexer.real"
cat > "$root/bin/indexer" <<'EOF'
#!/bin/sh
root=/tmp/indexer-rt-bulk-staging
tag=$(cat "$root/load.tag")
printf '%s\n' "$$" > "$root/$tag.child"
: > "$root/$tag.ready"
while [ ! -e "$root/$tag.release" ]; do sleep 0.02; done
exec "$root/bin/indexer.real" "$@"
EOF
chmod +x "$root/bin/indexer"
cat > "$root/manticore.conf" <<EOF
searchd {
  listen = 127.0.0.1:19326:mysql41
  listen = 127.0.0.1:19328:http
  log = $root/searchd.log
  query_log = $root/query.log
  pid_file = $root/searchd.pid
  data_dir = $root/data
  workers = threads
  watchdog = 0
}
EOF
MANTICORE_NO_BUDDY=1 "$root/bin/searchd" --config "$root/manticore.conf" --nodetach >"$root/console-1.log" 2>&1 & echo $! > "$root/searchd-1.pid"
ready=0; for i in $(seq 1 100); do mysql -h0 -P19326 -e 'SELECT 1' >/dev/null 2>&1 && { ready=1; break; }; sleep 0.1; done
if [ "$ready" != 1 ]; then echo FAIL_STAGING_START; fi
mysql -h0 -P19326 -e 'CREATE TABLE rt_bulk_staging (title TEXT);'
echo first > "$root/load.tag"
cat > "$root/first.sql" <<EOF
SET bulk_import=rt_bulk_staging;
INSERT INTO rt_bulk_staging(id,title) VALUES(1,'crash left');
COMMIT;
SET bulk_import=0;
EOF
mysql -h0 -P19326 < "$root/first.sql" >"$root/first.out" 2>"$root/first.err" & echo $! > "$root/first.writer"
ready=0; for i in $(seq 1 100); do [ -e "$root/first.ready" ] && { ready=1; break; }; sleep 0.1; done
load_root="$root/data/rt_bulk_staging/rt_bulk_staging.indexer-rt-bulk"
first_load=$(find "$load_root" -mindepth 1 -maxdepth 1 -type d | sort | head -1)
if [ "$ready" != 1 ] || [ -z "$first_load" ]; then echo FAIL_STAGING_FIRST_LOAD; fi
printf '%s\n' "$first_load" > "$root/first.load"
kill -9 "$(cat "$root/searchd-1.pid")"
wait "$(cat "$root/searchd-1.pid")" 2>/dev/null || true
kill -9 "$(cat "$root/first.child")" 2>/dev/null || true
wait "$(cat "$root/first.writer")" 2>/dev/null || true
if [ -d "$first_load" ]; then echo STAGING_CRASH_LEFT; else echo FAIL_STAGING_CRASH_LEFT; fi
––– output –––
STAGING_CRASH_LEFT
––– input –––
root=/tmp/indexer-rt-bulk-staging
first_load=$(cat "$root/first.load")
echo second > "$root/load.tag"
MANTICORE_NO_BUDDY=1 "$root/bin/searchd" --config "$root/manticore.conf" --nodetach >"$root/console-2.log" 2>&1 & echo $! > "$root/searchd-2.pid"
ready=0; for i in $(seq 1 100); do mysql -h0 -P19326 -e 'SELECT 1' >/dev/null 2>&1 && { ready=1; break; }; sleep 0.1; done
if [ "$ready" != 1 ]; then echo FAIL_STAGING_RESTART; fi
cat > "$root/second.sql" <<EOF
SET bulk_import=rt_bulk_staging;
INSERT INTO rt_bulk_staging(id,title) VALUES(2,'published after restart');
COMMIT;
SET bulk_import=0;
EOF
mysql -h0 -P19326 < "$root/second.sql" >"$root/second.out" 2>"$root/second.err" & echo $! > "$root/second.writer"
ready=0; for i in $(seq 1 100); do [ -e "$root/second.ready" ] && { ready=1; break; }; sleep 0.1; done
load_root="$root/data/rt_bulk_staging/rt_bulk_staging.indexer-rt-bulk"
second_load=$(find "$load_root" -mindepth 1 -maxdepth 1 -type d ! -path "$first_load" | sort | head -1)
if [ "$ready" != 1 ] || [ -z "$second_load" ] || [ "$second_load" = "$first_load" ]; then echo FAIL_STAGING_REUSED; fi
touch "$root/second.release"
if ! wait "$(cat "$root/second.writer")"; then cat "$root/second.err"; fi
files=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P19326 -e "SELECT file FROM rt_bulk_staging.@files OPTION format='bulk_import'")
count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P19326 -e 'SELECT COUNT(*) FROM rt_bulk_staging')
remaining=$(find "$load_root" -mindepth 1 -maxdepth 1 -type d | sort)
if [ "$remaining" = "$first_load" ] && printf '%s\n' "$files" | grep -Fq "$first_load" && [ "$count" = 1 ]; then echo STAGING_RESTART_UNIQUE; else echo "FAIL_STAGING_RESTART remaining=$remaining files=$files count=$count"; fi
mysql -h0 -P19326 -e 'PURGE BULK_IMPORT FROM TABLE rt_bulk_staging;'
if [ -e "$load_root" ]; then echo FAIL_STAGING_PURGE; fi
mkdir -p "$load_root/drop-load"
mysql -h0 -P19326 -e 'DROP TABLE rt_bulk_staging;'
if [ -e "$load_root" ]; then echo FAIL_STAGING_DROP; fi
kill "$(cat "$root/searchd-2.pid")"; wait "$(cat "$root/searchd-2.pid")" 2>/dev/null || true
rm -rf "$root"
echo STAGING_CLEANUP_OK
––– output –––
STAGING_RESTART_UNIQUE
STAGING_CLEANUP_OK
