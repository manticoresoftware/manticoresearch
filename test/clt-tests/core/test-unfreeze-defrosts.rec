––– block: ../base/start-searchd –––
––– input –––
set -b +m
––– output –––
––– comment –––
Wait for frozen writes to stop making progress rather than depending on elapsed
time or the exact number of rows fitting into an RT memory chunk.
––– input –––
cat > /tmp/clt-wait-freeze.sh <<'EOF'
#!/bin/bash
set -euo pipefail
mode="$1"
table="$2"
expected="$3"
previous=-1
stable=0
while true; do
  count=$(mysql -h0 -P9306 -sN -e "SELECT COUNT(*) FROM $table")
  if [ "$mode" = blocked ]; then
    if (( count >= expected )); then
      echo "Writes completed before UNFREEZE ($count)" >&2
      exit 1
    fi
    if (( count > 1 && count == previous )); then
      stable=$((stable + 1))
    else
      stable=0
    fi
    if (( stable >= 6 )); then
      echo "Frozen writes blocked"
      exit 0
    fi
  elif [ "$mode" = count ]; then
    if (( count == expected )); then
      echo "$count"
      exit 0
    fi
    if (( count > expected )); then
      echo "Unexpected row count ($count, expected $expected)" >&2
      exit 1
    fi
  else
    echo "Unknown wait mode: $mode" >&2
    exit 2
  fi
  previous=$count
  sleep 0.5
done
EOF
––– output –––
––– input –––
mysql -h0 -P9306 -e "drop table if exists t; create table t(f text, s string) rt_mem_limit='128k'; insert into t values(0,'abc','string'); freeze t;" > /dev/null 2>&1 && echo "Initialized"
––– output –––
