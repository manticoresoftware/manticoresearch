––– input –––
mysql -h0 -P9306 <<'SQL'
DROP TABLE IF EXISTS bulk_import_case;
CREATE TABLE BuLk_ImPoRt_CaSe (title TEXT, gid INTEGER);
SET bulk_import=BULK_IMPORT_CASE;
INSERT INTO bulk_import_case(id,title,gid) VALUES (1,'SQL mixed case',11);
COMMIT;
SET bulk_import=0;
SQL
––– output –––
––– input –––
reply=$(printf '%s\n' '{"insert":{"table":"BULK_IMPORT_CASE","id":2,"doc":{"title":"HTTP mixed case","gid":12}}}' | curl -sS -X POST 'http://localhost:9308/bulk?bulk_import=BuLk_ImPoRt_CaSe' -H 'Content-Type: application/x-ndjson' --data-binary @-); rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM bulk_import_case" | sort -n); expected=$(printf '1\tSQL mixed case\t11\n2\tHTTP mixed case\t12'); if printf '%s' "$reply" | grep -q '"errors":false' && [ "$rows" = "$expected" ]; then echo BULK_IMPORT_CASE_INSENSITIVE_OK; else printf 'FAIL_BULK_IMPORT_CASE reply=%s rows=%s\n' "$reply" "$rows"; fi
––– output –––
BULK_IMPORT_CASE_INSENSITIVE_OK
