––– input –––
rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,label,i,ts,b,f,big,m,m64,vec,j FROM rt_bulk_types" | sort -n); expected=$(printf '%b\n' '1\talpha, "quoted" \\ path\tlabel, "quoted" \\ path\t4294967254\t1700000000\t1\t-3.125000\t-9223372036854775807\t1,4294967295\t-10000000002,10000000001\t1.250000,-2.500000,3.750000\t{"k":"v","n":7,"arr":[1,2]}' '2\tsecond\t\t0\t0\t0\t2.500000\t9223372036854775807\t7,8\t9,10\t0.000000,1.000000,2.000000\tNULL' '3\tmissing attrs\tmissing label\t0\t0\t0\t0.000000\t0\t\t\t\tNULL'); if [ "$rows" = "$expected" ]; then echo ASSISTED_TYPE_MATRIX_OK; else printf 'FAIL_ASSISTED_TYPE_MATRIX rows=%s expected=%s\n' "$rows" "$expected"; fi
