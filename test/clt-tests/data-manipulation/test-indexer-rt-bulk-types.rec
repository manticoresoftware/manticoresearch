    (1,'alpha, "quoted" \\ path','label, "quoted" \\ path',-42,1700000000,1,-3.125,-9223372036854775807,(1,4294967295),(10000000001,-10000000002),(1.25,-2.5,3.75),'{"k":"v","n":7,"arr":[1,2]}');
INSERT INTO rt_bulk_types(id,title,label,i,ts,b,f,big,m,m64,vec) VALUES
    (2,'second','',0,0,0,2.5,9223372036854775807,(7,8),(9,10),(0,1,2));
