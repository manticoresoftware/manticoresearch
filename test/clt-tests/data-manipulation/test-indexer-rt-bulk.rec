mysql -h0 -P9306 <<'SQL'
DROP TABLE IF EXISTS rt_bulk_sql;
CREATE TABLE rt_bulk_sql (title TEXT, gid INTEGER);
INSERT INTO rt_bulk_sql(id,title,gid) VALUES (1,'regular row',1);
SET indexer_rt_bulk=rt_bulk_sql;
BEGIN;
INSERT INTO rt_bulk_sql(id,title,gid) VALUES (1,'assisted replacement',11),(2,'assisted row',12);
COMMIT;
SET indexer_rt_bulk=0;
SQL
