2
––– input –––
out=$(mysql --force -h0 -P9306 2>&1 <<'SQL'
SET bulk_import=rt_bulk_sql;
INSERT INTO rt_bulk_sql(unknown_column) VALUES ('rejected before staging');
INSERT INTO rt_bulk_sql(id,title) VALUES (4,'valid after error');
COMMIT;
SET bulk_import=0;
SQL
); rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM rt_bulk_sql WHERE id=4"); expected=$(printf '4\tvalid after error\t0'); if printf '%s\n' "$out" | grep -qi 'unknown column' && [ "$rows" = "$expected" ]; then echo ASSISTED_COLUMN_VALIDATION_OK; else printf 'FAIL_ASSISTED_COLUMN_VALIDATION output=%s rows=%s\n' "$out" "$rows"; fi
––– output –––
ASSISTED_COLUMN_VALIDATION_OK
––– input –––
chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE rt_bulk_sql STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$chunks" = 3 ]; then echo ASSISTED_SQL_PUBLISHED; else echo "FAIL_ASSISTED_SQL chunks=$chunks"; fi
––– output –––
ASSISTED_SQL_PUBLISHED
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS rt_bulk_exclusive; CREATE TABLE rt_bulk_exclusive (title TEXT);"; tmpdir=$(mktemp -d); trap 'exec 3>&- || true; if [ -n "${owner:-}" ]; then kill "$owner" 2>/dev/null || true; fi; rm -rf "$tmpdir"' EXIT; mkfifo "$tmpdir/in"; mysql --unbuffered --skip-table --batch --raw --skip-column-names -h0 -P9306 < "$tmpdir/in" > "$tmpdir/out" 2>&1 & owner=$!; exec 3>"$tmpdir/in"; printf '%s\n' 'SET bulk_import=rt_bulk_exclusive;' "SELECT 'OWNER_READY';" >&3; i=0; until grep -q OWNER_READY "$tmpdir/out" || [ "$i" -ge 100 ]; do sleep 0.1; i=$((i+1)); done; second=$(mysql --force -h0 -P9306 -e "SET bulk_import=rt_bulk_exclusive" 2>&1 || true); locks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW LOCKS" | awk '$2=="rt_bulk_exclusive" && $3=="write_allow_readers" { print $5 }'); readable=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM rt_bulk_exclusive"); dml=$(mysql --force -h0 -P9306 -e "INSERT INTO rt_bulk_exclusive(id,title) VALUES(1,'blocked')" 2>&1 || true); printf '%s\n' 'SET bulk_import=0;' "SELECT 'OWNER_RELEASED';" >&3; i=0; until grep -q OWNER_RELEASED "$tmpdir/out" || [ "$i" -ge 100 ]; do sleep 0.1; i=$((i+1)); done; exec 3>&-; if wait "$owner"; then owner_ok=1; else owner_ok=0; fi; owner=''; if retry=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SET bulk_import=rt_bulk_exclusive; INSERT INTO rt_bulk_exclusive(id,title) VALUES(2,'after release'); COMMIT; SET bulk_import=0; SELECT title FROM rt_bulk_exclusive WHERE id=2" 2>&1); then retry_ok=1; else retry_ok=0; fi; staging=/var/lib/manticore/rt_bulk_exclusive/rt_bulk_exclusive.indexer-rt-bulk; rm -rf "$tmpdir"; trap - EXIT; if printf '%s' "$second" | grep -q "table 'rt_bulk_exclusive' is locked" && [ "$locks" = 1 ] && [ "$readable" = 0 ] && printf '%s' "$dml" | grep -q "table 'rt_bulk_exclusive' is locked" && [ "$owner_ok" = 1 ] && [ "$retry_ok" = 1 ] && [ "$retry" = 'after release' ] && [ ! -e "$staging" ]; then echo ASSISTED_SAME_TABLE_EXCLUSIVE_OK; else printf 'FAIL_ASSISTED_SAME_TABLE_EXCLUSIVE second=%s locks=%s readable=%s dml=%s owner_ok=%s retry_ok=%s retry=%s staging=%s\n' "$second" "$locks" "$readable" "$dml" "$owner_ok" "$retry_ok" "$retry" "$staging"; fi
––– output –––
ASSISTED_SAME_TABLE_EXCLUSIVE_OK
