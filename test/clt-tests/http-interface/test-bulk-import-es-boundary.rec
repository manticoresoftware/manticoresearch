ES_BULK_IMPORT_LEGACY_OPTION_REJECTED
––– input –––
response=$(mktemp); code=$(printf '%s\n' '{"index":{"_index":"es_unknown_option","_id":"3"}}' '{"title":"ordinary unknown option"}' | curl -sS -o "$response" -w '%{http_code}' -X POST 'http://localhost:9308/_bulk?bulk_import=es_unknown_option' -H 'Content-Type: application/x-ndjson' --data-binary @-); reply=$(cat "$response"); rm -f "$response"; row=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT title FROM es_unknown_option WHERE id=3"); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE es_unknown_option STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$code" = 200 ] && printf '%s' "$reply" | grep -q '"errors":false' && [ "$row" = 'ordinary unknown option' ] && [ "$chunks" = 0 ]; then echo ES_BULK_IMPORT_TABLE_OPTION_IGNORED; else printf 'FAIL_ES_BULK_IMPORT_TABLE_OPTION code=%s reply=%s row=%s chunks=%s\n' "$code" "$reply" "$row" "$chunks"; fi
––– output –––
ES_BULK_IMPORT_TABLE_OPTION_IGNORED
––– input –––
response=$(mktemp); code=$(printf '%s\n' '{"index":{"_index":"es_action_pipeline","_id":"4","pipeline":"bulk_import"}}' '{"title":"ordinary action metadata"}' | curl -sS -o "$response" -w '%{http_code}' -X POST 'http://localhost:9308/_bulk' -H 'Content-Type: application/x-ndjson' --data-binary @-); reply=$(cat "$response"); rm -f "$response"; row=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT title FROM es_action_pipeline WHERE id=4"); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE es_action_pipeline STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$code" = 200 ] && printf '%s' "$reply" | grep -q '"errors":false' && [ "$row" = 'ordinary action metadata' ] && [ "$chunks" = 0 ]; then echo ES_BULK_IMPORT_ACTION_PIPELINE_IGNORED; else printf 'FAIL_ES_BULK_IMPORT_ACTION_PIPELINE code=%s reply=%s row=%s chunks=%s\n' "$code" "$reply" "$row" "$chunks"; fi
