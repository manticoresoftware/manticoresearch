––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "SET GLOBAL auto_optimize=0; DROP TABLE IF EXISTS es_pipeline_query; DROP TABLE IF EXISTS es_legacy_option; DROP TABLE IF EXISTS es_unknown_option; DROP TABLE IF EXISTS es_action_pipeline; DROP TABLE IF EXISTS es_ordinary; CREATE TABLE es_pipeline_query (title TEXT); CREATE TABLE es_legacy_option (title TEXT); CREATE TABLE es_unknown_option (title TEXT); CREATE TABLE es_action_pipeline (title TEXT); CREATE TABLE es_ordinary (title TEXT);"
––– output –––
––– input –––
response=$(mktemp); code=$(printf '%s\n' '{"index":{"_index":"es_pipeline_query","_id":"1"}}' '{"title":"must be rejected"}' | curl -sS -o "$response" -w '%{http_code}' -X POST 'http://localhost:9308/_bulk?pipeline=bulk_import' -H 'Content-Type: application/x-ndjson' --data-binary @-); reply=$(cat "$response"); rm -f "$response"; count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM es_pipeline_query"); if [ "$code" = 400 ] && printf '%s' "$reply" | grep -q 'unsupported on Elasticsearch /_bulk' && [ "$count" = 0 ]; then echo ES_BULK_IMPORT_PIPELINE_REJECTED; else printf 'FAIL_ES_BULK_IMPORT_PIPELINE code=%s reply=%s count=%s\n' "$code" "$reply" "$count"; fi
––– output –––
ES_BULK_IMPORT_PIPELINE_REJECTED
––– input –––
response=$(mktemp); code=$(printf '%s\n' '{"index":{"_index":"es_legacy_option","_id":"2"}}' '{"title":"must be rejected"}' | curl -sS -o "$response" -w '%{http_code}' -X POST 'http://localhost:9308/_bulk?bulk_import=1' -H 'Content-Type: application/x-ndjson' --data-binary @-); reply=$(cat "$response"); rm -f "$response"; count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM es_legacy_option"); if [ "$code" = 400 ] && printf '%s' "$reply" | grep -q 'unsupported on Elasticsearch /_bulk' && [ "$count" = 0 ]; then echo ES_BULK_IMPORT_LEGACY_OPTION_REJECTED; else printf 'FAIL_ES_BULK_IMPORT_LEGACY_OPTION code=%s reply=%s count=%s\n' "$code" "$reply" "$count"; fi
