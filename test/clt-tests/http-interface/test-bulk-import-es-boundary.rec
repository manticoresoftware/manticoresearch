response=$(mktemp); code=$(printf '%s\n' '{"index":{"_index":"es_ordinary","_id":"5"}}' '{"title":"ordinary control"}' | curl -sS -o "$response" -w '%{http_code}' -X POST 'http://localhost:9308/_bulk' -H 'Content-Type: application/x-ndjson' --data-binary @-); reply=$(cat "$response"); rm -f "$response"; row=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT title FROM es_ordinary WHERE id=5"); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE es_ordinary STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$code" = 200 ] && printf '%s' "$reply" | grep -q '"errors":false' && [ "$row" = 'ordinary control' ] && [ "$chunks" = 0 ]; then echo ES_BULK_ORDINARY_CONTROL_OK; else printf 'FAIL_ES_BULK_ORDINARY_CONTROL code=%s reply=%s row=%s chunks=%s\n' "$code" "$reply" "$row" "$chunks"; fi
