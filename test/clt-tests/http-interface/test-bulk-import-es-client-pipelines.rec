reply=$(printf '%s\n' '{"index":{"_index":"bulk_import_clients","_id":"1","pipeline":"bulk_import"}}' '{"title":"per-action one","gid":1}' '{"index":{"_index":"bulk_import_clients","_id":"2","pipeline":"bulk_import"}}' '{"title":"per-action two","gid":2}' | curl -sS -X POST 'http://localhost:9308/_bulk' -H 'Content-Type: application/x-ndjson' --data-binary @-); rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM bulk_import_clients WHERE id IN (1,2)" | sort -n); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE bulk_import_clients STATUS LIKE 'disk_chunks'" | awk '{print $2}'); items=$(printf '%s' "$reply" | jq '.items | length'); statuses=$(printf '%s' "$reply" | jq -c '[.items[][].status]'); if [ "$rows" = "$(printf '1\tper-action one\t1\n2\tper-action two\t2')" ] && [ "$chunks" = 1 ] && [ "$items" = 2 ] && [ "$statuses" = '[201,201]' ]; then echo BULK_IMPORT_ACTION_PIPELINE_OK; else printf 'FAIL_ACTION_PIPELINE reply=%s rows=%s chunks=%s\n' "$reply" "$rows" "$chunks"; fi
