mysql -h0 -P9306 -e "DROP TABLE IF EXISTS bulk_import_locked; CREATE TABLE bulk_import_locked (title TEXT, gid INTEGER); DROP TABLE IF EXISTS bulk_import_unlocked; CREATE TABLE bulk_import_unlocked (title TEXT, gid INTEGER);"; tmpdir=$(mktemp -d); mkfifo "$tmpdir/in"; mysql --unbuffered --skip-table --batch --raw --skip-column-names -h0 -P9306 < "$tmpdir/in" > "$tmpdir/out" 2>&1 & client=$!; exec 3>"$tmpdir/in"; printf '%s\n' 'SET bulk_import=bulk_import_locked;' "SELECT 'LOCK_READY';" >&3; i=0; until grep -q LOCK_READY "$tmpdir/out" || [ "$i" -ge 100 ]; do sleep 0.1; i=$((i+1)); done; headers=$(mktemp); response=$(mktemp); code=$(printf '%s\n' '{"index":{"_index":"bulk_import_locked","_id":"1","pipeline":"bulk_import"}}' '{"title":"retry me","gid":1}' | curl -sS -D "$headers" -o "$response" -w '%{http_code}' -X POST 'http://localhost:9308/_bulk' -H 'Content-Type: application/x-ndjson' --data-binary @-); reply=$(cat "$response"); product=$(tr -d '\r' < "$headers" | awk -F': ' 'tolower($1)=="x-elastic-product" { print $2 }'); other=$(printf '%s\n' '{"index":{"_index":"bulk_import_unlocked","_id":"2","pipeline":"bulk_import"}}' '{"title":"independent","gid":2}' | curl -sS -X POST 'http://localhost:9308/_bulk' -H 'Content-Type: application/x-ndjson' --data-binary @-); other_row=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT title,gid FROM bulk_import_unlocked WHERE id=2"); rm -f "$headers" "$response"; exec 3>&-; wait "$client"; count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM bulk_import_locked"); rm -rf "$tmpdir"; if [ "$code" = 503 ] && printf '%s' "$reply" | grep -q "table 'bulk_import_locked' is locked" && [ "$product" = Elasticsearch ] && [ "$count" = 0 ] && printf '%s' "$other" | grep -q '"errors":false' && [ "$other_row" = "$(printf 'independent\t2')" ]; then echo BULK_IMPORT_LOCK_RETRYABLE_OK; else printf 'FAIL_LOCK_RETRYABLE code=%s reply=%s product=%s count=%s other=%s other_row=%s\n' "$code" "$reply" "$product" "$count" "$other" "$other_row"; fi
––– output –––
BULK_IMPORT_LOCK_RETRYABLE_OK
