––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS bulk_import_zero_id; CREATE TABLE bulk_import_zero_id (title TEXT);"
––– output –––
––– input –––
reply=$(printf '%s\n' '{"insert":{"table":"bulk_import_zero_id","id":0,"doc":{"title":"must be rejected"}}}' | curl -sS -X POST 'http://localhost:9308/bulk?bulk_import=bulk_import_zero_id' -H 'Content-Type: application/x-ndjson' --data-binary @-); count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM bulk_import_zero_id"); if printf '%s' "$reply" | grep -q 'requires an explicit non-zero id' && [ "$count" = 0 ]; then echo BULK_IMPORT_ZERO_ID_REJECTED; else printf 'FAIL_BULK_IMPORT_ZERO_ID reply=%s count=%s\n' "$reply" "$count"; fi
––– output –––
BULK_IMPORT_ZERO_ID_REJECTED
