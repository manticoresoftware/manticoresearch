0
{"items":[],"current_line":1,"skipped_lines":1,"errors":true,"error":"bulk_import requires an existing local RT table; table 's_drop' is absent or distributed","error_code":"shared_precondition","shared_state":"rejected"} HTTP 400
––– input –––
source /tmp/shared.sh; sql "CREATE TABLE s_drop (title TEXT, gid INT)"; post s_drop '' /tmp/d2.ndjson; commit s_drop ''; sql "SELECT COUNT(*), MIN(id), MAX(id) FROM s_drop"
