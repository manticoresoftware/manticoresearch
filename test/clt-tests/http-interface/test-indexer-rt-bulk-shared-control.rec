––– comment –––
Private bulk_import next to an open shared pool: another table imports through HTTP and SQL
as usual, the pool's own table is reserved, and the pool still publishes.
––– input –––
source /tmp/shared.sh; sql "CREATE TABLE s_mix (title TEXT, gid INT); CREATE TABLE p_http (title TEXT, gid INT); CREATE TABLE p_sql (title TEXT, gid INT)"; gen s_mix 1 100 > /tmp/m1.ndjson; gen p_http 1 2 > /tmp/m2.ndjson; gen s_mix 1001 1002 > /tmp/m3.ndjson; post s_mix '' /tmp/m1.ndjson
––– output –––
{"items":[],"current_line":100,"skipped_lines":0,"errors":false,"error":"","error_code":"","shared_state":"staged"} HTTP 200
––– input –––
curl -sS -X POST 'http://localhost:9308/bulk?bulk_import=p_http' -H 'Content-Type: application/x-ndjson' --data-binary @/tmp/m2.ndjson | grep -o '"errors":[a-z]*'; mysql -h0 -P9306 -e "SET bulk_import=p_sql; INSERT INTO p_sql (id, title, gid) VALUES (1, 'sql one', 1), (2, 'sql two', 2); COMMIT; SET bulk_import=0"; curl -sS -X POST 'http://localhost:9308/bulk?bulk_import=s_mix' -H 'Content-Type: application/x-ndjson' --data-binary @/tmp/m3.ndjson | grep -o '"error":"[^"]*"'
