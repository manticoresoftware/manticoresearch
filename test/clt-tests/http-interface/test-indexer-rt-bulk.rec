––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS rt_bulk_http; CREATE TABLE rt_bulk_http (title TEXT, gid INTEGER);"
––– output –––
––– input –––
reply=$(printf '%s\n' '{"insert":{"index":"rt_bulk_http","id":1,"doc":{"title":"first HTTP row","gid":11}}}' | curl -sS -X POST 'http://localhost:9308/bulk?bulk_import=rt_bulk_http' -H 'Content-Type: application/x-ndjson' --data-binary @-); if printf '%s' "$reply" | grep -q '"errors":false'; then echo ASSISTED_HTTP_OK; else echo "FAIL_ASSISTED_HTTP reply=$reply"; fi
––– output –––
ASSISTED_HTTP_OK
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM rt_bulk_http"
––– output –––
1	first HTTP row	11
––– input –––
chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE rt_bulk_http STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$chunks" = 1 ]; then echo ASSISTED_HTTP_PUBLISHED; else echo "FAIL_ASSISTED_HTTP_CHUNKS=$chunks"; fi
––– output –––
ASSISTED_HTTP_PUBLISHED
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS rt_bulk_fluent; CREATE TABLE rt_bulk_fluent (title TEXT, gid INTEGER);"
reply=$(printf '%s\n' '{"index":{"_index":"rt_bulk_fluent","_id":"101"}}' '{"title":"first fluent row","gid":1}' '{"index":{"_index":"rt_bulk_fluent","_id":"102"}}' '{"title":"second fluent row","gid":2}' | curl -sS -X POST 'http://localhost:9308/_bulk/?pipeline=bulk_import' -H 'Content-Type: application/x-ndjson' --data-binary @-); rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM rt_bulk_fluent" | sort -n); expected=$(printf '101\tfirst fluent row\t1\n102\tsecond fluent row\t2'); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE rt_bulk_fluent STATUS LIKE 'disk_chunks'" | awk '{print $2}'); items=$(printf '%s' "$reply" | jq '.items | length'); if printf '%s' "$reply" | grep -q '"errors":false' && [ "$items" = 2 ] && [ "$rows" = "$expected" ] && [ "$chunks" = 1 ]; then echo BULK_IMPORT_FLUENT_OK; else printf 'FAIL_BULK_IMPORT_FLUENT reply=%s rows=%s chunks=%s\n' "$reply" "$rows" "$chunks"; fi
––– output –––
BULK_IMPORT_FLUENT_OK
––– input –––
reply=$(printf '%s\n' '{"index":{"_index":"rt_bulk_fluent","_id":"101"}}' '{"title":"replaced fluent row","gid":10}' | curl -sS -X POST 'http://localhost:9308/_bulk/?pipeline=bulk_import' -H 'Content-Type: application/x-ndjson' --data-binary @-); row=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT title,gid FROM rt_bulk_fluent WHERE id=101"); expected=$(printf 'replaced fluent row\t10'); if printf '%s' "$reply" | grep -q '"errors":false' && [ "$row" = "$expected" ]; then echo BULK_IMPORT_FLUENT_REPLACE_OK; else printf 'FAIL_BULK_IMPORT_FLUENT_REPLACE reply=%s row=%s\n' "$reply" "$row"; fi
––– output –––
BULK_IMPORT_FLUENT_REPLACE_OK
––– input –––
before=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM rt_bulk_fluent"); reply=$(printf '%s\n' '{"index":{"_index":"rt_bulk_fluent","_id":"103"}}' '{"title":"must not publish","gid":3}' '{"index":{"_index":"rt_bulk_fluent","_id":"104"}}' '{"title":"bad schema","gid":4,"unknown":1}' | curl -sS -X POST 'http://localhost:9308/_bulk/?pipeline=bulk_import' -H 'Content-Type: application/x-ndjson' --data-binary @-); after=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM rt_bulk_fluent"); rejected=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM rt_bulk_fluent WHERE id IN (103,104)"); if printf '%s' "$reply" | grep -q '"errors":true' && [ "$before" = "$after" ] && [ "$rejected" = 0 ]; then echo BULK_IMPORT_FLUENT_ATOMIC_ERROR_OK; else printf 'FAIL_BULK_IMPORT_FLUENT_ATOMIC_ERROR reply=%s before=%s after=%s rejected=%s\n' "$reply" "$before" "$after" "$rejected"; fi
––– output –––
BULK_IMPORT_FLUENT_ATOMIC_ERROR_OK
