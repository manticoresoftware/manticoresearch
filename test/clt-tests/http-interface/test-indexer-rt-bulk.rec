––– block: ../base/start-searchd –––
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS rt_bulk_http; CREATE TABLE rt_bulk_http (title TEXT, gid INTEGER);"
––– output –––
––– input –––
reply=$(printf '%s\n' '{"insert":{"index":"rt_bulk_http","id":1,"doc":{"title":"first HTTP row","gid":11}}}' | curl -sS -X POST 'http://localhost:9308/bulk?bulk_import=rt_bulk_http' -H 'Content-Type: application/x-ndjson' --data-binary @-); if printf '%s' "$reply" | grep -q '"errors":false'; then echo ASSISTED_HTTP_OK; else echo "FAIL_ASSISTED_HTTP reply=$reply"; fi
––– output –––
ASSISTED_HTTP_OK
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM rt_bulk_http"
––– output –––
1	first HTTP row	11
––– input –––
chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE rt_bulk_http STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$chunks" = 1 ]; then echo ASSISTED_HTTP_PUBLISHED; else echo "FAIL_ASSISTED_HTTP_CHUNKS=$chunks"; fi
––– output –––
ASSISTED_HTTP_PUBLISHED
