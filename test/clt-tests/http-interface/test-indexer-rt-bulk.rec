ASSISTED_HTTP_PUBLISHED
––– input –––
mysql -h0 -P9306 -e "SET GLOBAL auto_optimize=0; DROP TABLE IF EXISTS rt_bulk_spawn_1; DROP TABLE IF EXISTS rt_bulk_spawn_2; DROP TABLE IF EXISTS rt_bulk_spawn_3; DROP TABLE IF EXISTS rt_bulk_spawn_4; DROP TABLE IF EXISTS rt_bulk_spawn_5; DROP TABLE IF EXISTS rt_bulk_spawn_6; DROP TABLE IF EXISTS rt_bulk_spawn_7; DROP TABLE IF EXISTS rt_bulk_spawn_8; CREATE TABLE rt_bulk_spawn_1 (title TEXT); CREATE TABLE rt_bulk_spawn_2 (title TEXT); CREATE TABLE rt_bulk_spawn_3 (title TEXT); CREATE TABLE rt_bulk_spawn_4 (title TEXT); CREATE TABLE rt_bulk_spawn_5 (title TEXT); CREATE TABLE rt_bulk_spawn_6 (title TEXT); CREATE TABLE rt_bulk_spawn_7 (title TEXT); CREATE TABLE rt_bulk_spawn_8 (title TEXT);"; tmpdir=$(mktemp -d); trap 'rm -rf "$tmpdir"' EXIT; failed=0; for wave in $(seq 0 7); do pids=""; for slot in $(seq 1 8); do id=$((wave*8+slot)); table="rt_bulk_spawn_$slot"; ( response="$tmpdir/response-$id"; code=$(printf '{"insert":{"index":"%s","id":%s,"doc":{"title":"row %s"}}}\n' "$table" "$id" "$id" | curl -sS --max-time 60 -o "$response" -w '%{http_code}' -X POST "http://localhost:9308/bulk?bulk_import=$table" -H 'Content-Type: application/x-ndjson' --data-binary @-); printf '%s' "$code" > "$tmpdir/code-$id" ) & pids="$pids $!"; done; for pid in $pids; do wait "$pid" || failed=1; done; done; for id in $(seq 1 64); do [ "$(cat "$tmpdir/code-$id" 2>/dev/null)" = 200 ] || failed=1; grep -q '"errors":false' "$tmpdir/response-$id" 2>/dev/null || failed=1; done; total=0; staging=0; for slot in $(seq 1 8); do count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM rt_bulk_spawn_$slot"); total=$((total+count)); [ ! -e "/var/lib/manticore/rt_bulk_spawn_$slot/rt_bulk_spawn_$slot.indexer-rt-bulk" ] || staging=1; done; alive=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT 1"); rm -rf "$tmpdir"; trap - EXIT; if [ "$failed" = 0 ] && [ "$total" = 64 ] && [ "$staging" = 0 ] && [ "$alive" = 1 ]; then echo ASSISTED_DIFFERENT_TABLE_SPAWN_STRESS_OK; else printf 'FAIL_ASSISTED_DIFFERENT_TABLE_SPAWN failed=%s total=%s staging=%s alive=%s\n' "$failed" "$total" "$staging" "$alive"; fi
––– output –––
ASSISTED_DIFFERENT_TABLE_SPAWN_STRESS_OK
––– input –––
mysql -h0 -P9306 -e "SET GLOBAL auto_optimize=1; DROP TABLE IF EXISTS bulk_import_auto_optimize; CREATE TABLE bulk_import_auto_optimize (title TEXT) optimize_cutoff='2';"; failed=0; for i in $(seq 1 6); do response=$(printf '{"insert":{"index":"bulk_import_auto_optimize","id":%s,"doc":{"title":"row %s"}}}\n' "$i" "$i" | curl -sS --max-time 60 -X POST 'http://localhost:9308/bulk?bulk_import=bulk_import_auto_optimize' -H 'Content-Type: application/x-ndjson' --data-binary @-) || failed=1; printf '%s' "$response" | grep -q '"errors":false' || failed=1; done; i=0; chunks=999; optimizing=1; while [ "$i" -lt 100 ]; do chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE bulk_import_auto_optimize STATUS LIKE 'disk_chunks'" | awk '{print $2}'); optimizing=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE bulk_import_auto_optimize STATUS LIKE 'optimizing'" | awk '{print $2}'); [ "$optimizing" = 0 ] && [ "$chunks" -le 2 ] && break; sleep 0.1; i=$((i+1)); done; stats=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*),MIN(id),MAX(id),SUM(id) FROM bulk_import_auto_optimize"); if [ "$failed" = 0 ] && [ "$optimizing" = 0 ] && [ "$chunks" -le 2 ] && [ "$stats" = "$(printf '6\t1\t6\t21')" ]; then echo BULK_IMPORT_AUTO_OPTIMIZE_OK; else printf 'FAIL_BULK_IMPORT_AUTO_OPTIMIZE failed=%s chunks=%s optimizing=%s stats=%s\n' "$failed" "$chunks" "$optimizing" "$stats"; fi
––– output –––
BULK_IMPORT_AUTO_OPTIMIZE_OK
