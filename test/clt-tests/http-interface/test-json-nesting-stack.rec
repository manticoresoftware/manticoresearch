––– comment –––
Deeply nested HTTP JSON should be parsed or rejected without crashing searchd.
––– comment –––
Use guarded coroutine stacks so any overflow is caught at the guard page.
––– input –––
rm -f /var/log/manticore/searchd.log; stdbuf -oL searchd --stopwait > /dev/null; MANTICORE_GUARDED_STACK=1 stdbuf -oL searchd ${SEARCHD_ARGS:-} > /dev/null
––– output –––
––– input –––
if timeout 10 grep -qm1 'accepting connections' <(tail -n 1000 -f /var/log/manticore/searchd.log); then echo 'Accepting connections!'; else echo 'Timeout or failed!'; fi
––– output –––
Accepting connections!
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS json_nesting_stack; CREATE TABLE json_nesting_stack (a JSON);"
––– output –––
––– input –––
bash <<'BASH'
set -euo pipefail

nested() {
    local depth=$1 open=$2 close=$3 i
    for (( i=0; i<depth; i++ )); do printf '%s' "$open"; done
    printf '1'
    for (( i=0; i<depth; i++ )); do printf '%s' "$close"; done
}

# Alternate nested objects and arrays, keeping the document's first two levels as objects.
nested_mixed() {
    local depth=$1 i
    for (( i=0; i<depth; i++ )); do
        if (( i < 2 || i % 2 == 0 )); then printf '{"a":'; else printf '['; fi
    done
    printf '1'
    for (( i=depth-1; i>=0; i-- )); do
        if (( i < 2 || i % 2 == 0 )); then printf '}'; else printf ']'; fi
    done
}

check_request() {
    local name=$1 endpoint=$2 body=$3 expected=$4 type=application/json
    if (( $# > 4 )); then type=$5; fi
    local reply status response

    if ! reply=$(curl -sS --connect-timeout 3 --max-time 15 -w $'\n%{http_code}' \
        -H "Content-Type: $type" --data-binary "$body" "http://localhost:9308/$endpoint"); then
        echo "$name: HTTP request failed"
        return 1
    fi
    status=${reply##*$'\n'}
    response=${reply%$'\n'*}
    if [[ "$status" != "$expected" ]]; then
        echo "$name: expected HTTP $expected, got $status: ${response:0:160}"
        return 1
    fi
    if [[ "$expected" == 400 ]]; then
        if [[ "$response" != *"unable to parse:"* ]]; then
            echo "$name: expected JSON parsing failure, got ${response:0:160}"
            return 1
        fi
        case "$endpoint" in
            insert|replace|update|delete)
                if [[ "$response" != *'"type":"parse_exception"'* ]]; then
                    echo "$name: expected parse_exception, got ${response:0:160}"
                    return 1
                fi
                ;;
            bulk)
                if [[ "$response" != *'"errors":true'* ]]; then
                    echo "$name: expected bulk errors, got ${response:0:160}"
                    return 1
                fi
                ;;
        esac
    fi
    if [[ "$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' \
        -d 'SELECT COUNT(*) FROM json_nesting_stack' http://localhost:9308/sql)" != 200 ]] ||
        ! mysql -h0 -P9306 -e 'SELECT COUNT(*) FROM json_nesting_stack' > /dev/null; then
        echo "$name: HTTP/MySQL liveness failed"
        return 1
    fi
    echo "$name: HTTP $status, HTTP/MySQL alive"
}

doc750=$(nested 750 '{"a":' '}')
doc999=$(nested 999 '{"a":' '}')
doc1000=$(nested 1000 '{"a":' '}')
doc2000=$(nested 2000 '{"a":' '}')
array2000=$(nested 2000 '[' ']')
doc8000=$(nested 8000 '{"a":' '}')
array8000=$(nested 8000 '[' ']')
mixed999=$(nested_mixed 999)
mixed1000=$(nested_mixed 1000)

# At the allowed maximum depth, grow the JSON body by more than 8x.
printf -v padding '%*s' "$(( 8 * ${#doc999} ))" ''
padding=${padding// /x}
wide999=${doc999/1/\"$padding\"}
if (( ${#wide999} < 8 * ${#doc999} )); then
    echo 'Failed to construct the wide JSON fixture'
    exit 1
fi

check_request insert-750 insert "{\"table\":\"json_nesting_stack\",\"id\":1,\"doc\":$doc750}" 200
check_request replace-750 replace "{\"table\":\"json_nesting_stack\",\"id\":1,\"doc\":$doc750}" 200
check_request insert-999 insert "{\"table\":\"json_nesting_stack\",\"id\":2,\"doc\":$doc999}" 200
check_request insert-1000 insert "{\"table\":\"json_nesting_stack\",\"id\":3,\"doc\":$doc1000}" 400
check_request insert-2000 insert "{\"table\":\"json_nesting_stack\",\"id\":3,\"doc\":$doc2000}" 400
check_request replace-2000 replace "{\"table\":\"json_nesting_stack\",\"id\":1,\"doc\":$doc2000}" 400
check_request update-2000 update "{\"table\":\"json_nesting_stack\",\"id\":1,\"doc\":$doc2000}" 400
check_request delete-2000 delete "{\"table\":\"json_nesting_stack\",\"id\":1,\"doc\":$doc2000}" 400
check_request search-2000 search "{\"table\":\"json_nesting_stack\",\"query\":$doc2000}" 400
check_request bulk-2000 bulk "{\"insert\":{\"table\":\"json_nesting_stack\",\"id\":4,\"doc\":$doc2000}}" 400 application/x-ndjson
check_request array-2000 insert "{\"table\":\"json_nesting_stack\",\"id\":5,\"doc\":{\"a\":$array2000}}" 400
check_request insert-mixed-999 insert "{\"table\":\"json_nesting_stack\",\"id\":6,\"doc\":$mixed999}" 200
check_request replace-mixed-999 replace "{\"table\":\"json_nesting_stack\",\"id\":6,\"doc\":$mixed999}" 200
check_request insert-wide-999 insert "{\"table\":\"json_nesting_stack\",\"id\":7,\"doc\":$wide999}" 200
check_request replace-wide-999 replace "{\"table\":\"json_nesting_stack\",\"id\":7,\"doc\":$wide999}" 200
check_request insert-shallow-wide insert "{\"table\":\"json_nesting_stack\",\"id\":8,\"doc\":{\"a\":{\"payload\":\"$padding\"}}}" 200
check_request insert-mixed-1000 insert "{\"table\":\"json_nesting_stack\",\"id\":9,\"doc\":$mixed1000}" 400
check_request insert-8000 insert "{\"table\":\"json_nesting_stack\",\"id\":10,\"doc\":$doc8000}" 400
check_request search-8000 search "{\"table\":\"json_nesting_stack\",\"query\":$doc8000}" 400
check_request bulk-8000 bulk "{\"insert\":{\"table\":\"json_nesting_stack\",\"id\":11,\"doc\":$doc8000}}" 400 application/x-ndjson
check_request array-8000 insert "{\"table\":\"json_nesting_stack\",\"id\":12,\"doc\":{\"a\":$array8000}}" 400
BASH
