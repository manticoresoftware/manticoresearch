replace-750: HTTP 200, HTTP/MySQL alive
insert-999: HTTP 200, HTTP/MySQL alive
insert-1000: HTTP 400, HTTP/MySQL alive
insert-2000: HTTP 400, HTTP/MySQL alive
replace-2000: HTTP 400, HTTP/MySQL alive
update-2000: HTTP 400, HTTP/MySQL alive
delete-2000: HTTP 400, HTTP/MySQL alive
