––– output –––
––– input –––
cat > /tmp/fluentd-bulk.conf <<'EOF'
<source>
  @type forward
  bind 127.0.0.1
  port 24224
</source>

<match manticore.**>
  @type elasticsearch
  host 127.0.0.1
  port 9308
  scheme http
  index_name fluentd_bulk
  pipeline bulk_import
  write_operation index
  id_key id
  suppress_type_name true
  include_timestamp false
  manage_template false
  <buffer>
    flush_interval 1s
    flush_at_shutdown true
  </buffer>
</match>
EOF
––– output –––
––– input –––
fluentd -c /tmp/fluentd-bulk.conf > /var/log/fluentd-bulk.log 2>&1 & pid=$!; i=0; until grep -q 'worker is now running' /var/log/fluentd-bulk.log || [ "$i" -ge 30 ]; do sleep 1; i=$((i+1)); done; if kill -0 "$pid" 2>/dev/null && grep -q 'worker is now running' /var/log/fluentd-bulk.log; then echo FLUENTD_READY; else cat /var/log/fluentd-bulk.log; fi
