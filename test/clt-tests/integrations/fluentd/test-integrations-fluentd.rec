printf '%s\n' '{"id":"401","title":"first Fluentd bulk row","gid":41}' '{"id":"402","title":"second Fluentd bulk row","gid":42}' | fluent-cat manticore.test; i=0; count=0; until [ "$count" = 2 ] || [ "$i" -ge 30 ]; do sleep 1; count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM fluentd_bulk" 2>/dev/null || echo 0); i=$((i+1)); done; kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,title,gid FROM fluentd_bulk" | sort -n); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE fluentd_bulk STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$rows" = "$(printf '401\tfirst Fluentd bulk row\t41\n402\tsecond Fluentd bulk row\t42')" ] && [ "$chunks" = 1 ]; then echo FLUENTD_BULK_IMPORT_OK; else printf 'FAIL_FLUENTD_BULK_IMPORT rows=%s chunks=%s\n' "$rows" "$chunks"; cat /var/log/fluentd-bulk.log; fi
