mysql -h0 -P9306 -e "DROP TABLE IF EXISTS logstash_bulk; CREATE TABLE logstash_bulk (message TEXT);"
––– output –––
––– input –––
cat > logstash-bulk.conf <<'EOF'
input { stdin { codec => json_lines } }
filter {
  mutate {
    add_field => { "[@metadata][bulk_id]" => "%{id}" }
    remove_field => ["id", "@timestamp", "@version", "host", "event", "tags"]
  }
}
output {
  elasticsearch {
    hosts => ["http://localhost:9308"]
    index => "logstash_bulk"
    pipeline => "bulk_import"
    action => "index"
    document_id => "%{[@metadata][bulk_id]}"
    ilm_enabled => false
    manage_template => false
  }
}
EOF
––– output –––
––– input –––
printf '%s\n' '{"id":"101","message":"first Logstash bulk row"}' '{"id":"102","message":"second Logstash bulk row"}' > /tmp/logstash-bulk-input.ndjson; logstash -w 1 -f logstash-bulk.conf < /tmp/logstash-bulk-input.ndjson > /var/log/logstash-bulk.log 2>&1 & pid=$!; i=0; count=0; until [ "$count" = 2 ] || [ "$i" -ge 180 ]; do sleep 1; count=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT COUNT(*) FROM logstash_bulk" 2>/dev/null || echo 0); i=$((i+1)); done; kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; if [ "$count" = 2 ]; then echo LOGSTASH_BULK_PROCESSED; else cat /var/log/logstash-bulk.log; fi
––– output –––
LOGSTASH_BULK_PROCESSED
––– input –––
rows=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,message FROM logstash_bulk" | sort -n); chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE logstash_bulk STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$rows" = "$(printf '101\tfirst Logstash bulk row\n102\tsecond Logstash bulk row')" ] && [ "$chunks" = 1 ]; then echo LOGSTASH_BULK_IMPORT_OK; else printf 'FAIL_LOGSTASH_BULK_IMPORT rows=%s chunks=%s\n' "$rows" "$chunks"; fi
