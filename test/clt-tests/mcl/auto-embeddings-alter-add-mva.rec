Issue #4872: preserve values in ALTER-added MVA columns on tables with auto-embeddings

––– block: ../base/start-searchd –––
––– block: ./base –––
––– input –––
php /manticore/test/clt-tests/mcl/mock-embeddings-server.php --port 18080 --provider openai >/tmp/issue-4872-mock.log 2>&1 & MOCK_PID=$!; sleep 1; kill -0 "$MOCK_PID"; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE t (prefix text, title text, m multi, u int, vec float_vector KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='openai/text-embedding-ada-002' FROM='title' API_KEY='test-key' API_URL='http://127.0.0.1:18080/v1/embeddings')" 2>&1; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "INSERT INTO t (id, prefix, title, m, u) VALUES (1,'p1','one',(11,12),5),(2,'p2','two',(21,22),6); FLUSH RAMCHUNK t" 2>&1; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "ALTER TABLE t ADD COLUMN m2 multi; ALTER TABLE t ADD COLUMN u2 int" 2>&1; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "REPLACE INTO t (id, prefix, title, m, u, m2, u2) VALUES (1,'p1r','one replaced',(11,12),5,(41,42),8); INSERT INTO t (id, prefix, title, m, u, m2, u2) VALUES (3,'p3','three',(31,32),7,(61,62),10)" 2>&1; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "SELECT id, m, u, m2, u2 FROM t ORDER BY id ASC"
––– output –––
+------+-------+------+-------+------+
| id   | m     | u    | m2    | u2   |
+------+-------+------+-------+------+
|    1 | 11,12 |    5 | 41,42 |    8 |
|    2 | 21,22 |    6 |       |    0 |
|    3 | 31,32 |    7 | 61,62 |   10 |
+------+-------+------+-------+------+
––– input –––
mysql -h0 -P9306 -N -B -e "SELECT id FROM t WHERE knn(vec, 1, 'three') LIMIT 1" | grep -v '^+' | tr -d '| '
––– output –––
3
––– comment –––
Shift attribute and field IDs before inserting another document.
––– input –––
mysql -h0 -P9306 -e "ALTER TABLE t DROP COLUMN u; ALTER TABLE t DROP COLUMN prefix; INSERT INTO t (id, title, m, m2, u2) VALUES (4,'four',(81,82),(91,92),12)" 2>&1; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "SELECT id, m, m2, u2 FROM t WHERE id=4"
