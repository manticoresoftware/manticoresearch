––– comment –––
HIGHLIGHT({knn_chunk=1},'field') returns the chunk of the stored text whose vector matched the KNN query. The chunk survives RAM/disk/optimize/restart.
––– block: ../base/start-searchd-with-buddy –––
––– comment –––
Create an auto-chunked table and insert multilingual source text.
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS chunk_hl; CREATE TABLE chunk_hl (body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8' OVERLAP_TOKENS='2'); INSERT INTO chunk_hl(id,body) VALUES(1,'Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.')" && echo MAIN_SETUP_OK
––– output –––
MAIN_SETUP_OK
––– comment –––
A semantic-only KNN query returns the matching chunk verbatim; a full-text query highlights inside that chunk only.
––– input –––
TEXT='Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.'; CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM chunk_hl WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1") || exit 1; printf '%s\n' "$CHUNK" > /tmp/chunk-hl-expected; python3 test/clt-tests/mcl/check-chunk-provenance.py chunk "$TEXT" "$CHUNK" || exit 1; TAGGED=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM chunk_hl WHERE MATCH('target phrase') AND KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py chunk "$TEXT" "$TAGGED" tagged
––– output –––
CHUNK_OK
CHUNK_OK
––– comment –––
JSON exposes the same opt-in behavior, including hybrid search where literal matches keep their tags inside the chunk.
––– input –––
TEXT='Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.'; curl -sS -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d '{"index":"chunk_hl","knn":{"field":"chunks","query":"target phrase","k":1},"highlight":{"knn_chunk":true,"fields":["body"]},"limit":1}' > /tmp/chunk-json-highlight.json || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py json-highlight "$TEXT" < /tmp/chunk-json-highlight.json || exit 1; curl -sS -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d '{"index":"chunk_hl","_source":{"excludes":["*"]},"knn":{"field":"chunks","query":"target phrase","k":1},"query":{"match":{"body":"target phrase"}},"options":{"fusion_method":"rrf"},"highlight":{"knn_chunk":true,"fields":["body"]},"limit":1}' > /tmp/chunk-json-hybrid-highlight.json || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py json-highlight "$TEXT" tagged < /tmp/chunk-json-hybrid-highlight.json
––– output –––
CHUNK_JSON_HIGHLIGHT_OK
CHUNK_JSON_HIGHLIGHT_OK
––– comment –––
The opt-in requires the single explicit full-text embedding source field in the quoted stored-field-list form, and SNIPPET never accepts it.
––– input –––
ERR=$(mysql -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'wrong') FROM chunk_hl WHERE KNN(chunks,1,'target phrase')" 2>&1) && exit 1; case "$ERR" in *'KNN chunk highlighting requires exactly one explicit full-text field'*) ;; *) exit 1;; esac; ERR=$(mysql -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},body) FROM chunk_hl WHERE KNN(chunks,1,'target phrase')" 2>&1) && exit 1; case "$ERR" in *'KNN chunk highlighting requires a quoted explicit stored-field list'*) ;; *) exit 1;; esac; ERR=$(mysql -h0 -P9306 -e "SELECT SNIPPET(body,'target phrase','knn_chunk=1') FROM chunk_hl" 2>&1) && exit 1; case "$ERR" in *'Unknown option: knn_chunk'*) ;; *) exit 1;; esac; echo CHUNK_HIGHLIGHT_VALIDATION_OK
––– output –––
CHUNK_HIGHLIGHT_VALIDATION_OK
––– comment –––
Without a KNN clause the option is a no-op: ordinary whole-field highlighting.
––– input –––
TEXT='Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.'; OUT=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body','target phrase') FROM chunk_hl") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py whole "$TEXT" "$OUT"
––– output –––
WHOLE_FIELD_OK
––– comment –––
Ambiguous all/multiple sources and string-attribute sources remain searchable but reject the opt-in.
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE highlight_all_source (body TEXT, source_attr STRING, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO highlight_all_source(id,body,source_attr) VALUES(1,'target phrase','other'); CREATE TABLE highlight_multi_source (body1 TEXT, body2 TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body1,body2' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO highlight_multi_source(id,body1,body2) VALUES(1,'target phrase','other'); CREATE TABLE highlight_attr_source (body TEXT STORED, source_attr STRING, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='source_attr' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO highlight_attr_source(id,body,source_attr) VALUES(1,'stored body','target phrase')" && ok=1; for table in highlight_all_source highlight_multi_source highlight_attr_source; do test "$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id FROM $table WHERE KNN(chunks,1,'target phrase')")" = 1 || ok=0; done; test "$ok" -eq 1 && ( ERR=$(mysql -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM highlight_all_source WHERE KNN(chunks,1,'target phrase')" 2>&1); test $? -ne 0; case "$ERR" in *'one explicit full-text FROM field'*) true;; *) false;; esac ) && ( ERR=$(mysql -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body1') FROM highlight_multi_source WHERE KNN(chunks,1,'target phrase')" 2>&1); test $? -ne 0; case "$ERR" in *'one explicit full-text FROM field'*) true;; *) false;; esac ) && ( ERR=$(mysql -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM highlight_attr_source WHERE KNN(chunks,1,'target phrase')" 2>&1); test $? -ne 0; case "$ERR" in *'KNN chunk highlighting does not support string-attribute FROM sources'*) true;; *) false;; esac ) && echo CHUNK_HIGHLIGHT_SOURCE_VALIDATION_OK
––– output –––
CHUNK_HIGHLIGHT_SOURCE_VALIDATION_OK
––– comment –––
Multiple KNN clauses remain searchable without highlighting but reject chunk highlighting rather than mixing chunks.
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE highlight_two_vectors (body1 TEXT STORED, body2 TEXT STORED, v1 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body1' CHUNK_STRATEGY='fixed' MAX_TOKENS='8', v2 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body2' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO highlight_two_vectors(id,body1,body2) VALUES(1,'first source target phrase','second source target phrase')" || exit 1; REQUEST='{"index":"highlight_two_vectors","knn":[{"field":"v1","query":"first source","k":1},{"field":"v2","query":"second source","k":1}],"options":{"fusion_method":"rrf"},"limit":1}'; curl -sS -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d "$REQUEST" > /tmp/chunk-json-success.json || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py json-success 1 < /tmp/chunk-json-success.json || exit 1; REQUEST='{"index":"highlight_two_vectors","knn":[{"field":"v1","query":"first source","k":1},{"field":"v2","query":"second source","k":1}],"options":{"fusion_method":"rrf"},"highlight":{"knn_chunk":true,"fields":["body1"]},"limit":1}'; curl -sS -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d "$REQUEST" > /tmp/chunk-json-multi-error.json || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py json-error 'KNN chunk highlighting does not support multiple KNN clauses' < /tmp/chunk-json-multi-error.json || exit 1; REQUEST='{"index":"highlight_two_vectors","knn":[{"field":"v1","query":"first source","k":1},{"field":"v2","query":"second source","k":1}],"options":{"fusion_method":"rrf"},"highlight":{"knn_chunk":false,"before_match":"knn_chunk","fields":["body1"]},"limit":1}'; curl -sS -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d "$REQUEST" > /tmp/chunk-json-quoted.json || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py json-success 1 < /tmp/chunk-json-quoted.json
––– output –––
JSON_SUCCESS_OK
JSON_ERROR_OK
JSON_SUCCESS_OK
––– comment –––
With html_strip the chunk is taken from the stripped text, the same text the embeddings were generated from.
––– input –––
TEXT='<p class="intro">alpha beta gamma delta epsilon zeta eta theta</p><p>iota kappa lambda <b>stripped</b> target phrase here</p>'; mysql -h0 -P9306 -e "DROP TABLE IF EXISTS strip_hl; CREATE TABLE strip_hl (body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8') html_strip='1'; INSERT INTO strip_hl(id,body) VALUES(1,'$TEXT')" || exit 1; CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM strip_hl WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py chunk ' alpha beta gamma delta epsilon zeta eta theta iota kappa lambda stripped target phrase here ' "$CHUNK" || exit 1; case "$CHUNK" in *'<'*) exit 1;; esac; ERR=$(mysql -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1,html_strip_mode='none'},'body') FROM strip_hl WHERE KNN(chunks,1,'target phrase')" 2>&1) && exit 1; case "$ERR" in *'KNN chunk highlighting requires html_strip_mode=index'*) ;; *) exit 1;; esac; echo CHUNK_HTML_STRIP_OK
––– output –––
CHUNK_HTML_STRIP_OK
––– comment –––
A two-row group selects a representative and highlights that row's own chunk.
––– input –––
TEXT='alpha beta gamma delta epsilon zeta eta theta target phrase first tail'; mysql -h0 -P9306 -e "DROP TABLE IF EXISTS grouped_hl; CREATE TABLE grouped_hl (body TEXT, gid INT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO grouped_hl(id,body,gid) VALUES(10,'alpha beta gamma delta epsilon zeta eta theta target phrase first tail',7),(20,'one two three four five six seven eight nine ten target phrase second tail',7)" || exit 1; mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id,COUNT(*),HIGHLIGHT({knn_chunk=1},'body') FROM grouped_hl WHERE KNN(chunks,2,'target phrase',{rescore=1}) GROUP BY gid WITHIN GROUP ORDER BY id ASC LIMIT 1" > /tmp/grouped-hl.tsv || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py grouped-highlight 10 "$TEXT" < /tmp/grouped-hl.tsv
––– output –––
GROUPED_CHUNK_HIGHLIGHT_OK
––– comment –––
Flush the RAM chunk and require exactly the same chunk.
––– input –––
mysql -h0 -P9306 -e 'FLUSH RAMCHUNK chunk_hl' && CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM chunk_hl WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py same "$(cat /tmp/chunk-hl-expected)" "$CHUNK"
––– output –––
CHUNK_SAME_OK
––– comment –––
Create a second disk chunk, merge both chunks, and require the same chunk.
––– input –––
mysql -h0 -P9306 -e "INSERT INTO chunk_hl(id,body) VALUES(2,'unrelated text for a second disk chunk'); FLUSH RAMCHUNK chunk_hl; OPTIMIZE TABLE chunk_hl OPTION sync=1,cutoff=1" && CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM chunk_hl WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py same "$(cat /tmp/chunk-hl-expected)" "$CHUNK"
––– output –––
CHUNK_SAME_OK
––– comment –––
Fullscan must select the same chunk as ANN plus exact rescore.
––– input –––
CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM chunk_hl WHERE KNN(chunks,1,'target phrase',{fullscan=1,rescore=0}) LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py same "$(cat /tmp/chunk-hl-expected)" "$CHUNK"
––– output –––
CHUNK_SAME_OK
––– comment –––
Manually supplied vector arrays and scalar truncate/mean embeddings have no chunk to point at: whole-field highlighting.
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE manual_hl (body TEXT, v FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' KNN_DIMS='2' HNSW_SIMILARITY='l2'); INSERT INTO manual_hl(id,body,v) VALUES(1,'manual target phrase text',[[1,0],[0,1]]); CREATE TABLE scalar_truncate_hl (body TEXT, v FLOAT_VECTOR KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body'); INSERT INTO scalar_truncate_hl(id,body) VALUES(1,'alpha target phrase omega'); CREATE TABLE scalar_mean_hl (body TEXT, v FLOAT_VECTOR KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='mean' MAX_TOKENS='8'); INSERT INTO scalar_mean_hl(id,body) VALUES(1,'alpha beta gamma delta epsilon zeta eta theta target phrase omega')" || exit 1; OUT=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body','target phrase') FROM manual_hl WHERE KNN(v,1,(1,0))") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py whole 'manual target phrase text' "$OUT" || exit 1; OUT=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body','target phrase') FROM scalar_truncate_hl WHERE KNN(v,1,'target phrase')") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py whole 'alpha target phrase omega' "$OUT" || exit 1; OUT=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body','target phrase') FROM scalar_mean_hl WHERE KNN(v,1,'target phrase')") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py whole 'alpha beta gamma delta epsilon zeta eta theta target phrase omega' "$OUT"
––– output –––
WHOLE_FIELD_OK
WHOLE_FIELD_OK
WHOLE_FIELD_OK
––– comment –––
Dropping one auto-chunked vector keeps chunk highlighting working for the other one.
––– input –––
TEXT='alpha beta gamma delta epsilon zeta eta theta iota kappa lambda target phrase after drop'; mysql -h0 -P9306 -e "CREATE TABLE drop_hl (body1 TEXT, body2 TEXT, v1 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body1' CHUNK_STRATEGY='fixed' MAX_TOKENS='8', v2 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body2' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO drop_hl(id,body1,body2) VALUES(1,'first source text','second source target phrase'); ALTER TABLE drop_hl DROP COLUMN v1; INSERT INTO drop_hl(id,body1,body2) VALUES(2,'unused','alpha beta gamma delta epsilon zeta eta theta iota kappa lambda target phrase after drop')" || exit 1; CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body2') FROM drop_hl WHERE KNN(v2,1,'target phrase after drop') LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py chunk "$TEXT" "$CHUNK"
––– output –––
CHUNK_OK
––– comment –––
Restart the daemon and require the persisted chunk to remain unchanged.
––– input –––
searchd --stopwait > /dev/null; rm -f /var/log/manticore/searchd.log; stdbuf -oL searchd $SEARCHD_FLAGS > /dev/null; for i in $(seq 1 150); do mysql -h0 -P9306 -e 'select 1' >/dev/null 2>&1 && { echo 'Manticore restarted!'; break; }; sleep .2; done
––– output –––
Manticore restarted!
––– input –––
CHUNK=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM chunk_hl WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1") || exit 1; python3 test/clt-tests/mcl/check-chunk-provenance.py same "$(cat /tmp/chunk-hl-expected)" "$CHUNK"
––– output –––
CHUNK_SAME_OK
