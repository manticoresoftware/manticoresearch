––– input –––
python3 - <<'PY'
import json
import re
import subprocess
import urllib.request

mysql = ['mysql','-N','-B','-h0','-P9306']
def sql(q):
    return subprocess.check_output(mysql+['-e',q], text=True, stderr=subprocess.STDOUT).strip()
def values():
    out = sql("SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM legacy_provenance WHERE KNN(chunks,10,'target phrase',{rescore=1}) ORDER BY id")
    rows = [tuple(map(int,re.findall(r'-?\d+',line))) for line in out.splitlines()]
    rows = [row for row in rows if len(row) == 4]
    assert rows and all(row[1:] == (-1,-1,-1) for row in rows), rows
    return rows

sql("INSERT INTO legacy_provenance(id,body) VALUES(1,'legacy alpha target phrase omega')")
assert values() == [(1,-1,-1,-1)]
sql('FLUSH RAMCHUNK legacy_provenance')
probe = subprocess.run(mysql+['-e','ALTER TABLE legacy_provenance DROP COLUMN knn_chunk_spans_v1_chunks'], text=True, capture_output=True)
assert probe.returncode and 'does not exist' in probe.stderr, probe.stderr
print('LEGACY_BEFORE_RESTART_OK')
PY
