––– input –––
python3 - <<'PY'
import json
import re
import subprocess
import urllib.request

mysql = ['mysql','-N','-B','-h0','-P9306']
def sql(q):
    return subprocess.check_output(mysql+['-e',q], text=True, stderr=subprocess.STDOUT).strip()

sql("INSERT INTO legacy_provenance(id,body) VALUES(2,'new row target phrase after upgrade')")
sql('FLUSH RAMCHUNK legacy_provenance')
sql('OPTIMIZE TABLE legacy_provenance OPTION sync=1,cutoff=1')
out = sql("SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM legacy_provenance WHERE KNN(chunks,10,'target phrase',{rescore=1}) ORDER BY id")
rows = [tuple(map(int,re.findall(r'-?\d+',line))) for line in out.splitlines()]
rows = [row for row in rows if len(row) == 4]
assert rows == [(1,-1,-1,-1),(2,-1,-1,-1)], rows
request = urllib.request.Request('http://127.0.0.1:9308/search', data=json.dumps({'index':'legacy_provenance','knn':{'field':'chunks','query':'target phrase','k':2},'limit':2}).encode(), headers={'Content-Type':'application/json'})
hits = json.load(urllib.request.urlopen(request))['hits']['hits']
assert len(hits) == 2 and all(hit['_knn_chunk'] == {'index':-1,'start':-1,'end':-1} for hit in hits), hits
print('LEGACY_AFTER_RESTART_OK')
PY
––– output –––
LEGACY_AFTER_RESTART_OK
––– input –––
searchd --stopwait --config /tmp/chunk-provenance-legacy/manticore.conf >/dev/null; echo LEGACY_STOPPED
