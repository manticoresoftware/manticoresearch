from pathlib import Path
Path('/tmp/chunk-provenance-legacy/manticore.conf').write_text(r'''index legacy_provenance {
  type = rt
  path = /tmp/chunk-provenance-legacy/table/legacy_provenance
  rt_field = body
  rt_attr_float_vector_array = chunks
  knn = {"attrs":[{"name":"chunks","type":"hnsw","hnsw_similarity":"cosine","model_name":"sentence-transformers/all-MiniLM-L6-v2","from":"body","chunk_strategy":"fixed","max_tokens":8,"overlap_tokens":2}]}
}
searchd {
  listen = 9306:mysql41
  listen = 9308:http
  log = /tmp/chunk-provenance-legacy/searchd.log
  query_log = /tmp/chunk-provenance-legacy/query.log
  pid_file = /tmp/chunk-provenance-legacy/searchd.pid
  binlog_path = /tmp/chunk-provenance-legacy/binlog
}
''')
PY
stdbuf -oL searchd --config /tmp/chunk-provenance-legacy/manticore.conf >/dev/null; for i in $(seq 1 150); do mysql -h0 -P9306 -e 'select 1' >/dev/null 2>&1 && { echo LEGACY_STARTED; break; }; sleep .2; done
