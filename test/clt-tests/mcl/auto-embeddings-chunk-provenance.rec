––– comment –––
Chunk provenance is aligned with UTF-8 source bytes and survives RAM/disk/optimize.
––– block: ../base/start-searchd-with-buddy –––
––– input –––
python3 - <<'PY'
import subprocess
import re
import json
import urllib.request

mysql = ['mysql','-N','-B','-h0','-P9306']
def sql(q):
    return subprocess.check_output(mysql+['-e',q], text=True).strip()

def ints(q):
    return tuple(map(int, re.findall(r'-?\d+', sql(q))))

sql("DROP TABLE IF EXISTS chunk_provenance")
sql("CREATE TABLE chunk_provenance (body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8' OVERLAP_TOKENS='2')")
text = 'Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.'
escaped = text.replace("'", "''")
sql(f"INSERT INTO chunk_provenance(id,body) VALUES(1,'{escaped}')")
query = "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1"

def check(label):
    vals = ints(query)
    slot,start,end = vals
    raw = text.encode('utf-8')
    assert slot >= 0 and 0 <= start < end <= len(raw), (label, vals, len(raw))
    chunk = raw[start:end].decode('utf-8')
    assert 'target phrase' in chunk, (label, vals, chunk)
    return vals

ram = check('ram')
sql('FLUSH RAMCHUNK chunk_provenance')
disk = check('disk')
sql("INSERT INTO chunk_provenance(id,body) VALUES(2,'unrelated text for a second disk chunk')")
sql('FLUSH RAMCHUNK chunk_provenance')
sql('OPTIMIZE TABLE chunk_provenance OPTION sync=1,cutoff=1')
optimized = check('optimized')
assert ram == disk == optimized, (ram,disk,optimized)

fullscan = ints("SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{fullscan=1,rescore=0}) LIMIT 1")
assert fullscan == optimized, (fullscan, optimized)

request = urllib.request.Request('http://127.0.0.1:9308/search', data=json.dumps({
    'index': 'chunk_provenance',
    'knn': {'field': 'chunks', 'query': 'target phrase', 'k': 1},
    'limit': 1,
}).encode(), headers={'Content-Type': 'application/json'})
hit = json.load(urllib.request.urlopen(request))['hits']['hits'][0]
assert tuple(hit['_knn_chunk'][key] for key in ('index','start','end')) == optimized, hit

hybrid_request = urllib.request.Request('http://127.0.0.1:9308/search', data=json.dumps({
    'index': 'chunk_provenance',
    'knn': {'field': 'chunks', 'query': 'target phrase', 'k': 1},
    'query': {'match': {'body': 'target phrase'}},
    'options': {'fusion_method': 'rrf'},
    'limit': 1,
}).encode(), headers={'Content-Type': 'application/json'})
hybrid_hit = json.load(urllib.request.urlopen(hybrid_request))['hits']['hits'][0]
hybrid_chunk = tuple(hybrid_hit['_knn_chunk'][key] for key in ('index','start','end'))
assert hybrid_chunk[0] >= 0 and 0 <= hybrid_chunk[1] < hybrid_chunk[2] <= len(text.encode()), hybrid_hit

sql("CREATE TABLE manual_provenance (v FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' KNN_DIMS='2' HNSW_SIMILARITY='l2')")
sql("INSERT INTO manual_provenance(id,v) VALUES(1,[[1,0],[0,1]])")
unavailable = ints("SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM manual_provenance WHERE KNN(v,1,(1,0))")
assert unavailable == (-1,-1,-1), unavailable

# Scalar truncate/mean deliberately have no per-chunk spans, but their
# pre-existing auto-embedding insert/search behavior must remain intact.
sql("CREATE TABLE scalar_truncate_provenance (body TEXT, v FLOAT_VECTOR KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body')")
sql("INSERT INTO scalar_truncate_provenance(id,body) VALUES(1,'alpha target phrase omega')")
assert ints("SELECT id FROM scalar_truncate_provenance WHERE KNN(v,1,'target phrase') LIMIT 1") == (1,)
assert ints("SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM scalar_truncate_provenance WHERE KNN(v,1,'target phrase') LIMIT 1") == (-1,-1,-1)
sql("CREATE TABLE scalar_mean_provenance (body TEXT, v FLOAT_VECTOR KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='mean' MAX_TOKENS='8')")
sql("INSERT INTO scalar_mean_provenance(id,body) VALUES(1,'alpha beta gamma delta epsilon zeta eta theta target phrase omega')")
assert ints("SELECT id FROM scalar_mean_provenance WHERE KNN(v,1,'target phrase') LIMIT 1") == (1,)
assert ints("SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM scalar_mean_provenance WHERE KNN(v,1,'target phrase') LIMIT 1") == (-1,-1,-1)

# Dropping an auto-chunked vector must also remove its internal span sidecar.
sql("CREATE TABLE drop_provenance (body1 TEXT, body2 TEXT, v1 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body1' CHUNK_STRATEGY='fixed' MAX_TOKENS='8', v2 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body2' CHUNK_STRATEGY='fixed' MAX_TOKENS='8')")
sql("INSERT INTO drop_provenance(id,body1,body2) VALUES(1,'first source text','second source target phrase')")
sql("ALTER TABLE drop_provenance DROP COLUMN v1")
sql("INSERT INTO drop_provenance(id,body1,body2) VALUES(2,'unused','another target phrase')")
drop_vals = ints("SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM drop_provenance WHERE KNN(v2,1,'target phrase') LIMIT 1")
assert drop_vals[0] >= 0 and 0 <= drop_vals[1] < drop_vals[2], drop_vals
probe = subprocess.run(mysql+['-e','ALTER TABLE drop_provenance DROP COLUMN knn_chunk_spans_v1_v1'], text=True, capture_output=True)
assert probe.returncode != 0 and 'does not exist' in probe.stderr, probe.stderr
print('CHUNK_PROVENANCE_OK')
PY
