––– comment –––
Chunk provenance is aligned with UTF-8 source bytes and survives RAM/disk/optimize.
––– block: ../base/start-searchd-with-buddy –––
––– comment –––
Create an auto-chunked table and insert multilingual source text.
––– input –––
mysql -h0 -P9306 -e "DROP TABLE IF EXISTS chunk_provenance; CREATE TABLE chunk_provenance (body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8' OVERLAP_TOKENS='2'); INSERT INTO chunk_provenance(id,body) VALUES(1,'Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.')"; echo MAIN_SETUP_OK
––– output –––
MAIN_SETUP_OK
––– comment –––
Validate that the RAM result points to a valid UTF-8 byte range containing the query phrase.
––– input –––
TEXT='Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.'; ROW=$(mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1" | awk -F'|' '/^\|/ { printf "%d %d %d\n", $2, $3, $4 }'); printf '%s\n' "$ROW" > /tmp/chunk-provenance-expected; python3 test/clt-tests/mcl/check-chunk-provenance.py range "$TEXT" "$ROW"
––– output –––
CHUNK_RANGE_OK
––– comment –––
Flush the RAM chunk and require exactly the same provenance tuple.
––– input –––
mysql -h0 -P9306 -e 'FLUSH RAMCHUNK chunk_provenance'; ROW=$(mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1" | awk -F'|' '/^\|/ { printf "%d %d %d\n", $2, $3, $4 }'); test "$ROW" = "$(cat /tmp/chunk-provenance-expected)"; echo CHUNK_DISK_OK
––– output –––
CHUNK_DISK_OK
––– comment –––
Create a second disk chunk, merge both chunks, and require unchanged provenance.
––– input –––
mysql -h0 -P9306 -e "INSERT INTO chunk_provenance(id,body) VALUES(2,'unrelated text for a second disk chunk'); FLUSH RAMCHUNK chunk_provenance; OPTIMIZE TABLE chunk_provenance OPTION sync=1,cutoff=1"; ROW=$(mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1" | awk -F'|' '/^\|/ { printf "%d %d %d\n", $2, $3, $4 }'); test "$ROW" = "$(cat /tmp/chunk-provenance-expected)"; echo CHUNK_OPTIMIZE_OK
––– output –––
CHUNK_OPTIMIZE_OK
––– comment –––
Fullscan must select the same row-local vector slot as ANN plus exact rescore.
––– input –––
ROW=$(mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{fullscan=1,rescore=0}) LIMIT 1" | awk -F'|' '/^\|/ { printf "%d %d %d\n", $2, $3, $4 }'); test "$ROW" = "$(cat /tmp/chunk-provenance-expected)"; echo CHUNK_FULLSCAN_OK
––– output –––
CHUNK_FULLSCAN_OK
––– comment –––
HTTP KNN must expose the same tuple in _knn_chunk.
––– input –––
curl -s -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d '{"index":"chunk_provenance","knn":{"field":"chunks","query":"target phrase","k":1},"limit":1}' | python3 test/clt-tests/mcl/check-chunk-provenance.py http "$(cat /tmp/chunk-provenance-expected)"
––– output –––
CHUNK_HTTP_OK
––– comment –––
Hybrid RRF search must preserve a valid KNN chunk tuple.
––– input –––
TEXT='Привет мир. alpha beta gamma delta epsilon zeta eta theta. 你好世界。 omega target phrase.'; curl -s -X POST http://127.0.0.1:9308/search -H 'Content-Type: application/json' -d '{"index":"chunk_provenance","knn":{"field":"chunks","query":"target phrase","k":1},"query":{"match":{"body":"target phrase"}},"options":{"fusion_method":"rrf"},"limit":1}' | python3 test/clt-tests/mcl/check-chunk-provenance.py hybrid "$TEXT"
––– output –––
CHUNK_HYBRID_OK
––– comment –––
Manual vector arrays have no source provenance.
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE manual_provenance (v FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' KNN_DIMS='2' HNSW_SIMILARITY='l2'); INSERT INTO manual_provenance(id,v) VALUES(1,[[1,0],[0,1]])"; mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM manual_provenance WHERE KNN(v,1,(1,0))" | awk -F'|' '/^\|/ { printf "%d %d %d\n", $2, $3, $4 }'
––– output –––
-1 -1 -1
––– comment –––
Scalar truncate and mean embeddings remain searchable but have no single truthful source span.
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE scalar_truncate_provenance (body TEXT, v FLOAT_VECTOR KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body'); INSERT INTO scalar_truncate_provenance(id,body) VALUES(1,'alpha target phrase omega'); CREATE TABLE scalar_mean_provenance (body TEXT, v FLOAT_VECTOR KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='mean' MAX_TOKENS='8'); INSERT INTO scalar_mean_provenance(id,body) VALUES(1,'alpha beta gamma delta epsilon zeta eta theta target phrase omega')"; mysql -N -B -h0 -P9306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM scalar_truncate_provenance WHERE KNN(v,1,'target phrase') LIMIT 1; SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM scalar_mean_provenance WHERE KNN(v,1,'target phrase') LIMIT 1" | awk -F'|' '/^\|/ { printf "%d %d %d %d\n", $2, $3, $4, $5 }'
––– output –––
1 -1 -1 -1
1 -1 -1 -1
––– comment –––
Dropping an auto-chunked vector also removes its hidden span sidecar without affecting another vector.
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE drop_provenance (body1 TEXT, body2 TEXT, v1 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body1' CHUNK_STRATEGY='fixed' MAX_TOKENS='8', v2 FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body2' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO drop_provenance(id,body1,body2) VALUES(1,'first source text','second source target phrase'); ALTER TABLE drop_provenance DROP COLUMN v1; INSERT INTO drop_provenance(id,body1,body2) VALUES(2,'unused','another target phrase')"; mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM drop_provenance WHERE KNN(v2,1,'target phrase') LIMIT 1" | awk -F'|' '/^\|/ { ok=($2>=0 && $3>=0 && $3<$4) } END { if (ok) print "DROP_SURVIVING_VECTOR_OK"; else exit 1 }'; ERR=$(mysql -h0 -P9306 -e 'ALTER TABLE drop_provenance DROP COLUMN knn_chunk_spans_v1_v1' 2>&1) && exit 1 || true; printf '%s\n' "$ERR" | grep -q 'does not exist'; echo DROP_SIDECAR_OK
––– output –––
DROP_SURVIVING_VECTOR_OK
DROP_SIDECAR_OK
––– comment –––
Restart the daemon and require the persisted tuple to remain unchanged.
––– input –––
searchd --stopwait > /dev/null; rm -f /var/log/manticore/searchd.log; stdbuf -oL searchd $SEARCHD_FLAGS > /dev/null; for i in $(seq 1 150); do mysql -h0 -P9306 -e 'select 1' >/dev/null 2>&1 && { echo 'Manticore restarted!'; break; }; sleep .2; done
––– output –––
Manticore restarted!
––– input –––
ROW=$(mysql -N -B -h0 -P9306 -e "SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1" | awk -F'|' '/^\|/ { printf "%d %d %d\n", $2, $3, $4 }'); test "$ROW" = "$(cat /tmp/chunk-provenance-expected)"; echo CHUNK_PROVENANCE_RESTART_OK
––– output –––
CHUNK_PROVENANCE_RESTART_OK
