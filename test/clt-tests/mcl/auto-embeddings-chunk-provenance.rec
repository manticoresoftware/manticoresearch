python3 - <<'PY'
import re
import subprocess

mysql = ['mysql','-N','-B','-h0','-P9306']
out = subprocess.check_output(mysql+['-e',"SELECT knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM chunk_provenance WHERE KNN(chunks,1,'target phrase',{rescore=1}) LIMIT 1"], text=True)
vals = tuple(map(int, re.findall(r'-?\d+', out)))
assert vals[0] >= 0 and 0 <= vals[1] < vals[2], vals
print('CHUNK_PROVENANCE_RESTART_OK')
