––– input –––
cosine_similarity() {
    local file1="$1" file2="$2"

    awk '
    NR==FNR { a[NR]=$1; suma2+=$1*$1; next }
    {
        dot += a[FNR]*$1
        sumb2 += $1*$1
    }
    END {
        print dot / (sqrt(suma2) * sqrt(sumb2))
    }' "$file1" "$file2"
}

retry_remote_embedding_create_table() {
    local sql="$1"
    local attempts=5
    local delay=1
    local attempt output rc

    for attempt in $(seq 1 "$attempts"); do
        output=$(mysql -h0 -P9306 -e "$sql" 2>&1)
        rc=$?

        if [ "$rc" -eq 0 ]; then
            return 0
        fi

        if [ "$attempt" -eq "$attempts" ]; then
            printf '%s\n' "$output" >&2
            return "$rc"
        fi

        sleep "$delay"
        delay=$((delay * 2))
    done
}

# Transient network errors and HTTP 408/429/5xx can occur during vector generation.
# Retry only those; fail immediately on SQL, model and validation errors.
retry_remote_embedding_insert() {
    local sql="$1"
    local attempts=5
    local delay=1
    local attempt output rc
    local transient_http_status='HTTP error from remote model: status code (408|429|500|502|503|504)([^0-9]|$)'
    for attempt in $(seq 1 "$attempts"); do
        if output=$(mysql -h0 -P9306 -e "$sql" 2>&1); then
            return 0
        else
            rc=$?
        fi

        if [[ "$output" != *"Failed to send request to remote model"* &&
              ! "$output" =~ $transient_http_status ]]; then
            printf '%s\n' "$output" >&2
            return "$rc"
        fi

        if [ "$attempt" -eq "$attempts" ]; then
            printf '%s\n' "$output" >&2
            return "$rc"
        fi

        sleep "$delay"
        delay=$((delay * 2))
    done
}
