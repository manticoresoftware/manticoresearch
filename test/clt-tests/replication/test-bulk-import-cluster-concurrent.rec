Two loads into one cluster table from two nodes at the same time: each chunk has its own id, both are delivered, wait in the pause side by side and are attached by two commands.
––– input –––
export BULK_PAUSE_1=5000 BULK_PAUSE_2=5000; echo ok
––– output –––
ok
––– block: ../base/replication/bulk-cluster-setup –––
––– input –––
source /tmp/bc.sh; load 1 t 1 2000 > /tmp/l1.out & load 2 t 2001 2000 > /tmp/l2.out & waitpause 1 1 && waitpause 2 1; echo "both paused $?"; for n in 1 2; do echo "node $n attach commands finished: $(grep -c 'attach command finished' /var/log/manticore-$n/searchd.log)"; done; wait; cat /tmp/l1.out /tmp/l2.out; echo done
––– output –––
both paused 0
node 1 attach commands finished: 0
node 2 attach commands finished: 0
done
––– input –––
source /tmp/bc.sh; st t
––– output –––
node 1: synced count=4000 sum=8002000 last_committed=3 files_seqno=3 repl=0
node 2: synced count=4000 sum=8002000 last_committed=3 files_seqno=3 repl=0
node 3: synced count=4000 sum=8002000 last_committed=3 files_seqno=3 repl=0
––– comment –––
Node 3 received two chunks with different ids
––– input –––
grep -oE "bulk_import chunk [0-9]+ of table 't': reserve" /var/log/manticore-3/searchd.log | sort -u | wc -l
––– output –––
2
