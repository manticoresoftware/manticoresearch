bulk_import into a cluster table over private HTTP on node 1 and over Shared HTTP with shared=2 on node 2: every chunk goes through its own attach command, the rows are the same on every node.
––– block: ../base/replication/bulk-cluster-setup –––
––– input –––
gen() { for ((i=$1; i<=$2; i++)); do printf '{"insert":{"cluster":"v1","table":"t","id":%d,"doc":{"title":"title %d","v":%d}}}\n' "$i" "$i" "$i"; done; }; gen 1 1000 > /tmp/p.ndjson; gen 1001 3000 > /tmp/a.ndjson; gen 3001 5000 > /tmp/b.ndjson; printf '\n' > /tmp/commit.ndjson; post() { curl -sS -X POST "http://127.0.0.1:$1/bulk?bulk_import=t$2" -H 'Content-Type: application/x-ndjson' --data-binary @"$3" -w ' HTTP %{http_code}\n'; }; echo ok
––– output –––
ok
––– input –––
post 1308 '' /tmp/p.ndjson
––– output –––
{"items":[{"bulk":{"table":"t","_id":0,"created":1000,"deleted":0,"updated":0,"result":"created","status":201}}],"current_line":1001,"skipped_lines":0,"errors":false,"error":""} HTTP 200
––– input –––
source /tmp/bc.sh; st t
––– output –––
node 1: synced count=1000 sum=500500 last_committed=2 files_seqno=2 repl=0
node 2: synced count=1000 sum=500500 last_committed=2 files_seqno=2 repl=0
node 3: synced count=1000 sum=500500 last_committed=2 files_seqno=2 repl=0
––– input –––
post 2308 '&shared=2' /tmp/a.ndjson > /tmp/a.reply & post 2308 '&shared=2' /tmp/b.ndjson > /tmp/b.reply & wait; cat /tmp/a.reply /tmp/b.reply
––– output –––
{"items":[],"current_line":2000,"skipped_lines":0,"errors":false,"error":"","error_code":"","shared_state":"staged"} HTTP 200
{"items":[],"current_line":2000,"skipped_lines":0,"errors":false,"error":"","error_code":"","shared_state":"staged"} HTTP 200
––– input –––
post 2308 '&shared' /tmp/commit.ndjson
––– output –––
{"items":[],"current_line":1,"skipped_lines":0,"errors":false,"error":"","error_code":"","shared_state":"published"} HTTP 200
––– input –––
source /tmp/bc.sh; st t; grep -c "attach command finished in .* result 1" /var/log/manticore-2/searchd.log
