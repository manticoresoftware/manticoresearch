rc 0
node 1: synced count=100 sum=5050 last_committed=2 files_seqno=2 repl=0
node 2: synced count=100 sum=5050 last_committed=2 files_seqno=2 repl=0
node 3: synced count=100 sum=5050 last_committed=2 files_seqno=2 repl=0
