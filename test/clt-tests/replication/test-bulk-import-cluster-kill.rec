KILL of the loading request in the pause before the attach command: the loading node sees the cancel before the command, every node drops the chunk by CHUNK_ABORT, no node attaches anything and the files seqno does not change.
––– input –––
export BULK_PAUSE_1=15000; echo ok
––– output –––
ok
––– block: ../base/replication/bulk-cluster-setup –––
––– input –––
source /tmp/bc.sh; load 1 t 1 1000 > /tmp/l1.out & waitpause 1 1; echo "paused $?"; for n in 1 2 3; do echo "node $n repl=$(repl $n)"; done; m 1 "KILL $(m 1 'SHOW QUERIES' | awk -F'\t' 'toupper($0) ~ /COMMIT/ {print $1}')"; echo "kill $?"
––– output –––
paused 0
node 1 repl=1
node 2 repl=1
node 3 repl=1
kill 0
––– input –––
wait; cat /tmp/l1.out; source /tmp/bc.sh; for n in 1 2 3; do echo "node $n count=$(m $n 'SELECT COUNT(*) FROM t') files_seqno=$(seqno $n) repl=$(repl $n)"; done
––– output –––
ERROR 1064 (42000) at line 5: query was killed
node 1 count=0 files_seqno=1 repl=0
node 2 count=0 files_seqno=1 repl=0
node 3 count=0 files_seqno=1 repl=0
––– input –––
source /tmp/bc.sh; load 1 t 1 100; echo "rc $?"; st t
