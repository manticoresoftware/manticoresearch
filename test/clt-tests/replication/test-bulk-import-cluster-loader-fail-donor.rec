The loading node failed to attach its chunk (E18) and waits for its rejoin while another node joins by SST: it refuses to donate the tables without the chunk, the joining node gets the donor's reason and joins after the loading node rejoined. Node 2 is in another Galera segment, so node 1 is the only donor for node 3; ALTER CLUSTER v2 UPDATE nodes towards a stopped node 4 holds the cluster operations lock on node 1 and keeps it in the window.
––– input –––
cat > /tmp/bc.sh <<'EOF'
m() { mysql --skip-table --batch --raw --skip-column-names -h0 -P${1}306 -e "$2" 2>&1; }
v() { m $1 "SHOW STATUS LIKE 'cluster_v1_$2'" | awk '{print $2}'; }
rows() { local i=$2 e=$(( $2 + $3 - 1 )) k j s; while [ $i -le $e ]; do k=$(( i + 499 )); [ $k -gt $e ] && k=$e; s="INSERT INTO v1:$1 (id,title,v) VALUES "; for j in $(seq $i $k); do s="$s($j,'title $j',$j),"; done; echo "${s%,};"; i=$(( k + 1 )); done; }
load() { { echo "SET bulk_import=$2;"; echo "BEGIN;"; rows $2 $3 $4; echo "COMMIT;"; echo "SET bulk_import=0;"; } | mysql -h0 -P${1}306 2>&1; }
seqno() { grep -o '"files_seqno":[0-9-]*' /var/log/manticore-$1/manticore.json | cut -d: -f2; }
st() { for n in 1 2 3; do echo "node $n: $(v $n node_state) count=$(m $n "SELECT COUNT(*) FROM $1" | tail -1) files_seqno=$(seqno $n)"; done; }
pauses() { grep -c 'pause [0-9]* ms before the attach command' /var/log/manticore-$1/searchd.log; }
waitpause() { for k in $(seq 120); do [ "$(pauses $1)" -ge $2 ] && return 0; sleep 0.5; done; return 1; }
waitsynced() { for k in $(seq 240); do [ "$(v $1 node_state)" = synced ] && [ "$(v $1 last_committed)" = "$(v $2 last_committed)" ] && return 0; sleep 0.5; done; return 1; }
EOF
echo ok
––– output –––
ok
––– input –––
for i in 1 2 3 4; do export INSTANCE=$i; mkdir -p /var/{run,lib,log}/manticore-$i; P=0; [ $i = 1 ] && P=15000; INDEXER_RT_BULK_CLUSTER_PAUSE_MS=$P stdbuf -oL searchd --logreplication -c test/clt-tests/base/searchd-with-flexible-ports.conf > /dev/null; done; for i in 1 2 3 4; do timeout 30 grep -qm1 '\[BUDDY\] started' <(tail -n 1000 -f /var/log/manticore-$i/searchd.log) && echo "node $i started"; done
