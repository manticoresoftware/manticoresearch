mysql -h0 -P1306 -e "CREATE CLUSTER v1"; mysql -h0 -P2306 -e "JOIN CLUSTER v1 AT '127.0.0.1:1312' 'gmcast.segment=1' as options"; mysql -h0 -P1306 -e "CREATE TABLE t (title text, v int)"; mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t"; mkdir -p /var/log/manticore-1/v2; O="'evs.suspect_timeout=PT120S;evs.inactive_timeout=PT120S' as options"; mysql -h0 -P1306 -e "CREATE CLUSTER v2 'v2' as path, $O"; mysql -h0 -P4306 -e "JOIN CLUSTER v2 AT '127.0.0.1:1312' $O"; echo $?
––– output –––
0
––– comment –––
Node 1 fails to attach its chunk; while it waits for its rejoin, ALTER CLUSTER v2 UPDATE nodes holds the cluster operations lock on it: the update waits for the stopped node 4
––– input –––
source /tmp/bc.sh; load 1 t 1 1000 > /tmp/l1.out & LP=$!; waitpause 1 1; echo "paused $?"; W4=$(cat /var/log/manticore-4/searchd.pid); P4="$W4 $(pgrep -P $W4)"; kill -STOP $P4; m 1 "ALTER CLUSTER v2 UPDATE nodes" > /dev/null & UP=$!; sleep 1; rm -f $(find /var/log/manticore-1 -maxdepth 4 -path '*repl-*' -name 'chunk.sph'); wait $LP; cat /tmp/l1.out
