––– input –––
chk() { grep -q -- "$3" /var/log/manticore-$1/searchd.log && echo "yes: $2" || echo "no: $2"; }; chk 1 'donation refused' "refused to donate SST to '127.0.0.1:3312': the donor did not attach a bulk_import chunk"; chk 3 'reason on the joiner' "cmd: synced(5), error: the donor did not attach a bulk_import chunk"; chk 3 'table without the chunk' "join sync 'v1', .*files seqno 0, sent ok"; chk 1 'loading node rejoined' "cluster 'v1' rejoin started, attempt 1"; echo "refusal logged $(grep -c 'cmd: synced(5), error: the donor did not attach a bulk_import chunk' /var/log/manticore-3/searchd.log)"
