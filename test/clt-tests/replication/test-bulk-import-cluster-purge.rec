––– input –––
source /tmp/bc.sh; m 3 "PURGE BULK_IMPORT FROM TABLE t"; m 3 "PURGE BULK_IMPORT FROM TABLE t OPTION clear_sessions=1"; echo "node 3 rc $? repl=$(repl 3)"; m 2 "PURGE BULK_IMPORT FROM TABLE t OPTION clear_sessions=1"; m 1 "PURGE BULK_IMPORT FROM TABLE t"; for n in 1 2 3; do echo "node $n repl=$(repl $n)"; done
