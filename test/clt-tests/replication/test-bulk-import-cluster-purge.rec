PURGE BULK_IMPORT on a cluster table (E19): while a chunk waits for its attach command PURGE refuses on a receiver and on the loading node; the loading node is killed in the pause (SIGKILL stops the watchdog too, so the node is started again) and leaves the chunk on the receivers, where PURGE still refuses until clear_sessions=1; the restarted loading node has no record of its old chunk and PURGE removes it.
––– input –––
export BULK_PAUSE_1=15000; echo ok
––– output –––
ok
––– block: ../base/replication/bulk-cluster-setup –––
––– input –––
source /tmp/bc.sh; load 1 t 1 1000 > /tmp/l1.out 2>&1 & waitpause 1 1; echo "paused $?"; echo "node 2 files: $(m 2 "SELECT file FROM t.@files OPTION format='bulk_import'" | sed -e 's#.*/repl-[0-9]*/##' -e 's#.*/repl-[0-9]*$#repl-ID#' | sort | xargs)"; m 2 "PURGE BULK_IMPORT FROM TABLE t"; m 1 "PURGE BULK_IMPORT FROM TABLE t"
––– output –––
paused 0
node 2 files: chunk.spa chunk.spd chunk.spds chunk.spe chunk.sph chunk.sphi chunk.spi chunk.spidx chunk.spm chunk.spp chunk.spt repl-ID
ERROR 1064 (42000) at line 1: a bulk_import chunk of table 't' is being replicated; repeat PURGE after it finishes or use OPTION clear_sessions=1
ERROR 1064 (42000) at line 1: a bulk_import chunk of table 't' is being replicated; repeat PURGE after it finishes or use OPTION clear_sessions=1
––– input –––
P1=$(cat /var/log/manticore-1/searchd.pid); kill -9 $P1; wait; grep -c 'Lost connection' /tmp/l1.out; for k in $(seq 60); do kill -0 $P1 2>/dev/null || break; sleep 0.5; done; INSTANCE=1 INDEXER_RT_BULK_CLUSTER_PAUSE_MS=15000 searchd --logreplication -c test/clt-tests/base/searchd-with-flexible-ports.conf > /dev/null; source /tmp/bc.sh; waitsynced 1 2; echo "synced $?"; for n in 1 2 3; do echo "node $n count=$(m $n 'SELECT COUNT(*) FROM t') files_seqno=$(seqno $n) repl=$(repl $n)"; done
