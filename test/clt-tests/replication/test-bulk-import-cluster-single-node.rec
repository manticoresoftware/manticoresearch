bulk_import into a table of a cluster with one node: nothing to deliver, the attach command runs on this node only.
––– input –––
export INSTANCE=1; mkdir -p /var/{run,lib,log}/manticore-1; stdbuf -oL searchd --logreplication -c test/clt-tests/base/searchd-with-flexible-ports.conf > /dev/null; timeout 30 grep -qm1 '\[BUDDY\] started' <(tail -n 1000 -f /var/log/manticore-1/searchd.log) && echo started
––– output –––
started
––– input –––
mysql -h0 -P1306 -e "CREATE CLUSTER v1"; mysql -h0 -P1306 -e "CREATE TABLE t (title text, v int)"; mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t"; echo $?
––– output –––
0
––– input –––
m() { mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "$1"; }; { echo "SET bulk_import=t;"; echo "BEGIN;"; echo "INSERT INTO v1:t (id,title,v) VALUES (1,'a',1),(2,'b',2),(3,'c',3);"; echo "COMMIT;"; } | mysql -h0 -P1306; echo "rc $?"; echo "count=$(m 'SELECT COUNT(*) FROM t') last_committed=$(m "SHOW STATUS LIKE 'cluster_v1_last_committed'" | awk '{print $2}') $(grep -o '"files_seqno":[0-9]*' /var/log/manticore-1/manticore.json) repl=$(find /var/log/manticore-1 -maxdepth 3 -name 'repl-*' | wc -l)"
––– output –––
rc 0
count=3 last_committed=2 "files_seqno":2 repl=0
––– input –––
grep -cE "bulk_import chunk [0-9]+ of table 't': delivered to 1 nodes" /var/log/manticore-1/searchd.log
––– output –––
1
––– comment –––
The only node started once and wrote no crash dump
––– input –––
L=/var/log/manticore-1/searchd.log; echo "node 1 starts=$(grep -c 'watchdog: main process .* forked ok' $L) killed=$(grep -c 'killed dirtily' $L) dumps=$(grep -c 'CRASH DUMP' $L)"
––– output –––
node 1 starts=1 killed=0 dumps=0
