A receiver leaves after the chunk was delivered and comes back by full SST before the attach command (P1 rejoin in the same process): the SST does not touch repl-<id>/ in the staging root, so the receiver attaches the chunk as the other nodes do.
––– input –––
export BULK_PAUSE_1=60000; echo ok
––– output –––
ok
––– block: ../base/replication/bulk-cluster-setup –––
––– input –––
source /tmp/bc.sh; load 1 t 1 1000 > /tmp/l1.out & waitpause 1 1; echo "paused $?"; echo "node 3 repl=$(repl 3)"
––– output –––
paused 0
node 3 repl=1
––– block: ../base/replication/rejoin-pause-node3 –––
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE t2 (title text)"; timeout 60 mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t2"; kill -CONT $P3; source /tmp/bc.sh; waitsynced 3 1; echo "synced $?"; echo "node 3 repl=$(repl 3) files_seqno=$(seqno 3)"; grep -q "files seqno 1 differs from donor files seqno 2 on IST" /var/log/manticore-3/searchd.log && echo "IST refused, rejoined by SST"
––– output –––
synced 0
node 3 repl=1 files_seqno=2
IST refused, rejoined by SST
––– input –––
wait; cat /tmp/l1.out; source /tmp/bc.sh; kill -0 $P3 && echo alive; st t
––– output –––
alive
node 1: synced count=1000 sum=500500 last_committed=3 files_seqno=3 repl=0
node 2: synced count=1000 sum=500500 last_committed=3 files_seqno=3 repl=0
node 3: synced count=1000 sum=500500 last_committed=3 files_seqno=3 repl=0
––– block: ../base/replication/node-starts –––
