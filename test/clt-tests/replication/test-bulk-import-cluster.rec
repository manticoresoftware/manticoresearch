KNN: the loading node builds the KNN index of the chunk, the .spknn file is delivered with the chunk and a KNN search on another node finds the rows
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE tk (title text, v int, emb float_vector knn_type='hnsw' knn_dims='4' hnsw_similarity='l2')"; mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD tk"; echo $?
––– output –––
0
––– input –––
{ echo "SET bulk_import=tk;"; echo "BEGIN;"; s="INSERT INTO v1:tk (id,title,v,emb) VALUES "; for i in $(seq 1 500); do s="$s($i,'title $i',$i,($((i%7)),$((i%5)),$((i%3)),$((i%11)))),"; done; echo "${s%,};"; echo "COMMIT;"; echo "SET bulk_import=0;"; } | mysql -h0 -P1306; echo "rc $?"; source /tmp/bc.sh; st tk
