A bare document has no place for the cluster and takes the cluster of the table (E25): private on node 1 and Shared on node 2, the rows on all nodes
––– input –––
for ((i=6001; i<=6050; i++)); do printf '{"id":%d,"title":"bare %d","v":%d}\n' $i $i $i; done > /tmp/bp.ndjson; for ((i=6051; i<=6100; i++)); do printf '{"id":%d,"title":"bare %d","v":%d}\n' $i $i $i; done > /tmp/bs.ndjson; post 1308 '' /tmp/bp.ndjson | sed 's/^/private: /'; post 2308 '&shared' /tmp/bs.ndjson | sed 's/^/shared: /'; post 2308 '&shared' /tmp/commit.ndjson | sed 's/^/shared commit: /'; source /tmp/bc.sh; st th
