bulk_import into RT tables of cluster v1, one table per case: a cluster of one node, then nodes 2 and 3 join by SST and get the attached chunk; SQL, HTTP, KNN, a failed delivery and a node away at the commit. The helpers in /tmp/bc.sh write rows with the cluster prefix.
––– input –––
cat > /tmp/bc.sh <<'EOF'
m() { mysql --skip-table --batch --raw --skip-column-names -h0 -P${1}306 -e "$2" 2>&1; }
v() { m $1 "SHOW STATUS LIKE 'cluster_v1_$2'" | awk '{print $2}'; }
rows() { local i=$2 e=$(( $2 + $3 - 1 )) k j s; while [ $i -le $e ]; do k=$(( i + 499 )); [ $k -gt $e ] && k=$e; s="INSERT INTO v1:$1 (id,title,v) VALUES "; for j in $(seq $i $k); do s="$s($j,'title $j',$j),"; done; echo "${s%,};"; i=$(( k + 1 )); done; }
load() { { echo "SET bulk_import=$2;"; echo "BEGIN;"; rows $2 $3 $4; echo "COMMIT;"; echo "SET bulk_import=0;"; } | mysql -h0 -P${1}306 2>&1; }
seqno() { grep -o '"files_seqno":[0-9-]*' /var/log/manticore-$1/manticore.json | cut -d: -f2; }
repl() { find /var/log/manticore-$1 -maxdepth 3 -name 'repl-*' -printf '%f\n' | sed -nE 's/^repl-([0-9]+)(\..*)?$/\1/p' | sort -u | wc -l; }
st() { for n in 1 2 3; do echo "node $n: $(v $n node_state) count=$(m $n "SELECT COUNT(*) FROM $1" | tail -1) sum=$(m $n "SELECT SUM(v) FROM $1" | tail -1) last_committed=$(v $n last_committed) files_seqno=$(seqno $n) repl=$(repl $n)"; done; }
add() { mysql -h0 -P1306 -e "CREATE TABLE $1 (title text, v int)"; mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD $1"; echo "add $1 $?"; }
waitsynced() { for k in $(seq 240); do [ "$(v $1 node_state)" = synced ] && [ "$(v $1 last_committed)" = "$(v $2 last_committed)" ] && return 0; sleep 0.5; done; return 1; }
EOF
echo ok
––– output –––
ok
––– comment –––
A cluster of one node: nothing to deliver, the attach command runs on this node only
––– input –––
export INSTANCE=1; mkdir -p /var/{run,lib,log}/manticore-1; stdbuf -oL searchd --logreplication -c test/clt-tests/base/searchd-with-flexible-ports.conf > /dev/null; timeout 30 grep -qm1 '\[BUDDY\] started' <(tail -n 1000 -f /var/log/manticore-1/searchd.log) && echo started
––– output –––
started
––– input –––
mysql -h0 -P1306 -e "CREATE CLUSTER v1"; mysql -h0 -P1306 -e "CREATE TABLE t (title text, v int)"; mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t"; echo $?
––– output –––
0
––– input –––
source /tmp/bc.sh; printf "SET bulk_import=t;\nBEGIN;\nINSERT INTO v1:t (id,title,v) VALUES (1,'a',1),(2,'b',2),(3,'c',3);\nCOMMIT;\n" | mysql -h0 -P1306; echo "rc $?"; echo "count=$(m 1 'SELECT COUNT(*) FROM t') last_committed=$(v 1 last_committed) files_seqno=$(seqno 1) repl=$(repl 1)"; grep -cE "bulk_import chunk [0-9]+ of table 't': delivered to 1 nodes" /var/log/manticore-1/searchd.log
––– output –––
rc 0
count=3 last_committed=2 files_seqno=2 repl=0
1
––– comment –––
Nodes 2 and 3 join by SST and get the table with the attached chunk and its files seqno
––– input –––
for i in 2 3; do export INSTANCE=$i; mkdir -p /var/{run,lib,log}/manticore-$i; stdbuf -oL searchd --logreplication -c test/clt-tests/base/searchd-with-flexible-ports.conf > /dev/null; done; for i in 2 3; do timeout 30 grep -qm1 '\[BUDDY\] started' <(tail -n 1000 -f /var/log/manticore-$i/searchd.log) && echo "node $i started"; done
––– output –––
node 2 started
node 3 started
––– input –––
for n in 2 3; do mysql -h0 -P${n}306 -e "JOIN CLUSTER v1 AT '127.0.0.1:1312'"; done; source /tmp/bc.sh; st t
––– output –––
node 1: synced count=3 sum=6 last_committed=2 files_seqno=2 repl=0
node 2: synced count=3 sum=6 last_committed=2 files_seqno=2 repl=0
node 3: synced count=3 sum=6 last_committed=2 files_seqno=2 repl=0
––– comment –––
SQL: the loading node delivers the chunk and one BULK_IMPORT_ATTACH command attaches it on every node; the cluster files seqno becomes the seqno of that command everywhere and no staging is left
––– input –––
