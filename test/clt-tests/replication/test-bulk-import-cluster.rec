source /tmp/bc.sh; L3=$(wc -l < /var/log/manticore-3/searchd.log); load 1 ta 1 1000; echo "rc $?"; for n in 1 2; do echo "node $n count=$(m $n 'SELECT COUNT(*) FROM ta') files_seqno=$(seqno $n)"; done
