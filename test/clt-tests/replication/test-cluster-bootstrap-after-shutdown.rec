––– block: ../base/replication/join-cluster-on-all-nodes –––
––– comment –––
Wait for a primary, synced cluster of the expected size on every running node.
––– input –––
wait_cluster() {
    local expected_size="$1"
    shift
    local deadline=$((SECONDS+180))
    while [ "$SECONDS" -lt "$deadline" ]; do
        local ready=1
        local port status
        for port in "$@"; do
            status=$(mysql -N -s -h0 -P"$port" -e "SHOW STATUS LIKE 'cluster_${CLUSTER_NAME}_%'" 2>/dev/null) || { ready=0; break; }
            grep -Eq '^cluster_${CLUSTER_NAME}_status[[:space:]]+primary[[:space:]]*$' <<< "$status" || { ready=0; break; }
            grep -Eq "^cluster_${CLUSTER_NAME}_size[[:space:]]+$expected_size[[:space:]]*$" <<< "$status" || { ready=0; break; }
            grep -Eq '^cluster_${CLUSTER_NAME}_node_state[[:space:]]+synced[[:space:]]*$' <<< "$status" || { ready=0; break; }
        done
        if [ "$ready" -eq 1 ]; then
            echo "Cluster synced with $expected_size node(s)"
            return 0
        fi
        sleep 1
    done
    echo "Cluster did not become primary/synced with $expected_size node(s)" >&2
    return 1
}
check_rows() {
    local port count
    for port in "$@"; do
        count=$(mysql -N -s -h0 -P"$port" -e "SELECT COUNT(*) FROM bootstrap_restart_rt" 2>/dev/null) || return 1
        [ "$count" = 1 ] || return 1
    done
    echo "Data intact on $# node(s)"
}
––– output –––
––– input –––
wait_cluster 3 1306 2306 3306
––– output –––
Cluster synced with 3 node(s)
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE bootstrap_restart_rt (id bigint, title text);" && mysql -h0 -P1306 -e "ALTER CLUSTER ${CLUSTER_NAME} ADD bootstrap_restart_rt;" && mysql -h0 -P1306 -e "INSERT INTO ${CLUSTER_NAME}:bootstrap_restart_rt VALUES (1, 'before shutdown');"
