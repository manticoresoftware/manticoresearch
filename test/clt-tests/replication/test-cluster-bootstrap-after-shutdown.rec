––– output –––
––– block: ../base/replication/stop-searchd –––
––– input –––
state_file=$(find /var/log/manticore-1 -name grastate.dat -print -quit); [ -n "$state_file" ] && grep -Eq '^safe_to_bootstrap:[[:space:]]*1[[:space:]]*$' "$state_file" && sed -i 's/^safe_to_bootstrap:[[:space:]]*1[[:space:]]*$/safe_to_bootstrap: 0/' "$state_file" && grep -Eq '^safe_to_bootstrap:[[:space:]]*0[[:space:]]*$' "$state_file" && echo "Bootstrap guard cleared"
