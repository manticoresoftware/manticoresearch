––– comment –––
Wait for a primary, synced cluster of the expected size on every running node.
––– input –––
dump_cluster_diagnostics() {
    echo "=== Cluster ${CLUSTER_NAME} diagnostics ==="
    for port in 1306 2306 3306; do
        echo "--- Port $port: replication status ---"
        timeout 5 mysql -N -B -h0 -P"$port" -e "SHOW STATUS LIKE 'cluster_${CLUSTER_NAME}_%'" 2>&1 || true
        echo "--- Port $port: replicated table count ---"
        timeout 5 mysql -N -B -h0 -P"$port" -e "SELECT COUNT(*) FROM bootstrap_restart_rt" 2>&1 || true
    done
    for node in 1 2 3; do
        echo "--- Node $node: last 80 searchd.log lines ---"
        if [ -f "/var/log/manticore-$node/searchd.log" ]; then
            tail -n 80 "/var/log/manticore-$node/searchd.log"
        else
            echo "searchd.log missing"
        fi
        echo "--- Node $node: grastate.dat ---"
        local state_file
        state_file=$(find "/var/log/manticore-$node" -name grastate.dat -print -quit 2>/dev/null)
        if [ -n "$state_file" ]; then
            cat "$state_file"
        else
            echo "grastate.dat missing"
        fi
    done
}
cluster_ready() {
    local port="$1" expected_size="$2" output values
    output=$(timeout 5 mysql -h0 -P"$port" -e "SHOW STATUS LIKE 'cluster_${CLUSTER_NAME}_%'\G" 2>/dev/null) || return 1
    values=$(awk -v prefix="cluster_${CLUSTER_NAME}_" '
        $1 == "Counter:" { key = $2 }
        $1 == "Value:" {
            if (key == prefix "status") status = $2
            if (key == prefix "size") size = $2
            if (key == prefix "node_state") state = $2
        }
        END { print status, size, state }
    ' <<< "$output")
    [ "$values" = "primary $expected_size synced" ]
}
wait_cluster() {
    local expected_size="$1"
    shift
    local deadline=$((SECONDS+120))
    local ready port
    while [ "$SECONDS" -lt "$deadline" ]; do
        ready=1
        for port in "$@"; do
            cluster_ready "$port" "$expected_size" || { ready=0; break; }
        done
        if [ "$ready" -eq 1 ]; then
            echo "Cluster synced with $expected_size node(s)"
            return 0
        fi
        sleep 1
    done
    echo "ERROR: cluster did not become primary/synced with $expected_size node(s)" >&2
    dump_cluster_diagnostics >&2
    return 1
}
check_rows() {
    local deadline=$((SECONDS+60))
    local port output ready
    while [ "$SECONDS" -lt "$deadline" ]; do
        ready=1
        for port in "$@"; do
            output=$(timeout 5 mysql -h0 -P"$port" -e "SELECT COUNT(*) AS cnt FROM bootstrap_restart_rt\G" 2>/dev/null) || { ready=0; break; }
            grep -Eq '^[[:space:]]*cnt:[[:space:]]*1[[:space:]]*$' <<< "$output" || { ready=0; break; }
        done
        if [ "$ready" -eq 1 ]; then
            echo "Data intact on $# node(s)"
            return 0
        fi
        sleep 1
    done
    echo "ERROR: replicated row missing on one or more nodes" >&2
    dump_cluster_diagnostics >&2
    return 1
}
––– output –––
––– input –––
wait_cluster 3 1306 2306 3306 || exit 1
––– output –––
Cluster synced with 3 node(s)
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE bootstrap_restart_rt (id bigint, title text);" && mysql -h0 -P1306 -e "ALTER CLUSTER ${CLUSTER_NAME} ADD bootstrap_restart_rt;" && mysql -h0 -P1306 -e "INSERT INTO ${CLUSTER_NAME}:bootstrap_restart_rt VALUES (1, 'before shutdown');" || { dump_cluster_diagnostics >&2; exit 1; }
