A node paused with SIGSTOP misses ALTER CLUSTER ADD, resumes and gets IST; it refuses IST on the files seqno and rejoins by full SST without a daemon restart.
––– block: ../base/replication/rejoin-setup –––
––– block: ../base/replication/rejoin-pause-node3 –––
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE t1 (title text, v int)"; mysql -h0 -P1306 -e "INSERT INTO t1 (id,title,v) VALUES (1,'x',1)"; timeout 60 mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t1"; echo $?
––– output –––
0
––– input –––
mysql -h0 -P1306 -e "INSERT INTO v1:t0 (id,title,v) VALUES (2,'b',2)"; mysql -h0 -P2306 -e "INSERT INTO v1:t1 (id,title,v) VALUES (2,'y',2)"; echo $?
