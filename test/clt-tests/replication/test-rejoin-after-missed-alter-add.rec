0
––– input –––
for p in 1306 2306; do echo "$p $(mysql -h0 -P$p -e "SHOW STATUS LIKE 'cluster_v1_indexes'\G" | awk '/Value:/{print $2}') $(mysql -h0 -P$p -e "SHOW STATUS LIKE 'cluster_v1_last_committed'\G" | awk '/Value:/{print $2}')"; done
