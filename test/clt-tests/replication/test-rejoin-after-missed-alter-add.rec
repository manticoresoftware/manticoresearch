Resume node 3: Galera gives it IST, the donor sends CLUSTER_SYNCED with files seqno 3 (its ALTER CLUSTER ADD), node 3 has 1 and refuses and rejoins by full SST without a restart
––– input –––
kill -CONT $P3; echo "node 3 resumed"
––– output –––
node 3 resumed
––– input –––
timeout 60 bash -c 'v() { mysql -h0 -P3306 -e "SHOW STATUS LIKE '\''cluster_v1_$1'\''\G" | awk "/Value:/{print \$2}"; }; until [ "$(v node_state)" = synced ] && [ "$(v last_committed)" = 5 ]; do sleep 0.5; done'; echo "synced $?"
––– output –––
synced 0
––– input –––
for v in node_state status indexes last_committed; do echo "$v $(mysql -h0 -P3306 -e "SHOW STATUS LIKE 'cluster_v1_$v'\G" | awk '/Value:/{print $2}')"; done
––– output –––
node_state synced
status primary
indexes #!/(t0,t1|t1,t0)/!#
