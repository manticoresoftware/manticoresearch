mysql -h0 -P1306 -e "INSERT INTO v1:t0 (id,title,v) VALUES (3,'c',3)"; mysql -h0 -P2306 -e "INSERT INTO v1:t1 (id,title,v) VALUES (2,'y',2)"; echo $?
––– output –––
0
