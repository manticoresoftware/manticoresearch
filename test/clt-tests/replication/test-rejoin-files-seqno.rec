Node 3 started twice (the first start and the clean restart), no process was killed by a signal and none wrote a crash dump
––– input –––
for n in 1 2 3; do L=/var/log/manticore-$n/searchd.log; echo "node $n starts=$(grep -c 'watchdog: main process .* forked ok' $L) killed=$(grep -c 'killed dirtily' $L) dumps=$(grep -c 'CRASH DUMP' $L)"; done
