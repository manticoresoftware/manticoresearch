L3=$(wc -l < /var/log/manticore-3/searchd.log); mysql -h0 -P1306 -e "CREATE TABLE t2 (title text, v int)"; mysql -h0 -P1306 -e "INSERT INTO t2 (id,title,v) VALUES (1,'x',1)"; timeout 60 mysql -h0 -P1306 -e "ALTER CLUSTER v1 ADD t2"; echo $?
