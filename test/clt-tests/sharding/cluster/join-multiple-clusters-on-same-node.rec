––– input –––
wait "$JOIN_A_PID"; a_rc=$?; wait "$JOIN_B_PID"; b_rc=$?; if [ "$a_rc" -eq 0 ] && [ "$b_rc" -eq 0 ]; then echo 0; else cat /tmp/join-cluster-{a,b}.log; echo 1; fi
