––– comment –––
Regression: FAIL_008 (daemon) — KNN query against a public sharded table
with a float_vector knn attr. The distributed head must NOT rescore (it has
no local KNN settings); each shard returns a comparable knn_dist() and the
head merges them. This used to crash searchd (SIGSEGV in Expr_KNNDist_c) or
error with "attribute 'vector' not found". Now the query returns the
nearest neighbours ordered by distance and searchd stays up.

––– input –––
export INSTANCE=1
––– output –––
––– block: ../../base/replication/start-searchd-precach –––
––– input –––
export INSTANCE=2
––– output –––
––– block: ../../base/replication/start-searchd-precach –––
––– input –––
export INSTANCE=3
––– output –––
––– block: ../../base/replication/start-searchd-precach –––
––– input –––
export INSTANCE=1
––– output –––
––– input –––
mysql -h0 -P1306 -e "create table t8(title text, vector float_vector knn_type='hnsw' knn_dims='4' hnsw_similarity='l2') shards='2' rf='1';"; echo $?
––– output –––
0
––– input –––
for i in $(seq 1 30); do s=$(mysql -h0 -P1306 -N -B -e "show sharding status t8" 2>/dev/null); echo "$s" | grep -q active && ! echo "$s" | grep -q pending && break; sleep 1; done; sleep 2; echo waited
––– output –––
waited
––– input –––
mysql -h0 -P1306 -e "insert into t8(id,title,vector) values(1,'one',(0.1,0.2,0.3,0.4)),(2,'two',(0.2,0.1,0.4,0.3));"; echo $?
––– output –––
0
––– input –––
mysql -h0 -P1306 -N -B -e "select id from t8 where knn(vector, 2, (0.1,0.2,0.3,0.4)) order by knn_dist() asc;" 2>&1 | tr -d ' |+-' | grep -v '^$'
––– output –––
1
2
––– input –––
sleep 1; mysql -h0 -P1306 -e "show status like 'uptime';" | grep uptime | awk '{print ($2 > 0) ? "uptime_positive" : "uptime_zero"}'
––– output –––
uptime_positive
––– comment –––
Chunk provenance computed by agents must survive the distributed head merge.
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE t9(body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8') SHARDS='2' RF='1';"; echo $?
––– output –––
0
––– input –––
ready=0; for i in $(seq 1 30); do s=$(mysql -h0 -P1306 -N -B -e "SHOW SHARDING STATUS t9" 2>/dev/null); if [ "$(printf '%s\n' "$s" | grep -ci active)" -eq 2 ] && ! printf '%s\n' "$s" | grep -Eqi 'pending|error|initializing'; then ready=1; break; fi; sleep 1; done; echo "ready=$ready"
––– output –––
ready=1
––– input –––
mysql -h0 -P1306 -e "INSERT INTO t9(id,body) VALUES (1,'short target phrase end'),(2,'alpha beta gamma delta epsilon zeta eta theta target phrase end'),(3,'alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu target phrase end'),(4,'prefix words before target phrase and tail'),(5,'one two three four five six seven eight nine ten target phrase end'),(6,'target phrase starts this document'),(7,'long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end'),(8,'different prefix target phrase different tail');"; echo $?
––– output –––
0
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM t9 WHERE KNN(chunks,8,'target phrase') ORDER BY id" > /tmp/distributed-provenance.tsv && python3 test/clt-tests/mcl/check-chunk-provenance.py distributed 1 'short target phrase end' 2 'alpha beta gamma delta epsilon zeta eta theta target phrase end' 3 'alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu target phrase end' 4 'prefix words before target phrase and tail' 5 'one two three four five six seven eight nine ten target phrase end' 6 'target phrase starts this document' 7 'long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end' 8 'different prefix target phrase different tail' < /tmp/distributed-provenance.tsv
––– output –––
DISTRIBUTED_CHUNK_PROVENANCE_OK
––– comment –––
Chunk highlighting is evaluated on agents before the distributed head merge.
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end(),HIGHLIGHT({knn_chunk=1},'body') FROM t9 WHERE KNN(chunks,8,'target phrase') ORDER BY id" > /tmp/distributed-highlight.tsv && python3 test/clt-tests/mcl/check-chunk-provenance.py distributed-highlight plain 1 'short target phrase end' 2 'alpha beta gamma delta epsilon zeta eta theta target phrase end' 3 'alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu target phrase end' 4 'prefix words before target phrase and tail' 5 'one two three four five six seven eight nine ten target phrase end' 6 'target phrase starts this document' 7 'long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end' 8 'different prefix target phrase different tail' < /tmp/distributed-highlight.tsv
––– output –––
DISTRIBUTED_CHUNK_HIGHLIGHT_OK
––– comment –––
Distributed SQL RRF uses two remote agents with disjoint rows. The ordinary query must merge both result sets without adding coordinator-only placeholder columns.
––– input –––
mysql -h0 -P2306 -e "CREATE TABLE hybrid_agent(body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO hybrid_agent(id,body) VALUES (1,'agent one short target phrase end'),(2,'agent one alpha beta gamma delta epsilon zeta eta theta target phrase end'),(3,'agent one long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end'),(4,'agent one prefix target phrase different tail')" && mysql -h0 -P3306 -e "CREATE TABLE hybrid_agent(body TEXT, chunks FLOAT_VECTOR_ARRAY KNN_TYPE='hnsw' HNSW_SIMILARITY='cosine' MODEL_NAME='sentence-transformers/all-MiniLM-L6-v2' FROM='body' CHUNK_STRATEGY='fixed' MAX_TOKENS='8'); INSERT INTO hybrid_agent(id,body) VALUES (5,'agent two one two three four five six seven eight target phrase end'),(6,'agent two target phrase starts this document'),(7,'agent two long prefix alpha beta gamma delta epsilon zeta eta theta target phrase end'),(8,'agent two different prefix target phrase different tail')" && mysql -h0 -P1306 -e "CREATE TABLE hybrid_dist TYPE='distributed' AGENT='127.0.0.1:2312:hybrid_agent' AGENT='127.0.0.1:3312:hybrid_agent'" && mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM hybrid_dist WHERE MATCH('target phrase') AND KNN(chunks,8,'target phrase') ORDER BY hybrid_score() DESC, id ASC OPTION fusion_method='rrf'" > /tmp/distributed-hybrid.tsv && python3 test/clt-tests/mcl/check-chunk-provenance.py distributed 1 'agent one short target phrase end' 2 'agent one alpha beta gamma delta epsilon zeta eta theta target phrase end' 3 'agent one long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end' 4 'agent one prefix target phrase different tail' 5 'agent two one two three four five six seven eight target phrase end' 6 'agent two target phrase starts this document' 7 'agent two long prefix alpha beta gamma delta epsilon zeta eta theta target phrase end' 8 'agent two different prefix target phrase different tail' < /tmp/distributed-hybrid.tsv
––– output –––
DISTRIBUTED_CHUNK_PROVENANCE_OK
––– comment –––
Chunk highlighting propagates hybrid text-phase metadata to both agents and preserves each exact tagged chunk.
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end(),HIGHLIGHT({knn_chunk=1},'body') FROM hybrid_dist WHERE MATCH('target phrase') AND KNN(chunks,8,'target phrase') ORDER BY hybrid_score() DESC, id ASC OPTION fusion_method='rrf'" > /tmp/distributed-hybrid-highlight.tsv && python3 test/clt-tests/mcl/check-chunk-provenance.py distributed-highlight tagged 1 'agent one short target phrase end' 2 'agent one alpha beta gamma delta epsilon zeta eta theta target phrase end' 3 'agent one long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end' 4 'agent one prefix target phrase different tail' 5 'agent two one two three four five six seven eight target phrase end' 6 'agent two target phrase starts this document' 7 'agent two long prefix alpha beta gamma delta epsilon zeta eta theta target phrase end' 8 'agent two different prefix target phrase different tail' < /tmp/distributed-hybrid-highlight.tsv
––– output –––
DISTRIBUTED_HYBRID_CHUNK_HIGHLIGHT_OK
––– comment –––
Concurrent hybrid queue creation must not leak deferred chunk-highlight state into ordinary queries, and fusion must leave HIGHLIGHT lazy until final provenance is available.
––– input –––
rm -f /tmp/knn-chunk-stress-*; pids=''; for i in $(seq 1 8); do ( mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end(),HIGHLIGHT({knn_chunk=1},'body') FROM hybrid_dist WHERE MATCH('target phrase') AND KNN(chunks,8,'target phrase') ORDER BY hybrid_score() DESC, id ASC OPTION fusion_method='rrf'" | python3 test/clt-tests/mcl/check-chunk-provenance.py distributed-highlight tagged 1 'agent one short target phrase end' 2 'agent one alpha beta gamma delta epsilon zeta eta theta target phrase end' 3 'agent one long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end' 4 'agent one prefix target phrase different tail' 5 'agent two one two three four five six seven eight target phrase end' 6 'agent two target phrase starts this document' 7 'agent two long prefix alpha beta gamma delta epsilon zeta eta theta target phrase end' 8 'agent two different prefix target phrase different tail' > /tmp/knn-chunk-stress-hybrid-$i ) & pids="$pids $!"; ( mysql --skip-table --batch --raw --skip-column-names -h0 -P1306 -e "SELECT id,knn_chunk_index(),knn_chunk_start(),knn_chunk_end() FROM hybrid_dist WHERE MATCH('target phrase') AND KNN(chunks,8,'target phrase') ORDER BY hybrid_score() DESC, id ASC OPTION fusion_method='rrf'" | python3 test/clt-tests/mcl/check-chunk-provenance.py distributed 1 'agent one short target phrase end' 2 'agent one alpha beta gamma delta epsilon zeta eta theta target phrase end' 3 'agent one long prefix alpha beta gamma delta epsilon zeta eta theta iota target phrase end' 4 'agent one prefix target phrase different tail' 5 'agent two one two three four five six seven eight target phrase end' 6 'agent two target phrase starts this document' 7 'agent two long prefix alpha beta gamma delta epsilon zeta eta theta target phrase end' 8 'agent two different prefix target phrase different tail' > /tmp/knn-chunk-stress-plain-$i ) & pids="$pids $!"; ( ERR=$(mysql -h0 -P2306 -e "SELECT HIGHLIGHT({knn_chunk=1},'body') FROM hybrid_agent LIMIT 1" 2>&1) && exit 1; case "$ERR" in *'KNN chunk highlighting requires a KNN query'*) echo NO_KNN_REJECTED;; *) exit 1;; esac ) > /tmp/knn-chunk-stress-error-$i & pids="$pids $!"; ( OUT=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P3306 -e "SELECT HIGHLIGHT({},'body','target phrase') FROM hybrid_agent WHERE id=6"); test "$OUT" = 'agent two <b>target phrase</b> starts this document' && echo ORDINARY_HIGHLIGHT_OK ) > /tmp/knn-chunk-stress-ordinary-$i & pids="$pids $!"; done; status=0; for pid in $pids; do wait "$pid" || status=1; done; test "$status" -eq 0 || exit 1; for i in $(seq 1 8); do test "$(cat /tmp/knn-chunk-stress-hybrid-$i)" = DISTRIBUTED_HYBRID_CHUNK_HIGHLIGHT_OK || exit 1; test "$(cat /tmp/knn-chunk-stress-plain-$i)" = DISTRIBUTED_CHUNK_PROVENANCE_OK || exit 1; test "$(cat /tmp/knn-chunk-stress-error-$i)" = NO_KNN_REJECTED || exit 1; test "$(cat /tmp/knn-chunk-stress-ordinary-$i)" = ORDINARY_HIGHLIGHT_OK || exit 1; done; rm -f /tmp/knn-chunk-stress-*; echo KNN_CHUNK_CONCURRENCY_OK
––– output –––
KNN_CHUNK_CONCURRENCY_OK
