––– comment –––
Regression for issue #4770: a valid 191-byte logical table name used to fail
when Buddy generated internal system.<name>_sN shard names, because the DDL
parser applied the 200-byte public-name limit to the generated component.
Verify a real two-node replication cluster with RF=2: Buddy-managed create,
physical shard materialization on both nodes, replicated DML, restart, and
cluster-wide cleanup.
––– comment –––
Start two nodes and join them into replication cluster c.
––– input –––
export INSTANCE=1
––– output –––
––– block: ../../base/replication/start-searchd-precach –––
––– input –––
export INSTANCE=2
––– output –––
––– block: ../../base/replication/start-searchd-precach –––
––– input –––
export CLUSTER_NAME=c
––– output –––
––– block: ../../base/replication/create-cluster –––
––– block: ../../base/replication/join-cluster-on-all-nodes –––
––– input –––
LONG_TABLE_NAME="t$(printf '%0190d' 1)"; echo ${#LONG_TABLE_NAME}
––– output –––
191
––– input –––
mysql -h0 -P1306 -e "CREATE TABLE c:${LONG_TABLE_NAME}(body text) shards='2' rf='2' timeout='60';"; echo $?
––– output –––
0
––– comment –––
With two nodes and RF=2, each node must materialize both generated shards.
––– input –––
for port in 1306 2306; do for i in $(seq 1 100); do n=$(mysql --no-defaults -h0 -P$port -sN -e "SHOW TABLES FROM system" 2>/dev/null | grep -c "system.${LONG_TABLE_NAME}_s"); [ "$n" = "2" ] && break; sleep 0.1; done; echo "$port:$n"; done
––– output –––
1306:2
2306:2
––– input –––
for port in 1306 2306; do mysql --no-defaults -h0 -P$port -sN -e "SHOW TABLES" | grep -c "${LONG_TABLE_NAME}"; done
––– output –––
1
1
––– input –––
mysql -h0 -P1306 -e "INSERT INTO ${LONG_TABLE_NAME}(id,body) VALUES(1,'boundary');"; echo $?
––– output –––
0
––– comment –––
Read the replicated sharded table through the second node.
––– input –––
for i in $(seq 1 100); do n=$(mysql --no-defaults -h0 -P2306 -sN -e "SELECT COUNT(*) FROM ${LONG_TABLE_NAME}" 2>/dev/null); [ "$n" = "1" ] && break; sleep 0.1; done; echo "$n"
––– output –––
1
––– comment –––
Restart node 2 and verify its persisted cluster and long generated shard names.
––– input –––
export INSTANCE=2
––– output –––
––– block: ../../base/replication/stop-searchd –––
––– block: ../../base/replication/start-searchd-precach –––
––– input –––
for i in $(seq 1 100); do status=$(mysql --no-defaults -h0 -P2306 -sN -e "SHOW STATUS LIKE 'cluster_c_status'" 2>/dev/null | awk '{print $2}'); [ "$status" = "primary" ] && break; sleep 0.1; done; echo "$status"
––– output –––
primary
––– input –––
for i in $(seq 1 100); do n=$(mysql --no-defaults -h0 -P2306 -sN -e "SHOW TABLES FROM system" 2>/dev/null | grep -c "system.${LONG_TABLE_NAME}_s"); [ "$n" = "2" ] && break; sleep 0.1; done; echo "$n"
––– output –––
2
––– input –––
mysql --no-defaults -h0 -P2306 -sN -e "SELECT COUNT(*) FROM ${LONG_TABLE_NAME}"
––– output –––
1
––– comment –––
Drop through the replication cluster and verify public and physical cleanup on both nodes.
––– input –––
mysql -h0 -P1306 -e "DROP TABLE c:${LONG_TABLE_NAME};"; echo $?
––– output –––
0
––– input –––
for port in 1306 2306; do for i in $(seq 1 100); do n=$(mysql --no-defaults -h0 -P$port -sN -e "SHOW TABLES FROM system" 2>/dev/null | grep -c "system.${LONG_TABLE_NAME}_s"); [ "$n" = "0" ] && break; sleep 0.1; done; echo "$port:$n"; done
