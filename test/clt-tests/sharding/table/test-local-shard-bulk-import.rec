––– comment –––
Shared bulk_import into a shard table with local targets: /bulk?bulk_import=<shard>&shared routes
rows as an ordinary write into the shard table does and feeds one indexer child per target;
the empty-line commit publishes all the targets at once, one disk chunk each. The daemon gets
threads = 8 for any CPU count of the runner.
––– input –––
sed -i '/^searchd *{/a threads = 8' /etc/manticoresearch/manticore.conf
––– output –––
––– block: ../../base/start-searchd –––
––– input –––
cat > /tmp/sb.sh <<'EOF'
gen() { for ((i=$2; i<=$3; i++)); do printf '{"insert":{"table":"%s","id":%d,"doc":{"title":"doc %d","gid":%d}}}\n' "$1" "$i" "$i" "$((i % 7))"; done; }
post() { curl -sS -X POST "http://localhost:9308/bulk?bulk_import=$1&shared$2" -H 'Content-Type: application/x-ndjson' --data-binary @"$3" -w ' HTTP %{http_code}\n'; }
commit() { printf '\n' > /tmp/commit.ndjson; post "$1" "$2" /tmp/commit.ndjson; }
sql() { mysql -h0 -P9306 --skip-table --batch --raw --skip-column-names -e "$1"; }
mk() { sql "DROP TABLE IF EXISTS $1; DROP TABLE IF EXISTS ${1}_0; DROP TABLE IF EXISTS ${1}_1; DROP TABLE IF EXISTS ${1}_2; CREATE TABLE ${1}_0 (title TEXT, gid INT); CREATE TABLE ${1}_1 (title TEXT, gid INT); CREATE TABLE ${1}_2 (title TEXT, gid INT); CREATE TABLE $1 (title TEXT, gid INT) type='shard' local='${1}_0' local='${1}_1' local='${1}_2'"; }
counts() { echo "$(sql "SELECT COUNT(*) FROM $1") = $(sql "SELECT COUNT(*) FROM ${1}_0") + $(sql "SELECT COUNT(*) FROM ${1}_1") + $(sql "SELECT COUNT(*) FROM ${1}_2")"; }
chunks() { echo "disk_chunks $(for t in ${1}_0 ${1}_1 ${1}_2; do sql "SHOW TABLE $t STATUS LIKE 'disk_chunks'" | cut -f2; done | tr '\n' ' ')"; }
leftovers() { echo "staging=$(ls /var/lib/manticore/*/ | grep -c indexer-rt-bulk) children=$(ps -eo args | grep -c '[i]ndexer_rt_bulk_chunk')"; }
free() { for t in "$@"; do sql "INSERT INTO $t (id, title, gid) VALUES (999999, 'free', 0); DELETE FROM $t WHERE id=999999" && echo "$t free"; done; }
vals() { for ((i=$1; i<=$2; i++)); do printf "(%d,'doc %d',%d)" "$i" "$i" "$((i % 7))"; [ "$i" -lt "$2" ] && printf ','; done; }
EOF
