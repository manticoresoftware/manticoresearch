––– comment –––
indexer --keep-attrs with a rowwise float_vector: all attributes kept, only the string kept (--keep-attrs-names=s, the
vector comes from the source), only the vector kept (--keep-attrs-names=v); the names forms crashed indexer.
––– input –––
root=/tmp/indexer-plain-knn/keep; rm -rf "$root"; mkdir -p "$root"; printf '1,red,"0.1,0.2"\n2,blue,"0.3,0.4"\n' > "$root/old.csv"; printf '1,green,"0.5,0.6"\n2,navy,"0.7,0.8"\n' > "$root/new.csv"; printf '%s\n' 'source s_old {' '  type = csvpipe' "  csvpipe_command = cat $root/old.csv" '  csvpipe_attr_string = s' '  csvpipe_attr_float_vector = v' '}' 'source s_new : s_old {' "  csvpipe_command = cat $root/new.csv" '}' 'index a {' '  type = plain' '  source = s_old' "  path = $root/a" '  knn = {"attrs":[{"name":"v","type":"hnsw","dims":2,"hnsw_similarity":"L2"}]}' '}' 'index b1 : a {' '  source = s_new' "  path = $root/b1" '}' 'index b2 : b1 {' "  path = $root/b2" '}' 'index b3 : b1 {' "  path = $root/b3" '}' 'searchd {' '  listen = 19320:mysql41' "  log = $root/searchd.log" "  pid_file = $root/searchd.pid" '  binlog_path =' '}' > "$root/keep.conf"; indexer --config "$root/keep.conf" a > "$root/a.log" 2>&1; echo "a exit=$?"; k="--keep-attrs=$root/a"; indexer --config "$root/keep.conf" b1 $k > "$root/b1.log" 2>&1; echo "b1 exit=$?"; indexer --config "$root/keep.conf" b2 $k --keep-attrs-names=s > "$root/b2.log" 2>&1; echo "b2 exit=$?"; indexer --config "$root/keep.conf" b3 $k --keep-attrs-names=v > "$root/b3.log" 2>&1; echo "b3 exit=$?"; MANTICORE_NO_BUDDY=1 searchd --config "$root/keep.conf" > /dev/null 2>&1; for i in $(seq 1 100); do mysql -h0 -P19320 -e 'SELECT 1' > /dev/null 2>&1 && break; sleep 0.1; done; for t in b1 b2 b3; do mysql --skip-table --batch --raw --skip-column-names -h0 -P19320 -e "SELECT id, s, v FROM $t ORDER BY id ASC" | sed "s/^/$t /"; done; mysql --skip-table --batch --raw --skip-column-names -h0 -P19320 -e "SELECT id FROM b3 WHERE knn(v, 1, (0.3,0.4)) LIMIT 1"; searchd --config "$root/keep.conf" --stopwait > /dev/null 2>&1
