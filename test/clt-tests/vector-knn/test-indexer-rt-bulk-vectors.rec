DROP TABLE IF EXISTS rt_bulk_vectors;
CREATE TABLE rt_bulk_vectors (title TEXT, embedding FLOAT_VECTOR KNN_TYPE='hnsw' KNN_DIMS='4' HNSW_SIMILARITY='l2', raw_vector FLOAT_VECTOR);
SET indexer_rt_bulk=rt_bulk_vectors;
