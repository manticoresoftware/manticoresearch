––– input –––
chunks=$(mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SHOW TABLE rt_bulk_vectors STATUS LIKE 'disk_chunks'" | awk '{print $2}'); if [ "$chunks" = 1 ]; then echo ASSISTED_VECTOR_CHUNK_OK; else echo "FAIL_ASSISTED_VECTOR_CHUNKS=$chunks"; fi
