1	1.000000,0.000000,0.000000,0.000000	1.000000,2.000000
2	0.000000,1.000000,0.000000,0.000000	3.000000,4.000000
3	0.000000,0.000000,1.000000,0.000000	5.000000,6.000000
––– input –––
mysql --skip-table --batch --raw --skip-column-names -h0 -P9306 -e "SELECT id FROM rt_bulk_vectors WHERE knn(embedding,1,(0,1,0,0)) LIMIT 1"
