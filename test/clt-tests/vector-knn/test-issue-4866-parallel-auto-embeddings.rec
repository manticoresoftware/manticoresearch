Test that parallel KNN index construction preserves all vectors generated by automatic embeddings

––– block: ../base/start-searchd-with-buddy –––
––– comment –––
Create an auto-embeddings table and load varied text documents
––– input –––
mysql -h0 -P9306 -e "SET GLOBAL knn_parallel_build=4"; echo $?
––– output –––
0
––– input –––
mysql -h0 -P9306 -e "CREATE TABLE t (txt text, vec float_vector knn_type='hnsw' hnsw_similarity='cosine' model_name='Xenova/all-MiniLM-L6-v2' from='txt')"; echo $?
––– output –––
0
––– input –––
manticore-load --batch-size=100 --threads=1 --total=15000 --load="INSERT INTO t(id, txt) VALUES(<increment>, '<text/5/20>')" --quiet > /dev/null; echo $?
––– output –––
0
––– comment –––
Build the disk-chunk KNN index in parallel
––– input –––
mysql -h0 -P9306 -e "FLUSH RAMCHUNK t" > /dev/null; echo $?
––– output –––
0
––– comment –––
Verify that the ordinary and KNN queries return every loaded document
––– input –––
set -o pipefail; ordinary=$(mysql -h0 -P9306 -NE -e "SELECT id FROM t LIMIT 15100 OPTION max_matches=15100" | grep -E '^[0-9]+$' | wc -l) && knn=$(mysql -h0 -P9306 -NE -e "SELECT id FROM t WHERE knn(vec,'anything') LIMIT 15100 OPTION max_matches=15100" | grep -E '^[0-9]+$' | wc -l) && [ "$ordinary" -eq 15000 ] && [ "$knn" -eq "$ordinary" ] && echo "All loaded documents have vectors" || { echo "ordinary=${ordinary:-query failed} knn=${knn:-query failed}"; false; }
––– output –––
All loaded documents have vectors
